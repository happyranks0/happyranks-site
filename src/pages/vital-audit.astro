---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';

const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'Is the VITAL audit really free?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. No credit card. No trial. No catch. We make money when you hire us to act on what the audit finds.' } },
    { '@type': 'Question', name: 'How long does the audit take?', acceptedAnswer: { '@type': 'Answer', text: 'The audit itself takes 90 seconds. The PDF report is generated and emailed within 2 minutes.' } },
    { '@type': 'Question', name: 'Will I get spammed after?', acceptedAnswer: { '@type': 'Answer', text: 'No. We may send 2-3 follow-up emails with relevant insights, and you can unsubscribe anytime.' } },
    { '@type': 'Question', name: 'How accurate is the VITAL score?', acceptedAnswer: { '@type': 'Answer', text: 'Based on 50+ measurable signals, not opinions. A defensible number. Re-run quarterly to track progress.' } },
    { '@type': 'Question', name: 'Can I use the audit for my clients?', acceptedAnswer: { '@type': 'Answer', text: 'Yes, white-label it. We do not restrict use of the audit report. Just do not resell the report itself.' } },
  ],
};

const serviceSchema = {
  '@type': 'Service',
  serviceType: 'Free Marketing Audit',
  provider: { '@type': 'Organization', name: 'Happyranks' },
  areaServed: ['US', 'GB', 'AE', 'IN'],
  description: 'Free 90-second VITAL audit scoring websites across 5 dimensions and 50+ checks. Delivers a 10-page PDF report with prioritized fixes and a 90-day action plan.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<Layout
  title="Free VITAL Audit — Score your website in 90 seconds"
  description="Get a free VITAL audit across Visibility, Impression, Transition, Automation, and Learning. 50+ checks, real numbers, real recommendations, no call required."
  active="/vital-audit"
  schema={[faqSchema, serviceSchema]}
>
  <!-- HERO + FORM -->
  <section class="section-y">
    <div class="container-wide">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <Hero
            eyebrow="FREE VITAL AUDIT — 90 SECONDS"
            title="Score your website"
            highlight="in 90 seconds"
            description="The VITAL audit measures your site across 5 dimensions that actually drive revenue. Real score, real report, real recommendations — emailed to you within 2 minutes. No call required."
            meta={['No credit card', 'No sales call', '50+ checks', 'PDF in inbox']}
          />
        </div>

        <!-- FORM CARD -->
        <div class="card p-8 lg:p-10 card-glow sticky top-24">
          <div class="eyebrow mb-2">Step 1 of 1</div>
          <h2 class="text-2xl font-bold text-white mb-2">Run your audit</h2>
          <p class="text-sm text-[#888] mb-8">Enter your URL and email. We'll send the report within 2 minutes.</p>

          <form id="vital-form" class="space-y-5">
            <div>
              <label for="url" class="block text-sm font-semibold text-white mb-2">Website URL</label>
              <input
                type="url"
                id="url"
                name="url"
                required
                placeholder="https://yoursite.com"
                class="w-full bg-[#0a0a0a] border border-[#2a2a2a] rounded-lg px-4 py-3 text-white placeholder:text-[#555] focus:border-[var(--color-brand)] focus:outline-none transition"
              />
              <div class="text-xs text-[#666] mt-2">We'll crawl your homepage and key sub-pages</div>
            </div>
            <div>
              <label for="email" class="block text-sm font-semibold text-white mb-2">Email for the report</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="you@company.com"
                class="w-full bg-[#0a0a0a] border border-[#2a2a2a] rounded-lg px-4 py-3 text-white placeholder:text-[#555] focus:border-[var(--color-brand)] focus:outline-none transition"
              />
              <div class="text-xs text-[#666] mt-2">We may send 2-3 follow-up emails with insights. Unsubscribe anytime.</div>
            </div>
            <button type="submit" class="btn btn-primary btn-large w-full justify-center">
              <i class="ph-bold ph-lightning"></i>
              Run my free VITAL audit
            </button>
            <div class="text-[10px] text-[#666] text-center leading-relaxed">
              By submitting, you agree to receive your audit report via email.
              We may send follow-up insights. No spam, unsubscribe anytime.
            </div>
          </form>

          <div id="vital-result" class="hidden mt-6 p-6 bg-[#0a0a0a] border border-emerald-500/30 rounded-lg">
            <div class="flex items-center gap-2 text-emerald-500 font-semibold mb-2">
              <i class="ph-bold ph-check-circle"></i>
              <span>Audit queued</span>
            </div>
            <p class="text-sm text-[#a0a0a0]">Your report is on its way. Check your inbox in the next 2 minutes.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section-y bg-[#0c0c0c]">
    <div class="container-wide">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <div class="eyebrow mb-4">How the audit works</div>
        <h2 class="text-display-2 text-white mb-6">
          90 seconds from URL<br/>
          <span class="text-gradient-brand">to a real report</span>
        </h2>
        <p class="text-lg text-[#a0a0a0]">
          A custom Python engine crawls your site, runs 50+ measurable checks, scores them
          against our weighted rubric, and produces a 10-page PDF. No human bias. No
          opinion-based scores. Just measurable signals.
        </p>
      </div>

      <div class="grid md:grid-cols-4 gap-4">
        {[
          { n: '1', title: 'Submit URL', desc: 'You enter your homepage URL and email. That\'s it.' },
          { n: '2', title: 'Engine crawls', desc: 'We fetch your HTML, parse meta tags, check headers, detect scripts, look at schema, run DNS lookups.' },
          { n: '3', title: '50+ checks run', desc: 'Each of the 5 VITAL dimensions runs ~10 specific checks. Speed, SEO, conversion, automation, analytics.' },
          { n: '4', title: 'PDF emailed', desc: 'Scores, findings, prioritized fixes, 90-day action plan. In your inbox within 2 minutes.' },
        ].map((s) => (
          <div class="card p-6">
            <div class="w-10 h-10 rounded-full bg-[var(--color-brand)] text-white flex items-center justify-center font-bold mb-4">{s.n}</div>
            <div class="font-bold text-white mb-2">{s.title}</div>
            <p class="text-sm text-[#888] leading-relaxed">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WHAT YOU GET -->
  <section class="section-y">
    <div class="container-wide">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <div class="eyebrow mb-4">What's inside the report</div>
        <h2 class="text-display-2 text-white mb-6">
          A real audit, not<br/>
          <span class="text-gradient-brand">a vanity score</span>
        </h2>
        <p class="text-lg text-[#a0a0a0]">
          10 pages of measurement + recommendation. Built for a CEO who wants the truth, not
          a marketer who wants to sell you something.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        {[
          { p: '01', title: 'Cover & Executive Summary', desc: 'Your overall VITAL score, the top 3 revenue-impacting fixes, and the estimated annual revenue lift if you act on them.' },
          { p: '02', title: 'Visibility Deep-Dive', desc: 'SEO health, AI-overview citation potential, knowledge graph presence, search intent coverage, backlink profile.' },
          { p: '03', title: 'Impression Deep-Dive', desc: 'Core Web Vitals, mobile experience, hero clarity, design quality assessment, social proof placement.' },
          { p: '04', title: 'Transition Deep-Dive', desc: 'CTA placement, form friction, booking flow analysis, conversion path audit, lead magnet quality.' },
          { p: '05', title: 'Automation Deep-Dive', desc: 'CRM presence, email capture, retargeting setup, lead scoring readiness, sales handoff automation.' },
          { p: '06', title: 'Learning Deep-Dive', desc: 'Analytics setup, conversion attribution, tracking gaps, measurement maturity, dashboard quality.' },
          { p: '07', title: 'SWOT Analysis', desc: 'Strengths, weaknesses, opportunities, threats — across all 5 dimensions. Strategic context, not just numbers.' },
          { p: '08', title: '90-Day Action Plan', desc: 'Prioritized fixes with effort and impact estimates. Ready to execute in-house or hand to a team like ours.' },
        ].map((r) => (
          <div class="card p-6 flex gap-5">
            <div class="text-4xl font-black text-[#222] mono shrink-0">{r.p}</div>
            <div>
              <div class="font-bold text-white mb-2">{r.title}</div>
              <p class="text-sm text-[#888] leading-relaxed">{r.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SAMPLE SCORE -->
  <section class="section-y bg-[#0c0c0c]">
    <div class="container-wide">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-12">
          <div class="eyebrow mb-4">Sample report preview</div>
          <h2 class="text-display-3 text-white mb-4">
            Here's what a VITAL score looks like
          </h2>
          <p class="text-[#888]">Sample site: acme-corp.com (fictional example)</p>
        </div>

        <div class="card p-10">
          <div class="flex items-center justify-between mb-10 flex-wrap gap-6">
            <div>
              <div class="eyebrow mb-2">VITAL SCORE</div>
              <div class="text-7xl font-black text-white">62<span class="text-3xl text-[#666]">/100</span></div>
            </div>
            <div class="text-right">
              <div class="eyebrow mb-2">ESTIMATED REVENUE LIFT</div>
              <div class="text-4xl font-black text-[var(--color-brand)]">+2.4x</div>
              <div class="text-xs text-[#888] mt-1">if prioritized fixes ship in 90 days</div>
            </div>
          </div>
          <div class="space-y-4">
            {[
              { l: 'V', name: 'Visibility', s: 78, color: 'bg-blue-500' },
              { l: 'I', name: 'Impression', s: 71, color: 'bg-purple-500' },
              { l: 'T', name: 'Transition', s: 42, color: 'bg-orange-500' },
              { l: 'A', name: 'Automation', s: 38, color: 'bg-emerald-500' },
              { l: 'L', name: 'Learning', s: 81, color: 'bg-yellow-500' },
            ].map((d) => (
              <div class="grid grid-cols-[40px_120px_1fr_60px] items-center gap-4">
                <div class="text-2xl font-black text-white">{d.l}</div>
                <div class="text-sm font-semibold text-white">{d.name}</div>
                <div class="h-2 bg-[#1a1a1a] rounded-full overflow-hidden">
                  <div class={`h-full ${d.color} rounded-full`} style={`width: ${d.s}%`}></div>
                </div>
                <div class="text-right text-sm mono text-white">{d.s}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY FREE -->
  <section class="section-y">
    <div class="container-wide max-w-3xl">
      <div class="text-center mb-12">
        <div class="eyebrow mb-4">Why is this free?</div>
        <h2 class="text-display-2 text-white mb-6">
          Because the audit<br/>
          <span class="text-gradient-brand">shouldn't be the gate</span>
        </h2>
      </div>
      <div class="space-y-4 text-lg text-[#a0a0a0] leading-relaxed">
        <p>
          Most agencies charge $2K–$5K for an audit that takes 2 weeks and is full of
          consultant-speak. We think that's backwards. The audit should be free. The work
          to fix what it finds — that's what has value.
        </p>
        <p>
          The VITAL audit engine is fully automated. It costs us effectively nothing to run.
          Giving you the report is the cheapest way for us to demonstrate that we know what
          we're doing. If you see value in the audit, you'll see value in the work that
          improves the score.
        </p>
        <p>
          If you don't engage us, you still walk away with a real, actionable report.
          No expiry. No "demo only" watermarks. No sales trap. We mean it.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section-y bg-[#0c0c0c]">
    <div class="container-wide max-w-3xl">
      <div class="text-center mb-12">
        <div class="eyebrow mb-4">FAQ</div>
        <h2 class="text-display-2 text-white">
          Common <span class="text-gradient-brand">questions</span>
        </h2>
      </div>
      <div class="space-y-3">
        {[
          { q: 'Is this really free?', a: 'Yes. No credit card. No "free trial that converts to paid." No catch. We make money when you hire us to act on what the audit finds — not from the audit itself.' },
          { q: 'How long does it take?', a: 'The audit itself takes 90 seconds. The PDF report is generated immediately and emailed to you within 2 minutes.' },
          { q: 'Will I get spammed after?', a: 'No. We may send 2-3 follow-up emails with relevant insights, and you can unsubscribe at any time. We don\'t share your data with anyone.' },
          { q: 'What if my site is on a subdomain or in development?', a: 'The audit works on any publicly accessible URL — subdomains, landing pages, even staging environments that have basic access. If your site requires login, run it on a publicly visible page (like a pricing or feature page).' },
          { q: 'How accurate is the score?', a: 'The score is based on 50+ measurable signals — not opinions. It\'s a real, defensible number. That said, it\'s a snapshot of one moment in time. We recommend re-running it quarterly to track progress.' },
          { q: 'Can I use this for my clients?', a: 'Yes, white-label it. We don\'t restrict the use of the audit report. If you\'re an agency or consultant and want to run it for clients, please do. We just ask that you don\'t resell the report itself.' },
          { q: 'What happens after I get the report?', a: 'Your choice. Read it, share it with your team, act on it yourself, or book a call with us to discuss. There\'s no auto-enrollment and no follow-up pressure beyond 2-3 emails.' },
        ].map((f) => (
          <details class="card p-6 group">
            <summary class="flex items-center justify-between cursor-pointer list-none">
              <span class="font-semibold text-white pr-4">{f.q}</span>
              <i class="ph-bold ph-plus text-[var(--color-brand)] text-xl group-open:rotate-45 transition-transform shrink-0"></i>
            </summary>
            <p class="mt-4 text-[#a0a0a0] leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-y relative overflow-hidden">
    <div class="orb-red top-0 left-1/2 -translate-x-1/2"></div>
    <div class="container-wide relative text-center">
      <h2 class="text-display-2 text-white mb-6">
        Ready to see your<br/>
        <span class="text-gradient-brand">real numbers?</span>
      </h2>
      <p class="text-lg text-[#a0a0a0] mb-10 max-w-xl mx-auto">
        90 seconds. One URL. A real report. Free, no call required.
      </p>
      <a href="#vital-form" class="btn btn-primary btn-large">
        <i class="ph-bold ph-lightning"></i>
        Run my free VITAL audit
      </a>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('vital-form') as HTMLFormElement | null;
  const result = document.getElementById('vital-result');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    const url = formData.get('url') as string;
    const email = formData.get('email') as string;
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const original = btn.innerHTML;
    btn.innerHTML = '<i class="ph-bold ph-circle-notch animate-spin"></i> Running audit...';
    btn.disabled = true;
    try {
      // VITAL API on VPS — proxied via Netlify Function in production
      const apiBase = (window as any).VITAL_API_URL || 'https://vital.gohappyranks.com';
      const resp = await fetch(`${apiBase}/api/vital/scan`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url, email }),
      });
      if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
      form.classList.add('hidden');
      result?.classList.remove('hidden');
    } catch (err) {
      btn.innerHTML = original;
      btn.disabled = false;
      alert('Audit failed. Please try again or email hello@happyranks.com');
      console.error(err);
    }
  });
</script>
