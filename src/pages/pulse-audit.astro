---
import Layout from '../layouts/Layout.astro';
import PulseScore from '../components/PulseScore.astro';
import PulseAuditForm from '../components/PulseAuditForm.astro';

const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'Is the PULSE audit really free?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. No credit card. No trial. No catch.' } },
    { '@type': 'Question', name: 'How long does the audit take?', acceptedAnswer: { '@type': 'Answer', text: '90 seconds to run. PDF emailed within 2 minutes.' } },
    { '@type': 'Question', name: 'How accurate is the PULSE score?', acceptedAnswer: { '@type': 'Answer', text: 'Based on 50+ measurable signals, not opinions.' } },
  ],
};

const serviceSchema = {
  '@type': 'Service',
  serviceType: 'Free Marketing Audit',
  provider: { '@type': 'Organization', name: 'Happyranks' },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const reportSections = [
  { p: '01', title: 'Executive summary', desc: 'Overall score, top fixes, estimated revenue lift.' },
  { p: '02', title: 'Dimension deep-dives', desc: 'Presence, Understanding, Lead capture, Follow-up, Evaluation.' },
  { p: '03', title: 'SWOT + 90-day plan', desc: 'Prioritized fixes with effort and impact estimates.' },
];
---

<Layout
  title="Free PULSE Audit — Score your website in 90 seconds"
  description="Free PULSE audit across five revenue dimensions. 50+ checks, PDF in 2 minutes, no call required."
  active="/pulse-audit"
  schema={[faqSchema, serviceSchema]}
>
  <section class="masthead">
    <div class="wrap masthead-grid">
      <div>
        <p class="kicker mb-5">Free · 90 seconds</p>
        <h1 class="display-hero mb-6">
          Score your site<br />
          <em class="serif not-italic text-accent">in 90 seconds.</em>
        </h1>
        <p class="lead max-w-md mb-8">
          Five dimensions. Fifty-plus checks. A real PDF with prioritized fixes — emailed in 2 minutes.
        </p>
      </div>
      <PulseScore />
    </div>
  </section>

  <section class="band-ink section-tight" id="pulse-form-panel">
    <div class="wrap max-w-lg mx-auto">
      <div class="panel panel-pad-lg band-ink-form">
        <PulseAuditForm formId="pulse-form" />
      </div>
    </div>
  </section>

  <section class="section-tight section-band">
    <div class="wrap">
      <p class="kicker mb-8">What you get</p>
      <div class="grid md:grid-cols-3 gap-8">
        {reportSections.map((r) => (
          <div>
            <p class="mono text-sm text-accent mb-2">{r.p}</p>
            <h3 class="text-lg font-semibold text-ink mb-2">{r.title}</h3>
            <p class="body-sm">{r.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap max-w-3xl">
      <h2 class="display-lg text-center mb-10">Questions</h2>
      <div class="border-t border-line">
        {faqSchema.mainEntity.map((f) => (
          <details class="group border-b border-line py-5">
            <summary class="flex justify-between cursor-pointer list-none font-medium text-ink">
              {f.name}
              <i class="ph-bold ph-plus text-accent group-open:rotate-45 transition-transform"></i>
            </summary>
            <p class="mt-4 body-sm">{f.acceptedAnswer.text}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .band-ink-form {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.12);
  }
  .band-ink-form .btn-primary {
    background: var(--color-ink-band-fg);
    color: var(--color-ink);
  }
  .band-ink-form .btn-primary:hover {
    background: var(--color-accent-soft);
    color: #fff;
  }
  .band-ink-form .text-ink-3 { color: var(--color-ink-band-muted); }
</style>
