---
import Layout from '../layouts/Layout.astro';
import PulseScore from '../components/PulseScore.astro';
import PulseAuditForm from '../components/PulseAuditForm.astro';
import FaqsBlock from '@/components/blocks/faqs-1.astro';
import PageHeader from '../components/PageHeader.astro';
import { Badge } from '@/components/ui/badge';
import { Section, SectionContainer } from '@/components/ui/section';

const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'Is the PULSE audit really free?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. No credit card. No trial.' } },
    { '@type': 'Question', name: 'How long does the audit take?', acceptedAnswer: { '@type': 'Answer', text: '90 seconds to run. PDF emailed within 2 minutes.' } },
    { '@type': 'Question', name: 'How accurate is the PULSE score?', acceptedAnswer: { '@type': 'Answer', text: 'Based on 50+ measurable signals, not opinions.' } },
  ],
};

const serviceSchema = {
  '@type': 'Service',
  serviceType: 'Free Marketing Audit',
  provider: { '@type': 'Organization', name: 'Happyranks' },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const faqItems = faqSchema.mainEntity.map((item) => ({
  id: item.name.toLowerCase().replace(/[^a-z0-9]+/g, '-'),
  question: item.name,
  answer: item.acceptedAnswer.text,
}));
---

<Layout
  title="Free PULSE Audit — Score your website in 90 seconds"
  description="Free PULSE audit across five revenue dimensions. 50+ checks, PDF in 2 minutes, no call required."
  active="/pulse-audit"
  schema={[faqSchema, serviceSchema]}
>
  <PageHeader
    kicker="Free · 90 seconds · No call required"
    title="Score your site"
    highlight="in 90 seconds."
    description="Five dimensions. Fifty-plus checks. A 10-page PDF with prioritized fixes — delivered to your inbox in 2 minutes."
    compact={true}
  />

  <Section class="border-b border-white/5 pb-20">
    <SectionContainer class="site-shell !max-w-7xl">
      <div class="grid items-start gap-12 lg:grid-cols-2 lg:gap-16">
        <div class="glass-panel glow-ring p-6 lg:p-8 lg:sticky lg:top-28" id="pulse-form-panel">
          <PulseAuditForm formId="pulse-form" />
        </div>
        <div class="hidden lg:block">
          <PulseScore />
        </div>
      </div>
    </SectionContainer>
  </Section>

  <Section class="border-b border-white/5 bg-base-200/30 py-20">
    <SectionContainer class="site-shell !max-w-7xl">
      <Badge variant="outline" class="mb-8 border-primary/30 text-primary">Under the hood</Badge>
      <div class="grid gap-6 md:grid-cols-3">
        {[
          { n: '01', t: 'Submit URL', d: 'Homepage URL and email. That is all we need.' },
          { n: '02', t: 'Engine crawls', d: 'HTML, meta, schema, scripts — 50+ measurable signals.' },
          { n: '03', t: 'Score & report', d: 'Weighted rubric across 5 dimensions. PDF with 90-day plan.' },
        ].map((s) => (
          <div class="glass-panel p-6">
            <p class="font-mono text-sm text-primary">{s.n}</p>
            <h3 class="mt-3 font-display text-xl font-bold">{s.t}</h3>
            <p class="mt-2 text-sm text-base-content/60">{s.d}</p>
          </div>
        ))}
      </div>
    </SectionContainer>
  </Section>

  <FaqsBlock
    title="Questions"
    description="Quick answers about the free PULSE audit."
    faqs={faqItems}
    class="py-20"
  />
</Layout>
