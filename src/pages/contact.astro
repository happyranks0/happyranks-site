---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';

const planLabels: Record<string, string> = {
  starter: 'Starter',
  growth: 'Growth',
  scale: 'Scale',
};

const channels = [
  {
    icon: 'ph-envelope-simple',
    title: 'Email',
    detail: 'hello@happyranks.com',
    href: 'mailto:hello@happyranks.com',
    sub: 'General questions, partnerships, press',
  },
  {
    icon: 'ph-phone',
    title: 'Phone / WhatsApp',
    detail: '+91 82488 16834',
    href: 'tel:+918248816834',
    sub: 'India & international — venue and hospitality clients',
  },
  {
    icon: 'ph-linkedin-logo',
    title: 'LinkedIn',
    detail: 'Sanjeev',
    href: 'https://www.linkedin.com/in/sanjeev/',
    sub: 'Professional intros and updates',
  },
];
---

<Layout
  title="Contact — Book a strategy call"
  description="Book a 45-minute strategy call. We'll walk through your PULSE audit results, talk about your goals, and see if we're a good fit. Response within 4 working hours."
  active="/contact"
  noStickyCta={true}
>
  <section class="section-y">
    <div class="container-wide">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-start">
        <div>
          <Hero
            compact
            eyebrow="CONTACT"
            title="Book a"
            highlight="strategy call"
            description="45 minutes. We walk through your PULSE audit, talk about your goals, and see if we're a good fit. No pitch deck, no pressure."
            primaryCta={{ label: 'Skip the call — get the audit', href: '/pulse-audit', icon: 'ph-lightning' }}
          />

          <div class="mt-10 grid sm:grid-cols-2 gap-4 text-sm">
            <div class="card p-4">
              <div class="text-[10px] mono text-fg-muted uppercase tracking-widest mb-1">Response time</div>
              <div class="text-fg font-semibold">4 working hours</div>
            </div>
            <div class="card p-4">
              <div class="text-[10px] mono text-fg-muted uppercase tracking-widest mb-1">Format</div>
              <div class="text-fg font-semibold">Google Meet</div>
            </div>
            <div class="card p-4">
              <div class="text-[10px] mono text-fg-muted uppercase tracking-widest mb-1">Cost</div>
              <div class="text-fg font-semibold">Always free</div>
            </div>
            <div class="card p-4">
              <div class="text-[10px] mono text-fg-muted uppercase tracking-widest mb-1">Pressure</div>
              <div class="text-fg font-semibold">Zero</div>
            </div>
          </div>
        </div>

        <div class="card p-8 lg:p-10 lg:sticky lg:top-24">
          <div id="plan-banner" class="hidden mb-6 p-4 rounded-xl border border-accent/30 bg-accent/10 text-sm text-ink-2"></div>

          <div class="eyebrow mb-2">Book a call</div>
          <h2 class="text-2xl font-bold text-fg mb-2">Tell us about your business</h2>
          <p class="text-sm text-fg-muted mb-8">We read every submission. Reply within 4 working hours.</p>

          <form
            id="contact-form"
            name="contact"
            method="POST"
            data-netlify="true"
            netlify-honeypot="bot-field"
            class="space-y-5"
          >
            <input type="hidden" name="form-name" value="contact" />
            <input type="hidden" name="plan" id="plan-field" value="" />
            <p class="hidden">
              <label>Don’t fill this out: <input name="bot-field" /></label>
            </p>

            <div class="grid grid-cols-2 gap-4">
              <div>
                <label for="name" class="block text-sm font-semibold text-fg mb-2">Name *</label>
                <input type="text" id="name" name="name" required placeholder="Jane Doe" class="w-full input-field" />
              </div>
              <div>
                <label for="company" class="block text-sm font-semibold text-fg mb-2">Company</label>
                <input type="text" id="company" name="company" placeholder="Acme Inc" class="w-full input-field" />
              </div>
            </div>
            <div>
              <label for="email" class="block text-sm font-semibold text-fg mb-2">Email *</label>
              <input type="email" id="email" name="email" required placeholder="you@company.com" class="w-full input-field" />
            </div>
            <div>
              <label for="website" class="block text-sm font-semibold text-fg mb-2">Website <span class="text-fg-muted font-normal">(if any)</span></label>
              <input type="url" id="website" name="website" placeholder="https://yoursite.com" class="w-full input-field" />
            </div>
            <div>
              <label for="budget" class="block text-sm font-semibold text-fg mb-2">Monthly budget</label>
              <select id="budget" name="budget" class="w-full bg-canvas border border-border rounded-lg px-4 py-3 text-fg focus:border-[var(--color-brand)] focus:outline-none transition">
                <option value="">Select range</option>
                <option value="1.5-3k">$1,500 – $3,000</option>
                <option value="3-6k">$3,000 – $6,000</option>
                <option value="6-10k">$6,000 – $10,000</option>
                <option value="10k+">$10,000+</option>
                <option value="unsure">Not sure yet</option>
              </select>
            </div>
            <div>
              <label for="message" class="block text-sm font-semibold text-fg mb-2">What are you trying to solve? *</label>
              <textarea id="message" name="message" rows="4" required placeholder="A few sentences about your business and what you want to improve." class="w-full input-field resize-none"></textarea>
            </div>
            <button type="submit" class="btn btn-primary btn-large w-full justify-center">
              <i class="ph-bold ph-calendar-check"></i>
              Request a call
            </button>
            <div class="text-[10px] text-fg-muted text-center">
              We respect your inbox. No spam, no marketing list trades.
            </div>
          </form>

          <div id="contact-success" class="hidden mt-6 p-6 bg-ok-bg border border-ok/30 rounded-lg text-center">
            <i class="ph-bold ph-check-circle text-ok text-3xl mb-2"></i>
            <div class="font-semibold text-fg mb-1">Request received</div>
            <p class="text-sm text-fg-secondary">We'll be in touch within 4 working hours. Usually faster.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-y bg-bg-subtle">
    <div class="container-wide max-w-3xl">
      <div class="text-center mb-12">
        <div class="eyebrow mb-4">FAQ</div>
        <h2 class="text-display-2 text-fg">
          Common <span class="text-gradient-brand">questions</span>
        </h2>
      </div>
      <div class="space-y-3">
        {[
          { q: 'What happens after I submit this form?', a: 'A real person reads your submission. We reply within 4 working hours with a Calendly link, a clarifying question, or an honest referral if we are not the right fit.' },
          { q: 'Do you charge for the strategy call?', a: 'No. The first call is always free — 45 minutes of senior time.' },
          { q: 'What if I just have a quick question?', a: 'Email hello@happyranks.com directly. The form is for booking a call.' },
        ].map((f) => (
          <details class="card p-6 group">
            <summary class="flex items-center justify-between cursor-pointer list-none">
              <span class="font-semibold text-fg pr-4">{f.q}</span>
              <i class="ph-bold ph-plus text-[var(--color-brand)] text-xl group-open:rotate-45 transition-transform shrink-0"></i>
            </summary>
            <p class="mt-4 text-fg-secondary leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section-y">
    <div class="container-wide max-w-3xl">
      <div class="text-center mb-12">
        <div class="eyebrow mb-4">Other ways to reach us</div>
        <h2 class="text-display-2 text-fg">
          Pick your <span class="text-gradient-brand">channel</span>
        </h2>
      </div>
      <div class="grid md:grid-cols-3 gap-4">
        {channels.map((c) => (
          <a href={c.href} class="card p-6 text-center panel-hover block no-underline" target={c.href.startsWith('http') ? '_blank' : undefined} rel={c.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
            <div class="w-12 h-12 rounded-lg bg-bg-muted border border-border flex items-center justify-center text-[var(--color-brand)] mx-auto mb-3">
              <i class={`ph-bold ${c.icon} text-2xl`}></i>
            </div>
            <div class="font-bold text-fg mb-1">{c.title}</div>
            <div class="text-sm text-[var(--color-brand)] mono mb-2">{c.detail}</div>
            <div class="text-xs text-fg-muted">{c.sub}</div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<script define:vars={{ planLabels }}>
  const params = new URLSearchParams(window.location.search);
  const plan = params.get('plan');
  const planField = document.getElementById('plan-field');
  const planBanner = document.getElementById('plan-banner');

  if (plan && planField) {
    planField.value = plan;
    const label = planLabels[plan] || plan;
    if (planBanner) {
      planBanner.textContent = `You're interested in the ${label} plan — we'll tailor the call around that tier.`;
      planBanner.classList.remove('hidden');
    }
  }

  const form = document.getElementById('contact-form');
  const success = document.getElementById('contact-success');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    const btn = form.querySelector('button[type="submit"]');
    const original = btn?.innerHTML;
    if (btn) {
      btn.innerHTML = '<i class="ph-bold ph-circle-notch"></i> Sending...';
      btn.disabled = true;
    }

    try {
      const body = new URLSearchParams();
      body.append('form-name', 'contact');
      formData.forEach((v, k) => body.append(k, v.toString()));

      const response = await fetch('/__forms.html', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: body.toString(),
      });

      if (!response.ok) throw new Error(`HTTP ${response.status}`);

      form.classList.add('hidden');
      success?.classList.remove('hidden');
    } catch (err) {
      if (btn) {
        btn.innerHTML = original;
        btn.disabled = false;
      }
      alert('Failed to send. Please email hello@happyranks.com directly.');
      console.error(err);
    }
  });
</script>
