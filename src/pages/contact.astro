---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import MauticForm from '../components/MauticForm.astro';
import FAQ from '../components/cf/FAQ.astro';
import Card from '../components/cf/Card.astro';

const channels = [
  {
    icon: 'ph-envelope-simple',
    title: 'Email',
    detail: 'hello@happyranks.com',
    href: 'mailto:hello@happyranks.com',
    sub: 'General questions, partnerships, press',
  },
  {
    icon: 'ph-phone',
    title: 'Phone / WhatsApp',
    detail: '+91 82488 16834',
    href: 'tel:+918248816834',
    sub: 'India & international — venue and hospitality clients',
  },
  {
    icon: 'ph-linkedin-logo',
    title: 'LinkedIn',
    detail: 'Sanjeev',
    href: 'https://www.linkedin.com/in/sanjeev/',
    sub: 'Professional intros and updates',
  },
];

const contactFaqs = [
  { q: 'What happens after I submit this form?', a: 'A real person reads your submission. We reply within 4 working hours with a Calendly link, a clarifying question, or an honest referral if we are not the right fit.' },
  { q: 'Do you charge for the strategy call?', a: 'No. The first call is always free — 45 minutes of senior time.' },
  { q: 'What if I just have a quick question?', a: 'Email hello@happyranks.com directly. The form is for booking a call.' },
];
---

<Layout
  title="Contact — Book a strategy call"
  description="Book a 45-minute strategy call. We'll walk through your PULSE breakdown, talk about your goals, and see if we're a good fit. Response within 4 working hours."
  active="/contact"
  noStickyCta={true}
>
  <PageHeader
    kicker="Contact"
    title="Book a"
    highlight="strategy call"
    description="45 minutes. We walk through your PULSE breakdown, talk about your goals, and see if we're a good fit. No pitch deck, no pressure."
    primaryCta={{ label: 'Skip the call — request breakdown', href: '/pulse-audit', icon: 'ph-lightning' }}
    compact={true}
  />

  <section class="section-tight">
    <div class="wrap">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-start">
        <div>
          <div class="grid sm:grid-cols-2 gap-4 mb-10">
            {[
              { label: 'Response time', value: '4 working hours' },
              { label: 'Format', value: 'Google Meet' },
              { label: 'Cost', value: 'Always free' },
              { label: 'Pressure', value: 'Zero' },
            ].map((item) => (
              <Card pad="default">
                <div class="text-[10px] mono text-ink-3 uppercase tracking-widest mb-1">{item.label}</div>
                <div class="text-ink font-semibold">{item.value}</div>
              </Card>
            ))}
          </div>
        </div>

        <Card pad="lg" hover={false} class="lg:sticky lg:top-24">
          <MauticForm formId="contact-form" />
        </Card>
      </div>
    </div>
  </section>

  <section class="section section-band">
    <div class="wrap max-w-3xl">
      <p class="kicker text-center mb-3">FAQ</p>
      <h2 class="display-lg text-center mb-10">Common questions</h2>
      <FAQ items={contactFaqs} />
    </div>
  </section>

  <section class="section">
    <div class="wrap max-w-3xl">
      <div class="text-center mb-12">
        <p class="kicker mb-4">Other ways to reach us</p>
        <h2 class="display-lg">Pick your channel</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-4">
        {channels.map((c) => (
          <a href={c.href} class="card p-6 text-center panel-hover block no-underline" target={c.href.startsWith('http') ? '_blank' : undefined} rel={c.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
            <div class="w-12 h-12 rounded-lg bg-canvas-3 border border-line flex items-center justify-center text-accent mx-auto mb-3">
              <i class={`ph-bold ${c.icon} text-2xl`}></i>
            </div>
            <div class="font-bold text-ink mb-1">{c.title}</div>
            <div class="text-sm text-accent mono mb-2">{c.detail}</div>
            <div class="text-xs text-ink-3">{c.sub}</div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
