---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { Label } from '@/components/ui/label';
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';
import { Section, SectionContainer } from '@/components/ui/section';
import FaqsBlock from '@/components/blocks/faqs-1.astro';

const planLabels: Record<string, string> = {
  starter: 'Starter',
  growth: 'Growth',
  scale: 'Scale',
};

const channels = [
  {
    icon: 'ph-envelope-simple',
    title: 'Email',
    detail: 'hello@happyranks.com',
    href: 'mailto:hello@happyranks.com',
    sub: 'General questions, partnerships, press',
  },
  {
    icon: 'ph-phone',
    title: 'Phone / WhatsApp',
    detail: '+91 82488 16834',
    href: 'tel:+918248816834',
    sub: 'India & international — venue and hospitality clients',
  },
  {
    icon: 'ph-linkedin-logo',
    title: 'LinkedIn',
    detail: 'Sanjeev',
    href: 'https://www.linkedin.com/in/sanjeev/',
    sub: 'Professional intros and updates',
  },
];

const contactFaqs = [
  { id: 'after-submit', question: 'What happens after I submit this form?', answer: 'A real person reads your submission. We reply within 4 working hours with a Calendly link, a clarifying question, or an honest referral if we are not the right fit.' },
  { id: 'free-call', question: 'Do you charge for the strategy call?', answer: 'No. The first call is always free — 45 minutes of senior time.' },
  { id: 'quick-question', question: 'What if I just have a quick question?', answer: 'Email hello@happyranks.com directly. The form is for booking a call.' },
];
---

<Layout
  title="Contact — Book a strategy call"
  description="Book a 45-minute strategy call. We'll walk through your PULSE audit results, talk about your goals, and see if we're a good fit. Response within 4 working hours."
  active="/contact"
  noStickyCta={true}
>
  <PageHeader
    kicker="Contact"
    title="Book a"
    highlight="strategy call"
    description="45 minutes. We walk through your PULSE audit, talk about your goals, and see if we're a good fit. No pitch deck, no pressure."
    primaryCta={{ label: 'Skip the call — get the audit', href: '/pulse-audit', icon: 'ph-lightning' }}
    compact={true}
  />

  <Section class="pb-20">
    <SectionContainer class="site-shell !max-w-7xl">
      <div class="grid items-start gap-12 lg:grid-cols-2 lg:gap-16">
        <div class="grid grid-cols-2 gap-4">
          {[
            { label: 'Response time', value: '4 working hours' },
            { label: 'Format', value: 'Google Meet' },
            { label: 'Cost', value: 'Always free' },
            { label: 'Pressure', value: 'Zero' },
          ].map((item) => (
            <div class="stat-glass text-left">
              <div class="text-[10px] font-mono uppercase tracking-widest text-base-content/40">{item.label}</div>
              <div class="mt-1 font-semibold">{item.value}</div>
            </div>
          ))}
        </div>

        <Card class="glass-panel glow-ring border-white/10 bg-base-200/80 lg:sticky lg:top-28">
          <CardHeader>
            <div id="plan-banner" class="alert alert-info mb-4 hidden text-sm"></div>
            <CardTitle class="font-display text-2xl">Tell us about your business</CardTitle>
            <p class="text-sm text-base-content/60">We read every submission. Reply within 4 working hours.</p>
          </CardHeader>
          <CardContent>
            <form
              id="contact-form"
              name="contact"
              method="POST"
              data-netlify="true"
              netlify-honeypot="bot-field"
              class="space-y-5"
            >
              <input type="hidden" name="form-name" value="contact" />
              <input type="hidden" name="plan" id="plan-field" value="" />
              <p class="hidden">
                <label>Don't fill this out: <input name="bot-field" /></label>
              </p>

              <div class="grid grid-cols-2 gap-4">
                <div class="form-control">
                  <Label for="name">Name *</Label>
                  <Input id="name" name="name" required placeholder="Jane Doe" class="mt-2 bg-base-300/50 border-white/10" />
                </div>
                <div class="form-control">
                  <Label for="company">Company</Label>
                  <Input id="company" name="company" placeholder="Acme Inc" class="mt-2 bg-base-300/50 border-white/10" />
                </div>
              </div>
              <div class="form-control">
                <Label for="email">Email *</Label>
                <Input type="email" id="email" name="email" required placeholder="you@company.com" class="mt-2 bg-base-300/50 border-white/10" />
              </div>
              <div class="form-control">
                <Label for="website">Website <span class="text-base-content/40 font-normal">(if any)</span></Label>
                <Input type="url" id="website" name="website" placeholder="https://yoursite.com" class="mt-2 bg-base-300/50 border-white/10" />
              </div>
              <div class="form-control">
                <Label for="budget">Monthly budget</Label>
                <select id="budget" name="budget" class="select select-bordered mt-2 w-full bg-base-300/50 border-white/10">
                  <option value="">Select range</option>
                  <option value="1.5-3k">$1,500 – $3,000</option>
                  <option value="3-6k">$3,000 – $6,000</option>
                  <option value="6-10k">$6,000 – $10,000</option>
                  <option value="10k+">$10,000+</option>
                  <option value="unsure">Not sure yet</option>
                </select>
              </div>
              <div class="form-control">
                <Label for="message">What are you trying to solve? *</Label>
                <textarea id="message" name="message" rows="4" required placeholder="A few sentences about your business and what you want to improve." class="textarea textarea-bordered mt-2 w-full bg-base-300/50 border-white/10"></textarea>
              </div>
              <Button type="submit" class="w-full h-12">
                <i class="ph-bold ph-calendar-check"></i>
                Request a call
              </Button>
              <p class="text-center text-[10px] text-base-content/40">
                We respect your inbox. No spam, no marketing list trades.
              </p>
            </form>

            <div id="contact-success" class="alert alert-success mt-6 hidden">
              <i class="ph-bold ph-check-circle text-2xl"></i>
              <div>
                <p class="font-semibold">Request received</p>
                <p class="text-sm opacity-80">We'll be in touch within 4 working hours. Usually faster.</p>
              </div>
            </div>
          </CardContent>
        </Card>
      </div>
    </SectionContainer>
  </Section>

  <FaqsBlock
    title="Common questions"
    description="What to expect after you reach out."
    faqs={contactFaqs}
    class="border-t border-white/5 bg-base-200/30 py-20"
  />

  <Section class="py-20">
    <SectionContainer class="site-shell !max-w-7xl">
      <div class="mb-12 text-center">
        <p class="kicker mb-4">Other ways to reach us</p>
        <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">
          Pick your <span class="text-gradient-brand">channel</span>
        </h2>
      </div>
      <div class="grid gap-4 md:grid-cols-3">
        {channels.map((c) => (
          <a
            href={c.href}
            class="glass-panel panel-hover block p-6 text-center no-underline"
            target={c.href.startsWith('http') ? '_blank' : undefined}
            rel={c.href.startsWith('http') ? 'noopener noreferrer' : undefined}
          >
            <div class="mx-auto mb-3 flex size-12 items-center justify-center rounded-xl bg-primary/10 text-primary">
              <i class={`ph-bold ${c.icon} text-2xl`}></i>
            </div>
            <div class="font-bold">{c.title}</div>
            <div class="my-2 font-mono text-sm text-primary">{c.detail}</div>
            <div class="text-xs text-base-content/50">{c.sub}</div>
          </a>
        ))}
      </div>
    </SectionContainer>
  </Section>
</Layout>

<script define:vars={{ planLabels }}>
  const params = new URLSearchParams(window.location.search);
  const plan = params.get('plan');
  const planField = document.getElementById('plan-field');
  const planBanner = document.getElementById('plan-banner');

  if (plan && planField) {
    planField.value = plan;
    const label = planLabels[plan] || plan;
    if (planBanner) {
      planBanner.textContent = `You're interested in the ${label} plan — we'll tailor the call around that tier.`;
      planBanner.classList.remove('hidden');
    }
  }

  const form = document.getElementById('contact-form');
  const success = document.getElementById('contact-success');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    const btn = form.querySelector('button[type="submit"]');
    const original = btn?.innerHTML;
    if (btn) {
      btn.innerHTML = '<i class="ph-bold ph-circle-notch"></i> Sending...';
      btn.disabled = true;
    }

    try {
      const body = new URLSearchParams();
      body.append('form-name', 'contact');
      formData.forEach((v, k) => body.append(k, v.toString()));

      const response = await fetch('/__forms.html', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: body.toString(),
      });

      if (!response.ok) throw new Error(`HTTP ${response.status}`);

      form.classList.add('hidden');
      success?.classList.remove('hidden');
    } catch (err) {
      if (btn) {
        btn.innerHTML = original;
        btn.disabled = false;
      }
      alert('Failed to send. Please email hello@happyranks.com directly.');
      console.error(err);
    }
  });
</script>
