---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';

const serviceSchema = {
  '@type': 'Service',
  serviceType: 'Marketing Audit and Optimization',
  provider: { '@type': 'Organization', name: 'Happyranks' },
  areaServed: ['US', 'GB', 'AE', 'IN'],
  description: 'PULSE framework marketing audit and optimization across 5 dimensions: Presence, Understanding, Lead capture, Sales follow-up, and Evaluation. Includes Generative Engine Optimization (GEO), conversion rate optimization, marketing automation setup, and analytics implementation.',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    description: 'Free strategist-reviewed PULSE breakdown with dimension scores and prioritised fix sequence',
  },
};

const dimensions = [
  {
    letter: 'P',
    name: 'Presence',
    headline: 'Can the right people find the business?',
    desc: 'In 2026, "find you" means Google, ChatGPT, Perplexity, Gemini, and Claude. We engineer your site to show up in all of them — for the queries that bring you customers, not just traffic.',
    icon: 'ph-binoculars',
    color: 'from-accent/20 to-accent/5',
    checks: [
      { name: 'Technical SEO audit', detail: 'Crawlability, indexation, site architecture, Core Web Vitals, mobile-first indexing compliance, hreflang, canonicalization.' },
      { name: 'Generative Engine Optimization (GEO)', detail: 'LLM-friendly content structure, entity definitions, citation-worthy formatting, source attribution, freshness signals.' },
      { name: 'Knowledge graph presence', detail: 'Wikidata, Google Knowledge Panel, schema markup (Organization, Person, Product, Service, FAQ, HowTo), entity authority building.' },
      { name: 'Search intent mapping', detail: 'Right keywords mapped to right pages with right format. Informational vs. transactional vs. commercial intent — matched to your funnel stage.' },
      { name: 'AI-overview citation tracking', detail: 'Weekly monitoring of how often your brand is cited in ChatGPT, Perplexity, Gemini, and Google AI Overviews. Tracked as a KPI, not a vanity metric.' },
      { name: 'Backlink profile analysis', detail: 'Domain authority, referring domains, anchor text distribution, toxic link identification, competitor gap analysis.' },
    ],
    tools: ['Ahrefs', 'Semrush', 'Screaming Frog', 'Google Search Console', 'Schema.org validator', 'Perplexity API'],
  },
  {
    letter: 'U',
    name: 'Understanding',
    headline: 'Do they quickly understand what you do and why it matters?',
    desc: 'Speed, design, copy clarity, social proof. The first impression determines whether the visitor stays, scrolls, and converts — or bounces to your competitor. We make sure they stay.',
    icon: 'ph-eye',
    color: 'from-accent/20 to-accent/5',
    checks: [
      { name: 'Core Web Vitals optimization', detail: 'LCP under 2.5s, INP under 200ms, CLS under 0.1. Measured on real-user data (field metrics), not just lab tests. Mobile and desktop separately.' },
      { name: 'Hero clarity & value proposition', detail: 'Above-the-fold message in plain English. Visitor knows what you do, who it\'s for, and why it matters — in under 5 seconds.' },
      { name: 'Visual hierarchy & typography', detail: 'Reading flow, scanability, weight balance, whitespace rhythm, color contrast. WCAG AA minimum, AAA where possible.' },
      { name: 'Mobile responsiveness', detail: 'Pixel-perfect across all breakpoints. Touch targets ≥ 44px, no horizontal scroll, no zoom required, fast 3G test pass.' },
      { name: 'Social proof placement', detail: 'Testimonials, logos, case studies, ratings, certifications, press mentions — placed where buying decisions actually happen, not buried in a footer.' },
      { name: 'Brand consistency', detail: 'Colors, fonts, voice, photography style — consistent across every page. Recognizable in 3 seconds, memorable after one visit.' },
    ],
    tools: ['PageSpeed Insights', 'Chrome UX Report', 'WebPageTest', 'Hotjar heatmaps', 'Microsoft Clarity', 'Figma'],
  },
  {
    letter: 'L',
    name: 'Lead capture',
    headline: 'Can an interested visitor become an enquiry easily?',
    desc: 'The path from "interested" to "booked call." Friction here is the most expensive leak in most marketing funnels. We eliminate it with psychology-backed design, copy, and flow.',
    icon: 'ph-arrow-right',
    color: 'from-accent/20 to-accent/5',
    checks: [
      { name: 'CTA placement & copy', detail: 'Above-fold, contextually embedded throughout, action-oriented language. Multiple CTA types matched to visitor intent (book, download, chat, call).' },
      { name: 'Form design & friction reduction', detail: 'Fewer fields, multi-step where appropriate, inline validation, social proof at the form, mobile-optimized input types (tel, email, date).' },
      { name: 'Booking & calendar integration', detail: 'Calendly, Cal.com, HubSpot Meetings — direct booking without back-and-forth. Round-robin assignment, buffer times, timezone handling.' },
      { name: 'Lead magnet funnels', detail: 'PDFs, templates, tools, audits that capture emails. Value-first, ungated where possible, gated only when the content is genuinely worth it.' },
      { name: 'Conversion path audits', detail: 'Heatmaps, session recordings, funnel analysis. We find where visitors drop off and fix the specific page, step, or copy that\'s causing it.' },
      { name: 'A/B test programs', detail: 'Headlines, CTAs, layouts, offers. Statistical significance, not vibes. Every test produces a learning whether it wins or loses.' },
    ],
    tools: ['Calendly', 'Cal.com', 'HubSpot', 'Typeform', 'Hotjar', 'Google Optimize alternatives'],
  },
  {
    letter: 'S',
    name: 'Sales follow-up',
    headline: 'What happens after the enquiry arrives?',
    desc: 'A visitor who doesn\'t convert today is a lead for tomorrow — if your system is set up to nurture them. We wire up the full stack so no engagement falls through the cracks.',
    icon: 'ph-robot',
    color: 'from-accent/20 to-accent/5',
    checks: [
      { name: 'CRM setup & integration', detail: 'Mautic, HubSpot, Pipedrive, Salesforce — whichever you use (or should use). Contact properties, deal stages, lead scoring, automation workflows.' },
      { name: 'Email nurture sequences', detail: 'Welcome series, educational content, conversion nudges, re-engagement. Behavior-triggered, not just time-based. 20%+ open rates as the baseline.' },
      { name: 'Retargeting pixel deployment', detail: 'Meta, Google, LinkedIn, TikTok — all major platforms. Custom audiences built from site behavior, lookalikes for acquisition, exclusion lists to avoid waste.' },
      { name: 'Lead scoring & routing', detail: 'Hot leads to sales in real-time, warm leads to nurture, cold leads to long-term sequences. Round-robin or rule-based assignment.' },
      { name: 'WhatsApp & SMS automation', detail: 'For high-intent, time-sensitive offers. Click-to-WhatsApp ads, automated replies, broadcast sequences (compliance-checked per region).' },
      { name: 'Sales handoff automation', detail: 'When a lead hits threshold → instant notification to sales, meeting link, contact card, full behavioral history. Sales calls within 5 minutes, not 5 hours.' },
    ],
    tools: ['Mautic', 'HubSpot', 'ActiveCampaign', 'Make.com', 'n8n', 'WhatsApp Business API'],
  },
  {
    letter: 'E',
    name: 'Evaluation',
    headline: 'Does the business measure results and improve the system?',
    desc: 'You can\'t improve what you don\'t measure. We set up the full attribution stack so you know exactly where every dollar came from — and where the next dollar should go.',
    icon: 'ph-chart-line-up',
    color: 'from-accent/20 to-accent/5',
    checks: [
      { name: 'GA4 + server-side tracking', detail: 'Cookie-proof, GDPR-compliant, future-proof. Server-side GTM for accurate data even with Safari ITP and ad blockers. Custom event taxonomy.' },
      { name: 'Conversion attribution modeling', detail: 'First-touch, last-touch, linear, time-decay, position-based, data-driven. Pick the model that matches your sales cycle, not the default.' },
      { name: 'Tag manager architecture', detail: 'GTM container, naming conventions, version control, environment separation (dev/staging/prod). Cleanup of legacy tags and duplicate pixels.' },
      { name: 'Custom dashboards', detail: 'Looker Studio, WhatGraph, or your BI of choice. Real-time views of traffic, leads, conversion rate, pipeline, CAC, LTV. Email summaries on schedule.' },
      { name: 'Weekly performance reports', detail: 'What changed, what worked, what didn\'t, what to do next. Plain English, not data dumps. Sent every Monday morning before your team starts the week.' },
      { name: 'Experimentation framework', detail: 'Hypothesis → test → measure → learn → ship. Every change is measured. Winners get rolled out, losers get documented so we don\'t repeat them.' },
    ],
    tools: ['GA4', 'Google Tag Manager', 'Looker Studio', 'Mixpanel', 'Hotjar', 'Microsoft Clarity'],
  },
];
---

<Layout
  title="Capabilities — The PULSE framework in detail"
  description="Five dimensions of marketing done right: Presence, Understanding, Lead capture, Sales follow-up, and Evaluation. Each audited across ~10 specific checks. Built into every engagement."
  active="/capabilities"
  schema={serviceSchema}
>
  <!-- HERO -->
  <Hero
    eyebrow="OUR CAPABILITIES"
    title="The PULSE framework —"
    highlight="every dimension, in detail"
    description="We measure your site across 5 dimensions × 10+ checks each — 50 measurable signals that determine whether your marketing makes money. Here's the full rubric, the tools we use, and what good looks like in each dimension."
    primaryCta={{ label: 'See how your site scores', href: '/pulse-audit', icon: 'ph-lightning' }}
  />

  <!-- DIMENSIONS -->
  <section class="section">
    <div class="wrap space-y-24">
      {dimensions.map((d) => (
        <div class="grid md:grid-cols-[280px_1fr] lg:grid-cols-[320px_1fr] gap-10 lg:gap-14 items-start">
          <div class="md:sticky md:top-24">
            <div class="flex items-center gap-3 mb-5">
              <div class={`w-11 h-11 rounded-xl bg-gradient-to-br ${d.color} flex items-center justify-center shadow-lg`}>
                <i class={`ph-bold ${d.icon} text-xl text-ink`}></i>
              </div>
              <div class="text-3xl font-black text-ink-3 mono leading-none">{d.letter}</div>
            </div>
            <h2 class="display-md text-ink mb-3">{d.name}</h2>
            <p class="text-ink-2 text-[15px] leading-relaxed mb-4">{d.headline}</p>
            <p class="text-sm text-ink-3 leading-relaxed mb-6">{d.desc}</p>
            <div class="text-[10px] mono text-ink-3 uppercase tracking-widest mb-3">Tools we use</div>
            <div class="flex flex-wrap gap-1.5">
              {d.tools.map((t) => (
                <span class="px-2 py-1 text-[10.5px] mono bg-canvas-1-3 border border-line rounded text-ink-2">{t}</span>
              ))}
            </div>
          </div>
          <div>
            <div class="panel panel-pad">
              <p class="kicker mb-4">What we audit</p>
              <div class="space-y-4">
                {d.checks.map((c) => (
                  <div class="flex items-start gap-4 pb-4 border-b border-line last:border-0 last:pb-0">
                    <i class="ph-bold ph-check-circle text-accent text-xl mt-0.5 shrink-0"></i>
                    <div>
                      <div class="font-semibold text-ink mb-1">{c.name}</div>
                      <div class="body-sm-muted">{c.detail}</div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- AUDIT PROCESS -->
  <section class="section section-band">
    <div class="wrap">
      <div class="max-w-3xl mb-12">
        <div class="eyebrow mb-4">How the audit works</div>
        <h2 class="display-lg text-ink mb-6">
          From URL to report<br/>
          <span class="text-accent">in strategist-reviewed</span>
        </h2>
        <p class="text-lg text-ink-2 leading-relaxed">
          The free PULSE breakdown runs a custom-built Python engine against your site. It pulls
          ~50 measurable signals, scores them against a weighted rubric, and produces a
          10-page PDF report. Here's exactly what happens under the hood.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        {[
          { n: '1', title: 'Crawl & fetch', detail: 'We hit your homepage with proper user-agent, fetch HTML, parse meta tags, headers, schema, links, and asset structure. Sub-2s timeout with retries.' },
          { n: '2', title: 'Run 50+ checks', detail: 'Each of the 5 PULSE dimensions runs ~10 specific checks. Presence via SEO + schema. Understanding via hero clarity + speed. Lead capture via forms + CTAs. Sales follow-up via CRM + pixels. Evaluation via analytics tags.' },
          { n: '3', title: 'Score & weight', detail: 'Each check returns 0–100. Dimension score is weighted average. Final PULSE score is average of the 5 dimensions. A site with all 90s scores 90. A site with 3 perfects and 2 zeros scores ~54.' },
          { n: '4', title: 'Generate report', detail: 'PDF includes: cover page with overall score, executive summary, estimated revenue impact, dimension deep-dives, SWOT analysis, prioritized 90-day action plan. Emailed within 2 minutes.' },
        ].map((s) => (
          <div class="card p-6">
            <div class="flex items-center gap-4 mb-4">
              <div class="w-10 h-10 rounded-full bg-accent text-ink flex items-center justify-center font-bold">{s.n}</div>
              <h3 class="text-xl font-bold text-ink">{s.title}</h3>
            </div>
            <p class="text-ink-2 leading-relaxed text-sm">{s.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- INDUSTRY APPLICATIONS -->
  <section class="section">
    <div class="wrap">
      <div class="max-w-3xl mb-12">
        <div class="eyebrow mb-4">Where it applies</div>
        <h2 class="display-lg text-ink mb-6">
          Every industry. <span class="text-ink-2">Same rigor.</span>
        </h2>
        <p class="text-lg text-ink-2 leading-relaxed">
          The PULSE framework works the same way regardless of industry — what changes is
          which dimensions matter most for your specific business. A wedding venue obsesses
          over Understanding and Lead capture. A B2B SaaS company obsesses over Presence and
          Evaluation. We map it to your model.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
        {[
          { industry: 'Real estate', priority: 'P → L → U → S → E', focus: 'Presence (local SEO), Lead capture (lead forms, IDX), Sales follow-up (instant lead alerts).' },
          { industry: 'Wedding & events', priority: 'U → L → P → S → E', focus: 'Understanding (portfolio showcase), Lead capture (inquiry flow), Presence (local search).' },
          { industry: 'B2B SaaS', priority: 'P → E → S → L → U', focus: 'Presence (GEO + SEO), Evaluation (attribution), Sales follow-up (lead scoring, CRM).' },
          { industry: 'Service business', priority: 'L → S → P → U → E', focus: 'Lead capture (booking, calls), Sales follow-up (nurture sequences), Presence (local SEO).' },
        ].map((i) => (
          <div class="card p-6">
            <div class="font-bold text-ink mb-3">{i.industry}</div>
            <div class="text-xs mono text-accent mb-3">Priority: {i.priority}</div>
            <p class="text-sm text-ink-3 leading-relaxed">{i.focus}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section relative overflow-hidden">
    <div class="orb-red top-0 left-1/2 -translate-x-1/2"></div>
    <div class="wrap relative">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="display-lg text-ink mb-6">
          See how your site <span class="text-accent">scores today</span>
        </h2>
        <p class="text-lg text-ink-2 mb-10">
          A free PULSE breakdown gives you a real number across all 5 dimensions. No fluff. No call required.
        </p>
        <a href="/pulse-audit" class="btn btn-primary btn-large">
          Get my free PULSE breakdown
          <i class="ph-bold ph-arrow-right"></i>
        </a>
      </div>
    </div>
  </section>
</Layout>
