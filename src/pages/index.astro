---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <slot name="head">
    <title>Happyranks — Marketing Systems for the AI Era</title>
    <meta name="description" content="Get found by AI. Convert humans. Grow with systems." />
  </slot>

  <!-- ═══ NAV ═══ -->
  <nav class="fixed top-0 left-0 right-0 z-50 backdrop-blur-xl border-b" style="background-color: rgba(10,10,10,0.75); border-color: #161616;">
    <div class="container-wide flex items-center justify-between h-16">
      <a href="/" class="flex items-center gap-2.5">
        <div class="w-7 h-7 rounded-md flex items-center justify-center font-bold text-[13px]" style="background-color: var(--color-brand);">H</div>
        <span class="font-semibold text-[15px]">happyranks</span>
      </a>
      <div class="hidden md:flex items-center gap-8 text-sm text-[#888]">
        <a href="/services" class="hover:text-white transition-colors">Services</a>
        <a href="/case-studies" class="hover:text-white transition-colors">Work</a>
        <a href="/pricing" class="hover:text-white transition-colors">Pricing</a>
        <a href="/about" class="hover:text-white transition-colors">About</a>
      </div>
      <a href="/vital" class="btn btn-primary text-sm">
        Get VITAL Score
      </a>
    </div>
  </nav>

  <!-- ═══ HERO ═══ -->
  <section class="relative pt-36 md:pt-44 pb-24 md:pb-32 overflow-hidden">
    <div class="absolute inset-0 bg-grid bg-grid-mask opacity-60"></div>
    <div class="orb-red" style="top: -300px; left: 50%; transform: translateX(-50%); opacity: 0.5;"></div>

    <div class="container-wide relative">
      <div class="max-w-4xl mx-auto text-center">
        <!-- Status pill -->
        <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full text-[13px] mb-10 border" style="background-color: rgba(255,49,49,0.06); border-color: rgba(255,49,49,0.25); color: #ff7a7a;">
          <span class="w-1.5 h-1.5 rounded-full pulse-dot" style="background-color: var(--color-brand);"></span>
          Built for the AI era
        </div>

        <!-- Headline -->
        <h1 class="text-display-1 mb-8">
          <span class="text-gradient-light">Marketing that</span><br />
          <span class="text-gradient-light">AI can find.</span><br />
          <span class="text-gradient-brand">Humans can trust.</span>
        </h1>

        <!-- Subhead -->
        <p class="text-lg md:text-xl text-[#999] max-w-2xl mx-auto leading-relaxed mb-12">
          We build marketing systems for mid-market businesses — 
          engineered to be cited by AI, optimized for human conversion, 
          and automated to scale.
        </p>

        <!-- Single primary CTA -->
        <div class="flex flex-col items-center gap-3">
          <a href="/vital" class="btn btn-primary text-[15px] px-7 py-3.5">
            Run a free VITAL audit
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </a>
          <p class="text-xs text-[#666]">50-point scan · 5 dimensions · PDF in your inbox</p>
        </div>
      </div>

      <!-- Live VITAL preview — full width, integrated, not a side card -->
      <div class="mt-24 md:mt-32 max-w-4xl mx-auto">
        <div class="card card-glow p-6 md:p-8">
          <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6 pb-6 border-b" style="border-color: #1f1f1f;">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-md flex items-center justify-center font-bold text-sm" style="background-color: rgba(255,49,49,0.15); color: var(--color-brand);">V</div>
              <div>
                <div class="text-sm font-medium text-white">happyranks.com</div>
                <div class="text-xs text-[#666] mono">v2.0 · Live audit · Just now</div>
              </div>
            </div>
            <div class="flex items-baseline gap-2">
              <span class="text-5xl font-bold text-gradient-brand">54</span>
              <span class="text-xl text-[#555]">/100</span>
            </div>
          </div>

          <div class="grid md:grid-cols-5 gap-x-6 gap-y-4">
            <div>
              <div class="flex justify-between text-[13px] mb-2">
                <span class="text-[#aaa]">Visibility</span>
                <span class="mono text-[#888]">80</span>
              </div>
              <div class="h-1 rounded-full overflow-hidden" style="background-color: #1a1a1a;">
                <div class="h-full rounded-full" style="width: 80%; background-color: #22c55e;"></div>
              </div>
            </div>
            <div>
              <div class="flex justify-between text-[13px] mb-2">
                <span class="text-[#aaa]">Impression</span>
                <span class="mono text-[#888]">46</span>
              </div>
              <div class="h-1 rounded-full overflow-hidden" style="background-color: #1a1a1a;">
                <div class="h-full rounded-full" style="width: 46%; background-color: #eab308;"></div>
              </div>
            </div>
            <div>
              <div class="flex justify-between text-[13px] mb-2">
                <span class="text-[#aaa]">Transition</span>
                <span class="mono text-[#ff7a7a]">33</span>
              </div>
              <div class="h-1 rounded-full overflow-hidden" style="background-color: #1a1a1a;">
                <div class="h-full rounded-full" style="width: 33%; background-color: var(--color-brand);"></div>
              </div>
            </div>
            <div>
              <div class="flex justify-between text-[13px] mb-2">
                <span class="text-[#aaa]">Automation</span>
                <span class="mono text-[#888]">42</span>
              </div>
              <div class="h-1 rounded-full overflow-hidden" style="background-color: #1a1a1a;">
                <div class="h-full rounded-full" style="width: 42%; background-color: #eab308;"></div>
              </div>
            </div>
            <div>
              <div class="flex justify-between text-[13px] mb-2">
                <span class="text-[#aaa]">Learning</span>
                <span class="mono text-[#888]">68</span>
              </div>
              <div class="h-1 rounded-full overflow-hidden" style="background-color: #1a1a1a;">
                <div class="h-full rounded-full" style="width: 68%; background-color: #22c55e;"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ TRUST BAR ═══ -->
  <section class="py-16 border-y" style="border-color: #141414;">
    <div class="container-wide">
      <p class="text-center text-xs text-[#555] mb-10 uppercase tracking-[0.15em]">Trusted by growing businesses</p>
      <div class="flex flex-wrap items-center justify-center gap-x-16 gap-y-4">
        <span class="text-[15px] font-medium text-[#444] hover:text-[#777] transition-colors">Tutti Rouge</span>
        <span class="text-[15px] font-medium text-[#444] hover:text-[#777] transition-colors">Lotus Mahal</span>
        <span class="text-[15px] font-medium text-[#444] hover:text-[#777] transition-colors">Think Accounting</span>
        <span class="text-[15px] font-medium text-[#444] hover:text-[#777] transition-colors">Viruksha Gardens</span>
        <span class="text-[15px] font-medium text-[#444] hover:text-[#777] transition-colors">Efficy</span>
      </div>
    </div>
  </section>

  <!-- ═══ WHAT WE DO — Three horizontal rows, generous space ═══ -->
  <section class="section-y">
    <div class="container-wide">
      <div class="max-w-2xl mb-24">
        <p class="eyebrow mb-5">What we do</p>
        <h2 class="text-display-2 mb-6">One system. <span class="text-gradient-brand">Seven capabilities.</span></h2>
        <p class="text-lg text-[#888] leading-relaxed">
          Three core pillars. Built into every engagement. 
          Backed by tooling, automation, and AI that you can actually own.
        </p>
      </div>

      <!-- Row 1 -->
      <div class="grid md:grid-cols-12 gap-8 md:gap-12 mb-24 items-start">
        <div class="md:col-span-1">
          <div class="mono text-sm text-[#555]">01</div>
        </div>
        <div class="md:col-span-5">
          <h3 class="text-display-3 mb-4 text-white">Be found by AI</h3>
          <p class="text-[#999] leading-relaxed mb-6">
            51% of B2B buyers now start vendor research in ChatGPT. 
            If AI doesn't recommend you, you don't exist. 
            We make sure it does.
          </p>
          <a href="/services/ai-visibility" class="text-sm font-medium inline-flex items-center gap-1.5" style="color: var(--color-brand);">
            See AI Visibility
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </a>
        </div>
        <div class="md:col-span-6">
          <div class="card p-6 space-y-2.5">
            <div class="flex items-center gap-3 py-1.5 border-b" style="border-color: #1a1a1a;">
              <div class="w-7 h-7 rounded-md flex items-center justify-center text-[10px] font-bold" style="background-color: #10a37f; color: white;">AI</div>
              <div class="flex-1 text-[13px] text-[#aaa]">"Best AI marketing agency for SMBs"</div>
              <div class="text-[11px] text-[#555] mono">cited</div>
            </div>
            <div class="flex items-center gap-3 py-1.5 border-b" style="border-color: #1a1a1a;">
              <div class="w-7 h-7 rounded-md flex items-center justify-center text-[10px] font-bold" style="background-color: #20808d; color: white;">PX</div>
              <div class="flex-1 text-[13px] text-[#aaa]">"GEO agencies for real estate"</div>
              <div class="text-[11px] text-[#555] mono">cited</div>
            </div>
            <div class="flex items-center gap-3 py-1.5">
              <div class="w-7 h-7 rounded-md flex items-center justify-center text-[10px] font-bold" style="background-color: #4285f4; color: white;">GO</div>
              <div class="flex-1 text-[13px] text-[#aaa]">AI Overview placement, top 3 answers</div>
              <div class="text-[11px] text-[#555] mono">tracked</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Row 2 -->
      <div class="grid md:grid-cols-12 gap-8 md:gap-12 mb-24 items-start">
        <div class="md:col-span-1">
          <div class="mono text-sm text-[#555]">02</div>
        </div>
        <div class="md:col-span-5">
          <h3 class="text-display-3 mb-4 text-white">Convert humans</h3>
          <p class="text-[#999] leading-relaxed mb-6">
            AI gets people in the door. Your website, content, and offer close them. 
            We rebuild the conversion path so more visitors become real leads.
          </p>
          <a href="/services/web-cro" class="text-sm font-medium inline-flex items-center gap-1.5" style="color: var(--color-brand);">
            See Web + CRO
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </a>
        </div>
        <div class="md:col-span-6">
          <div class="card p-6">
            <div class="text-xs text-[#666] uppercase tracking-wider mb-4">Funnel leak report</div>
            <div class="space-y-3">
              <div>
                <div class="flex justify-between text-[13px] mb-1.5">
                  <span class="text-[#aaa]">Site visitors</span>
                  <span class="mono text-[#888]">10,000</span>
                </div>
                <div class="h-1.5 rounded-full" style="background-color: #1a1a1a;">
                  <div class="h-full rounded-full" style="width: 100%; background-color: var(--color-brand);"></div>
                </div>
              </div>
              <div>
                <div class="flex justify-between text-[13px] mb-1.5">
                  <span class="text-[#aaa]">CTA clicks</span>
                  <span class="mono text-[#888]">1,200</span>
                </div>
                <div class="h-1.5 rounded-full" style="background-color: #1a1a1a;">
                  <div class="h-full rounded-full" style="width: 12%; background-color: #eab308;"></div>
                </div>
              </div>
              <div>
                <div class="flex justify-between text-[13px] mb-1.5">
                  <span class="text-[#aaa]">Form submissions</span>
                  <span class="mono text-[#888]">180</span>
                </div>
                <div class="h-1.5 rounded-full" style="background-color: #1a1a1a;">
                  <div class="h-full rounded-full" style="width: 1.8%; background-color: #ef4444;"></div>
                </div>
              </div>
              <div>
                <div class="flex justify-between text-[13px] mb-1.5">
                  <span class="text-[#aaa]">Sales qualified</span>
                  <span class="mono text-[#888]">42</span>
                </div>
                <div class="h-1.5 rounded-full" style="background-color: #1a1a1a;">
                  <div class="h-full rounded-full" style="width: 0.4%; background-color: #22c55e;"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Row 3 -->
      <div class="grid md:grid-cols-12 gap-8 md:gap-12 items-start">
        <div class="md:col-span-1">
          <div class="mono text-sm text-[#555]">03</div>
        </div>
        <div class="md:col-span-5">
          <h3 class="text-display-3 mb-4 text-white">Run on systems</h3>
          <p class="text-[#999] leading-relaxed mb-6">
            Mautic. CRM. Lead scoring. Attribution. Email. SMS. WhatsApp. 
            We build the automation layer that runs your growth while you sleep.
          </p>
          <a href="/services/marketing-systems" class="text-sm font-medium inline-flex items-center gap-1.5" style="color: var(--color-brand);">
            See Marketing Systems
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </a>
        </div>
        <div class="md:col-span-6">
          <div class="card p-6">
            <div class="text-xs text-[#666] uppercase tracking-wider mb-4">Stack</div>
            <div class="grid grid-cols-2 gap-2.5">
              <div class="text-[13px] text-[#999] py-2 border-b" style="border-color: #1a1a1a;">Mautic</div>
              <div class="text-[13px] text-[#999] py-2 border-b" style="border-color: #1a1a1a;">WhatsApp API</div>
              <div class="text-[13px] text-[#999] py-2 border-b" style="border-color: #1a1a1a;">HubSpot</div>
              <div class="text-[13px] text-[#999] py-2 border-b" style="border-color: #1a1a1a;">Meta Ads</div>
              <div class="text-[13px] text-[#999] py-2 border-b" style="border-color: #1a1a1a;">Google Ads</div>
              <div class="text-[13px] text-[#999] py-2 border-b" style="border-color: #1a1a1a;">GA4 + GTM</div>
              <div class="text-[13px] text-[#999] py-2">Schema + llms.txt</div>
              <div class="text-[13px] text-[#999] py-2">Custom dashboards</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ HOW IT WORKS — Vertical timeline ═══ -->
  <section class="section-y" style="background-color: var(--color-bg-lighter);">
    <div class="container-wide">
      <div class="max-w-2xl mb-20">
        <p class="eyebrow mb-5">How it works</p>
        <h2 class="text-display-2 mb-6">Three steps. <span class="text-gradient-brand">No fluff.</span></h2>
      </div>

      <div class="max-w-3xl space-y-12">
        <div class="grid md:grid-cols-12 gap-6 items-start">
          <div class="md:col-span-2">
            <div class="text-4xl font-bold text-gradient-brand mono">01</div>
          </div>
          <div class="md:col-span-10">
            <h3 class="text-2xl font-semibold mb-3 text-white">Free VITAL audit</h3>
            <p class="text-[#999] leading-relaxed mb-3">
              Submit your URL. We run a 50-point scan across 5 dimensions 
              (Visibility, Impression, Transition, Automation, Learning) and email you a full PDF report.
            </p>
            <div class="text-xs text-[#555] mono">~ 4 minutes · No credit card</div>
          </div>
        </div>

        <div class="grid md:grid-cols-12 gap-6 items-start">
          <div class="md:col-span-2">
            <div class="text-4xl font-bold text-gradient-brand mono">02</div>
          </div>
          <div class="md:col-span-10">
            <h3 class="text-2xl font-semibold mb-3 text-white">Tailored proposal</h3>
            <p class="text-[#999] leading-relaxed mb-3">
              We review your audit, identify the biggest leak, and propose a scope that fixes it. 
              Transparent pricing, clear deliverables, no surprises.
            </p>
            <div class="text-xs text-[#555] mono">~ 2 days · Free, no obligation</div>
          </div>
        </div>

        <div class="grid md:grid-cols-12 gap-6 items-start">
          <div class="md:col-span-2">
            <div class="text-4xl font-bold text-gradient-brand mono">03</div>
          </div>
          <div class="md:col-span-10">
            <h3 class="text-2xl font-semibold mb-3 text-white">Build + measure</h3>
            <p class="text-[#999] leading-relaxed mb-3">
              We build the system, run the campaigns, and report what moved. 
              You see the VITAL score climb. 90 days in, we re-audit and find the next gap.
            </p>
            <div class="text-xs text-[#555] mono">30–90 days · Weekly reporting</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ CASE STUDY — One, big, cinematic ═══ -->
  <section class="section-y">
    <div class="container-wide">
      <div class="max-w-2xl mb-20">
        <p class="eyebrow mb-5">Recent work</p>
        <h2 class="text-display-2 mb-6">Real results. <span class="text-gradient-brand">Real businesses.</span></h2>
      </div>

      <a href="/case-studies/tutti-rouge" class="block group">
        <div class="card card-glow p-8 md:p-12 transition-all">
          <div class="grid md:grid-cols-12 gap-8 items-center">
            <div class="md:col-span-7">
              <div class="eyebrow mb-4">Tutti Rouge · Fashion · UK</div>
              <h3 class="text-display-3 mb-4 text-white group-hover:text-[#ff7a7a] transition-colors">
                Rebuilding the content system for AI era discovery
              </h3>
              <p class="text-[#aaa] leading-relaxed mb-8">
                UK-based fashion brand came to us with declining organic traffic and zero AI visibility. 
                We rebuilt their content system around entity optimization and structured data. 
                ChatGPT now recommends them for "occasion dresses UK."
              </p>
              <span class="inline-flex items-center gap-2 text-sm font-medium" style="color: var(--color-brand);">
                Read the case study
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="group-hover:translate-x-1 transition-transform"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
              </span>
            </div>
            <div class="md:col-span-5">
              <div class="grid grid-cols-2 gap-3">
                <div class="text-center p-5 border rounded-lg" style="border-color: #1f1f1f; background-color: rgba(255,49,49,0.03);">
                  <div class="text-3xl font-bold text-gradient-brand mb-1">+250%</div>
                  <div class="text-[11px] text-[#888]">Organic clicks</div>
                </div>
                <div class="text-center p-5 border rounded-lg" style="border-color: #1f1f1f; background-color: rgba(255,49,49,0.03);">
                  <div class="text-3xl font-bold text-gradient-brand mb-1">+91%</div>
                  <div class="text-[11px] text-[#888]">Paid CTR</div>
                </div>
                <div class="text-center p-5 border rounded-lg" style="border-color: #1f1f1f; background-color: rgba(255,49,49,0.03);">
                  <div class="text-3xl font-bold text-gradient-brand mb-1">3x</div>
                  <div class="text-[11px] text-[#888]">AI citations</div>
                </div>
                <div class="text-center p-5 border rounded-lg" style="border-color: #1f1f1f; background-color: rgba(255,49,49,0.03);">
                  <div class="text-3xl font-bold text-gradient-brand mb-1">90d</div>
                  <div class="text-[11px] text-[#888]">Time to result</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </a>
    </div>
  </section>

  <!-- ═══ TESTIMONIAL ═══ -->
  <section class="section-y" style="background-color: var(--color-bg-lighter);">
    <div class="container-wide">
      <div class="max-w-3xl mx-auto text-center">
        <div class="text-7xl text-gradient-brand mb-8" style="line-height: 0.5;">"</div>
        <blockquote class="text-2xl md:text-3xl text-white font-medium leading-snug mb-10 -mt-4">
          The VITAL audit alone changed how we think about marketing. 
          For the first time we know <span class="text-gradient-brand">exactly where leads are leaking.</span>
        </blockquote>
        <div class="flex items-center justify-center gap-3">
          <div class="w-11 h-11 rounded-full" style="background: linear-gradient(135deg, #ff3131, #882020);"></div>
          <div class="text-left">
            <div class="text-sm font-medium text-white">Mae Guzman</div>
            <div class="text-xs text-[#666]">Efficy</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ PRICING TEASER ═══ -->
  <section class="section-y">
    <div class="container-wide">
      <div class="max-w-2xl mb-16">
        <p class="eyebrow mb-5">Pricing</p>
        <h2 class="text-display-2 mb-6">Transparent. <span class="text-gradient-brand">Limited slots.</span></h2>
        <p class="text-lg text-[#888] leading-relaxed">
          We take 3 clients per tier per month. When slots are full, they close. 
          Local pricing for US, UK, UAE, India.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-5">
        <div class="card card-hover p-6">
          <div class="flex items-center justify-between mb-3">
            <h3 class="text-lg font-semibold text-white">AI Visibility</h3>
            <span class="text-[10px] mono px-2 py-0.5 rounded-full border" style="border-color: #22c55e40; color: #22c55e; background-color: #22c55e10;">3 slots</span>
          </div>
          <div class="mb-1">
            <span class="text-3xl font-bold text-white">$1,000</span>
            <span class="text-sm text-[#666]">/mo</span>
          </div>
          <div class="text-xs text-[#666] mb-6">£800 · 3,700 AED · Request quote (IN)</div>
          <p class="text-sm text-[#999] leading-relaxed mb-6">
            GEO monitoring, AI citation optimization, schema + llms.txt, monthly reporting.
          </p>
          <a href="/pricing" class="btn btn-ghost w-full justify-center text-sm">
            See full pricing
          </a>
        </div>

        <div class="card card-glow p-6 relative" style="background: linear-gradient(180deg, #1c1c1c 0%, #161616 100%);">
          <div class="absolute -top-3 left-6 text-[10px] mono px-2 py-0.5 rounded-full" style="background-color: var(--color-brand); color: white;">Most popular</div>
          <div class="flex items-center justify-between mb-3">
            <h3 class="text-lg font-semibold text-white">Growth</h3>
            <span class="text-[10px] mono px-2 py-0.5 rounded-full border" style="border-color: #eab30840; color: #eab308; background-color: #eab30810;">2 slots</span>
