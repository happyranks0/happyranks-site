---
import Layout from '../layouts/Layout.astro';
import PulseDashboard from '../components/PulseDashboard.astro';

const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'What exactly is the PULSE audit?', acceptedAnswer: { '@type': 'Answer', text: 'A 5-dimension scoring system measuring Presence, Understanding, Lead capture, Sales follow-up, and Evaluation. Each dimension is scored 0-100 based on 50+ measurable checks.' } },
    { '@type': 'Question', name: 'How long until I see results?', acceptedAnswer: { '@type': 'Answer', text: 'Most clients see measurable movement in 30 days. Bigger lifts compound over 60-90 days.' } },
    { '@type': 'Question', name: 'What is the minimum commitment?', acceptedAnswer: { '@type': 'Answer', text: '3 months. After that, it is month-to-month. Most clients stay 9-18 months.' } },
    { '@type': 'Question', name: 'What if I am not happy after 30 days?', acceptedAnswer: { '@type': 'Answer', text: '30-day money-back guarantee. Full refund for that month, no questions.' } },
  ],
};

const stats = [
  { value: '312+', label: 'audits run this month' },
  { value: '50+', label: 'measurable checks per site' },
  { value: '90s', label: 'to your first score' },
  { value: '4', label: 'continents served' },
];
---

<Layout
  title="Happyranks — Marketing systems that grow revenue"
  description="A marketing system for businesses that want measurable revenue growth, not just traffic. Built around the PULSE framework. Free 90-second audit."
  active=""
  schema={faqSchema}
>
  <!-- ─── HERO (Stripe split + Cloudflare grid) ─── -->
  <section class="mesh-hero hero-section relative overflow-hidden">
    <div class="container-wide">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div class="max-w-xl">
          <div class="eyebrow-pill mb-6">PULSE Audit — free, 90 seconds</div>
          <h1 class="text-display-1 mb-6">
            Marketing infrastructure that<br/>
            <span class="text-gradient-brand">actually grows revenue</span>
          </h1>
          <p class="text-lg text-fg-secondary leading-relaxed mb-8 max-w-lg">
            Presence, lead capture, follow-up, and measurement — scored across 50+ signals.
            One audit. One plan. Numbers you can defend.
          </p>
          <div class="flex flex-wrap items-center gap-3">
            <a href="/pulse-audit" class="btn btn-primary btn-large">
              <i class="ph-bold ph-lightning"></i>
              Get my free PULSE audit
            </a>
            <a href="/work" class="btn btn-ghost btn-large">
              See the work
              <i class="ph-bold ph-arrow-up-right"></i>
            </a>
          </div>
          <div class="mt-8 flex flex-wrap gap-x-5 gap-y-2 text-[13px] text-fg-muted">
            {['No contract', '90-second report', 'AI-search ready', '30-day money-back'].map((m) => (
              <span class="flex items-center gap-1.5">
                <i class="ph-bold ph-check-circle text-success"></i>
                {m}
              </span>
            ))}
          </div>
        </div>
        <div class="relative lg:pl-4">
          <PulseDashboard />
        </div>
      </div>
    </div>
  </section>

  <!-- ─── STATS (Cloudflare backbone strip) ─── -->
  <section class="section-band py-12 md:py-14">
    <div class="container-wide">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8">
        {stats.map((s) => (
          <div class="text-center md:text-left">
            <div class="stat-tile-value">{s.value}</div>
            <div class="stat-tile-label">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── TRUST ─── -->
  <section class="py-10 border-b border-border">
    <div class="container-wide">
      <div class="text-center eyebrow mb-6">Trusted by growth-focused teams</div>
      <div class="logo-strip grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-x-8 gap-y-4 items-center justify-items-center">
        <span class="text-base tracking-tight">Tutti Rouge</span>
        <span class="text-base font-serif italic">Lotus Mahal</span>
        <span class="text-base">THINK</span>
        <span class="text-base font-light tracking-widest">VIRUKSHA</span>
        <span class="text-base">efficy</span>
      </div>
    </div>
  </section>

  <!-- ─── PULSE FRAMEWORK ─── -->
  <section class="section-y">
    <div class="container-wide">
      <div class="max-w-2xl mb-14">
        <div class="eyebrow mb-4">The PULSE framework</div>
        <h2 class="text-display-2 mb-6">
          Five questions.<br/>
          <span class="text-gradient-mesh">One score.</span>
        </h2>
        <p class="text-lg text-fg-secondary leading-relaxed">
          We measure what actually determines whether your marketing makes money —
          not vanity metrics. Each dimension is scored 0–100 from 50+ measurable signals.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-5 gap-4">
        {[
          { letter: 'P', name: 'Presence', desc: 'Can the right people find the business?', icon: 'ph-binoculars', score: 68 },
          { letter: 'U', name: 'Understanding', desc: 'Do they quickly understand what you do and why it matters?', icon: 'ph-eye', score: 74 },
          { letter: 'L', name: 'Lead capture', desc: 'Can an interested visitor become an enquiry easily?', icon: 'ph-arrow-right', score: 42 },
          { letter: 'S', name: 'Sales follow-up', desc: 'What happens after the enquiry arrives?', icon: 'ph-robot', score: 31 },
          { letter: 'E', name: 'Evaluation', desc: 'Does the business measure results and improve the system?', icon: 'ph-chart-line-up', score: 58 },
        ].map((d) => (
          <div class="card card-hover p-6 flex flex-col h-full">
            <div class="flex items-center justify-between mb-4">
              <i class={`ph-bold ${d.icon} text-2xl text-[var(--color-brand)]`}></i>
              <span class="text-2xl font-bold text-fg-muted mono">{d.letter}</span>
            </div>
            <div class="text-base font-semibold text-fg mb-2">{d.name}</div>
            <div class="text-sm text-fg-secondary leading-relaxed mb-5 flex-1">{d.desc}</div>
            <div class="progress-track">
              <div class="progress-fill" style={`width: ${d.score}%`}></div>
            </div>
            <div class="mt-2 text-[10px] mono text-fg-muted">avg. client: {d.score}/100</div>
          </div>
        ))}
      </div>

      <div class="mt-10 text-center">
        <a href="/pulse-audit" class="inline-flex items-center gap-2 text-sm text-[var(--color-brand)] font-semibold hover:gap-3 transition-all">
          See how your site scores <i class="ph-bold ph-arrow-right"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- ─── WHAT WE DO ─── -->
  <section class="section-y section-band">
    <div class="container-wide">
      <div class="max-w-2xl mb-14">
        <div class="eyebrow mb-4">What we do</div>
        <h2 class="text-display-2 mb-4">
          Not just traffic.<br/>
          <span class="text-gradient-brand">A revenue engine.</span>
        </h2>
      </div>

      <div class="grid md:grid-cols-2 gap-12 lg:gap-16 items-center mb-20">
        <div>
          <div class="eyebrow mb-3">01 — Presence</div>
          <h3 class="text-display-3 mb-4">Get cited by ChatGPT, Perplexity, and Google AI</h3>
          <p class="text-fg-secondary text-lg leading-relaxed mb-6">
            Traditional SEO isn't enough. We engineer your site to be the answer AI assistants reference — for queries that bring customers, not clicks.
          </p>
          <ul class="space-y-3 mb-8">
            {['Generative Engine Optimization (GEO)', 'Structured data & knowledge graphs', 'AI-overview citation tracking'].map((item) => (
              <li class="flex items-start gap-3 text-sm text-fg">
                <i class="ph-bold ph-check text-[var(--color-brand)] mt-0.5 shrink-0"></i>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <a href="/capabilities" class="inline-flex items-center gap-2 text-sm font-semibold text-fg hover:gap-3 transition-all">
            Learn more <i class="ph-bold ph-arrow-right text-[var(--color-brand)]"></i>
          </a>
        </div>
        <div class="relative">
          <div class="card-inset p-6 float">
            <div class="text-[10px] mono text-fg-muted uppercase tracking-widest mb-2">AI citations</div>
            <div class="stat-tile-value text-[var(--color-brand)]">+312%</div>
            <div class="text-sm text-success mt-1 flex items-center gap-1">
              <i class="ph-bold ph-trend-up"></i> in 90 days
            </div>
            <div class="mt-6 h-24 rounded-lg bg-gradient-to-r from-[#635bff]/10 via-[#00d4ff]/10 to-[#ff3131]/10 border border-border flex items-end gap-1 p-3">
              {[40, 55, 48, 72, 68, 95].map((h) => (
                <div class="flex-1 rounded-sm bg-[var(--color-brand)]/80" style={`height: ${h}%`}></div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-12 lg:gap-16 items-center mb-20">
        <div class="order-2 md:order-1">
          <div class="card-inset p-6 float">
            <div class="text-[10px] mono text-fg-muted uppercase tracking-widest mb-2">Conversion rate</div>
            <div class="stat-tile-value">3.2% → 8.4%</div>
            <div class="text-sm text-success mt-1">+161% in 60 days</div>
            <div class="mt-6 grid grid-cols-2 gap-3">
              <div class="stat-tile p-3">
                <div class="text-lg font-bold text-fg">847</div>
                <div class="text-[10px] text-fg-muted">leads / month</div>
              </div>
              <div class="stat-tile p-3">
                <div class="text-lg font-bold text-fg">8.4%</div>
                <div class="text-[10px] text-fg-muted">close rate</div>
              </div>
            </div>
          </div>
        </div>
        <div class="order-1 md:order-2">
          <div class="eyebrow mb-3">02 — Lead capture</div>
          <h3 class="text-display-3 mb-4">Turn visitors into qualified leads, predictably</h3>
          <p class="text-fg-secondary text-lg leading-relaxed mb-6">
            Beautiful sites that don't convert are expensive decoration. We rebuild the path from interested to booked call — psychology baked in.
          </p>
          <ul class="space-y-3 mb-8">
            {['Landing page architecture & copy', 'Lead magnet funnels', 'A/B test programs'].map((item) => (
              <li class="flex items-start gap-3 text-sm text-fg">
                <i class="ph-bold ph-check text-[var(--color-brand)] mt-0.5 shrink-0"></i>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <a href="/capabilities" class="inline-flex items-center gap-2 text-sm font-semibold text-fg hover:gap-3 transition-all">
            Learn more <i class="ph-bold ph-arrow-right text-[var(--color-brand)]"></i>
          </a>
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div>
          <div class="eyebrow mb-3">03 — Sales follow-up + Evaluation</div>
          <h3 class="text-display-3 mb-4">A system that runs while you sleep — and proves what worked</h3>
          <p class="text-fg-secondary text-lg leading-relaxed mb-6">
            CRM, email, retargeting, and analytics wired so every interaction is captured, nurtured, and attributed.
          </p>
          <ul class="space-y-3 mb-8">
            {['Mautic / HubSpot CRM setup', 'Email nurture sequences', 'GA4 + conversion attribution'].map((item) => (
              <li class="flex items-start gap-3 text-sm text-fg">
                <i class="ph-bold ph-check text-[var(--color-brand)] mt-0.5 shrink-0"></i>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <a href="/capabilities" class="inline-flex items-center gap-2 text-sm font-semibold text-fg hover:gap-3 transition-all">
            Learn more <i class="ph-bold ph-arrow-right text-[var(--color-brand)]"></i>
          </a>
        </div>
        <div class="card-inset p-6 float">
          <div class="text-[10px] mono text-fg-muted uppercase tracking-widest mb-2">Time saved</div>
          <div class="stat-tile-value">14h/wk</div>
          <div class="text-sm text-fg-muted mt-1">via automation</div>
          <div class="mt-6 space-y-2">
            {['Lead routed to sales', 'Welcome email sent', 'GA4 event fired', 'Retargeting audience updated'].map((line, i) => (
              <div class="flex items-center gap-2 text-xs mono text-fg-secondary card p-2.5 !shadow-none">
                <i class="ph-bold ph-check-circle text-success"></i>
                <span>{line}</span>
                <span class="ml-auto text-fg-muted">{i + 1}s</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── HOW IT WORKS ─── -->
  <section class="section-y">
    <div class="container-wide">
      <div class="max-w-2xl mb-14">
        <div class="eyebrow mb-4">How it works</div>
        <h2 class="text-display-2">
          From audit to<br/>
          <span class="text-gradient-brand">revenue in 90 days</span>
        </h2>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        {[
          { step: '01', title: 'Free PULSE audit', time: 'Day 0 — 90s', desc: 'Submit your URL. Scored across 5 dimensions. PDF in your inbox within 2 minutes.', icon: 'ph-magnifying-glass' },
          { step: '02', title: 'Strategy call', time: 'Week 1 — 45 min', desc: 'We walk findings, prioritize ROI fixes, and propose a 90-day plan. Transparent pricing.', icon: 'ph-handshake' },
          { step: '03', title: 'Build, ship, measure', time: 'Days 14 — 90', desc: 'We build the system. Weekly reports with real numbers. Re-score at day 90.', icon: 'ph-rocket-launch' },
        ].map((s) => (
          <div class="card card-hover p-6 h-full">
            <div class="flex items-center justify-between mb-6">
              <span class="text-3xl font-bold text-fg-muted mono">{s.step}</span>
              <div class="w-10 h-10 rounded-full bg-bg-subtle border border-border flex items-center justify-center text-[var(--color-brand)]">
                <i class={`ph-bold ${s.icon}`}></i>
              </div>
            </div>
            <h3 class="text-lg font-semibold text-fg mb-2">{s.title}</h3>
            <p class="text-sm text-fg-secondary leading-relaxed mb-4">{s.desc}</p>
            <div class="text-xs mono text-fg-muted">{s.time}</div>
          </div>
        ))}
      </div>

      <div class="mt-12 text-center">
        <a href="/pulse-audit" class="btn btn-primary btn-large">
          Start with a free audit
          <i class="ph-bold ph-arrow-right"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- ─── CASE STUDY ─── -->
  <section class="section-y section-band">
    <div class="container-wide">
      <div class="eyebrow mb-4">Featured case study</div>
      <h2 class="text-display-2 mb-12 max-w-2xl">
        Tutti Rouge — from invisible to <span class="text-gradient-brand">market leader</span>
      </h2>

      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="card p-0 overflow-hidden">
          <img src="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?w=1200&q=85" alt="Tutti Rouge fashion" class="w-full aspect-[4/5] object-cover" loading="lazy" />
          <div class="p-6 border-t border-border bg-bg">
            <div class="text-xs mono text-fg-muted mb-1">PULSE score lift</div>
            <div class="text-3xl font-bold text-fg">42 → 78</div>
          </div>
        </div>
        <div>
          <div class="grid sm:grid-cols-3 gap-4 mb-8">
            {[
              { metric: '+187%', label: 'organic traffic' },
              { metric: '4.2x', label: 'lead-to-customer' },
              { metric: '£2.1M', label: 'pipeline' },
            ].map((m) => (
              <div class="stat-tile">
                <div class="text-2xl font-bold text-fg">{m.metric}</div>
                <div class="text-xs text-fg-muted mt-1">{m.label}</div>
              </div>
            ))}
          </div>
          <blockquote class="text-fg text-lg leading-relaxed border-l-2 border-[var(--color-brand)] pl-4 mb-8">
            "Sanjeev's team rebuilt our entire acquisition engine. We're now showing up in AI search results ahead of brands 10x our size."
          </blockquote>
          <a href="/work/tutti-rouge" class="inline-flex items-center gap-2 text-sm font-semibold text-fg hover:gap-3 transition-all">
            Read the full case study <i class="ph-bold ph-arrow-up-right text-[var(--color-brand)]"></i>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── TESTIMONIAL ─── -->
  <section class="section-y">
    <div class="container-wide">
      <div class="max-w-3xl mx-auto text-center card p-10 md:p-14">
        <blockquote class="text-2xl md:text-[1.75rem] text-fg font-medium leading-snug mb-8">
          "Working with Happyranks felt less like hiring an agency and more like adding a senior marketing leader to our team. They measure everything, ship fast, and the numbers show."
        </blockquote>
        <div class="text-sm">
          <div class="font-semibold text-fg">Mae Guzman</div>
          <div class="text-fg-muted">Head of Growth, Efficy</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── FINAL CTA (Stripe dark band) ─── -->
  <section class="section-y section-band-dark relative">
    <div class="container-wide relative">
      <div class="max-w-2xl mx-auto text-center">
        <div class="eyebrow mb-4 !text-[#8792a2]">Ready when you are</div>
        <h2 class="text-display-2 text-white mb-6">
          Find out what<br/>
          <span class="text-gradient-brand">your site is leaking.</span>
        </h2>
        <p class="text-lg text-fg-secondary mb-10 max-w-lg mx-auto">
          A free PULSE audit takes 90 seconds. No call required. Real numbers, yours to keep.
        </p>
        <a href="/pulse-audit" class="btn btn-primary btn-large">
          <i class="ph-bold ph-lightning"></i>
          Get my free PULSE audit
        </a>
        <div class="mt-8 text-xs text-fg-muted mono flex items-center justify-center gap-2">
          <i class="ph-bold ph-shield-check text-emerald-400"></i>
          No credit card · 90 seconds · Yours to keep
        </div>
      </div>
    </div>
  </section>
</Layout>
