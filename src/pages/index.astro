---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <slot name="head">
    <title>Happyranks — Marketing Systems for the AI Era</title>
    <meta name="description" content="Get found by AI. Convert humans. Grow with systems." />
  </slot>

  <!-- Phosphor icons stylesheet (no JS needed) -->
  <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/regular/style.css" />
  <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/fill/style.css" />
  <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/bold/style.css" />

  <!-- ═══ NAV ═══ -->
  <nav class="fixed top-0 left-0 right-0 z-50 backdrop-blur-xl border-b" style="background-color: rgba(10,10,10,0.75); border-color: #161616;">
    <div class="container-wide flex items-center justify-between h-16">
      <a href="/" class="flex items-center gap-2.5">
        <div class="w-7 h-7 rounded-md flex items-center justify-center font-bold text-[13px]" style="background-color: var(--color-brand);">H</div>
        <span class="font-semibold text-[15px]">happyranks</span>
      </a>
      <div class="hidden md:flex items-center gap-8 text-sm text-[#888]">
        <a href="/services" class="hover:text-white transition-colors">Services</a>
        <a href="/case-studies" class="hover:text-white transition-colors">Work</a>
        <a href="/pricing" class="hover:text-white transition-colors">Pricing</a>
        <a href="/about" class="hover:text-white transition-colors">About</a>
      </div>
      <a href="/vital" class="btn btn-primary text-sm">
        Get VITAL Score
      </a>
    </div>
  </nav>

  <!-- ═══ HERO ═══ -->
  <section class="relative pt-32 md:pt-40 pb-16 md:pb-20 overflow-hidden">
    <div class="absolute inset-0 bg-grid bg-grid-mask opacity-50"></div>
    <div class="orb-red" style="top: -250px; left: 50%; transform: translateX(-50%); opacity: 0.5;"></div>

    <div class="container-wide relative">
      <div class="grid lg:grid-cols-12 gap-10 items-center">
        <!-- LEFT: Copy -->
        <div class="lg:col-span-7">
          <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full text-[13px] mb-8 border" style="background-color: rgba(255,49,49,0.06); border-color: rgba(255,49,49,0.25); color: #ff7a7a;">
            <span class="w-1.5 h-1.5 rounded-full pulse-dot" style="background-color: var(--color-brand);"></span>
            Built for the AI era
          </div>

          <h1 class="text-display-1 mb-7">
            <span class="text-gradient-light">Marketing that</span><br />
            <span class="text-gradient-light">AI can find.</span><br />
            <span class="text-gradient-brand">Humans can trust.</span>
          </h1>

          <p class="text-lg md:text-xl text-[#999] max-w-xl mb-9 leading-relaxed">
            We build marketing systems for mid-market businesses — 
            engineered to be cited by AI, optimized for human conversion, 
            and automated to scale.
          </p>

          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 mb-10">
            <a href="/vital" class="btn btn-primary text-[15px] px-6 py-3.5">
              Run a free VITAL audit
              <i class="ph ph-arrow-right" style="font-size: 16px;"></i>
            </a>
            <a href="/services" class="btn btn-ghost text-[15px] px-6 py-3.5">
              <i class="ph ph-play" style="font-size: 16px;"></i>
              See how it works
            </a>
          </div>

          <!-- Quick stats with icons -->
          <div class="flex flex-wrap items-center gap-6 text-sm">
            <div class="flex items-center gap-2 text-[#888]">
              <i class="ph-fill ph-check-circle" style="color: #22c55e; font-size: 18px;"></i>
              <span>No long-term contract</span>
            </div>
            <div class="flex items-center gap-2 text-[#888]">
              <i class="ph-fill ph-check-circle" style="color: #22c55e; font-size: 18px;"></i>
              <span>Full-system reporting</span>
            </div>
            <div class="flex items-center gap-2 text-[#888]">
              <i class="ph-fill ph-check-circle" style="color: #22c55e; font-size: 18px;"></i>
              <span>Built for AI era</span>
            </div>
          </div>
        </div>

        <!-- RIGHT: Visual dashboard mock -->
        <div class="lg:col-span-5">
          <div class="relative">
            <!-- Floating visual element behind -->
            <div class="absolute -top-6 -right-6 w-32 h-32 rounded-full opacity-30" style="background: radial-gradient(circle, #ff3131, transparent 70%); filter: blur(30px);"></div>

            <div class="card card-glow p-6 relative">
              <!-- Window chrome -->
              <div class="flex items-center gap-1.5 mb-5 pb-4 border-b" style="border-color: #1f1f1f;">
                <div class="w-2.5 h-2.5 rounded-full" style="background-color: #ef4444;"></div>
                <div class="w-2.5 h-2.5 rounded-full" style="background-color: #eab308;"></div>
                <div class="w-2.5 h-2.5 rounded-full" style="background-color: #22c55e;"></div>
                <div class="flex-1 mx-3">
                  <div class="text-[11px] mono text-[#666] text-center">happyranks.com/audit</div>
                </div>
                <i class="ph ph-arrow-square-out" style="color: #555; font-size: 14px;"></i>
              </div>

              <!-- Big score -->
              <div class="flex items-center justify-between mb-6">
                <div>
                  <div class="text-xs text-[#666] uppercase tracking-wider mb-1">VITAL Score</div>
                  <div class="flex items-baseline gap-1.5">
                    <span class="text-6xl font-bold text-gradient-brand leading-none">54</span>
                    <span class="text-xl text-[#444]">/100</span>
                  </div>
                </div>
                <div class="text-right">
                  <div class="text-[10px] text-[#555] uppercase tracking-wider mb-1">Grade</div>
                  <div class="text-2xl font-bold" style="color: var(--color-brand);">C+</div>
                </div>
              </div>

              <!-- Dimension bars -->
              <div class="space-y-3 mb-5">
                <div>
                  <div class="flex justify-between text-[12px] mb-1.5">
                    <span class="text-[#aaa] flex items-center gap-1.5">
                      <i class="ph ph-eye" style="font-size: 14px;"></i>
                      Visibility
                    </span>
                    <span class="mono text-[#888]">80</span>
                  </div>
                  <div class="h-1 rounded-full overflow-hidden" style="background-color: #1a1a1a;">
                    <div class="h-full rounded-full" style="width: 80%; background-color: #22c55e;"></div>
                  </div>
                </div>
                <div>
                  <div class="flex justify-between text-[12px] mb-1.5">
                    <span class="text-[#aaa] flex items-center gap-1.5">
                      <i class="ph ph-paint-brush" style="font-size: 14px;"></i>
                      Impression
                    </span>
                    <span class="mono text-[#888]">46</span>
                  </div>
                  <div class="h-1 rounded-full overflow-hidden" style="background-color: #1a1a1a;">
                    <div class="h-full rounded-full" style="width: 46%; background-color: #eab308;"></div>
                  </div>
                </div>
                <div>
                  <div class="flex justify-between text-[12px] mb-1.5">
                    <span class="text-[#aaa] flex items-center gap-1.5">
                      <i class="ph ph-arrow-right" style="font-size: 14px;"></i>
                      Transition
                    </span>
                    <span class="mono" style="color: var(--color-brand);">33</span>
                  </div>
                  <div class="h-1 rounded-full overflow-hidden" style="background-color: #1a1a1a;">
                    <div class="h-full rounded-full" style="width: 33%; background-color: var(--color-brand);"></div>
                  </div>
                </div>
                <div>
                  <div class="flex justify-between text-[12px] mb-1.5">
                    <span class="text-[#aaa] flex items-center gap-1.5">
                      <i class="ph ph-robot" style="font-size: 14px;"></i>
                      Automation
                    </span>
                    <span class="mono text-[#888]">42</span>
                  </div>
                  <div class="h-1 rounded-full overflow-hidden" style="background-color: #1a1a1a;">
                    <div class="h-full rounded-full" style="width: 42%; background-color: #eab308;"></div>
                  </div>
                </div>
                <div>
                  <div class="flex justify-between text-[12px] mb-1.5">
                    <span class="text-[#aaa] flex items-center gap-1.5">
                      <i class="ph ph-chart-line-up" style="font-size: 14px;"></i>
                      Learning
                    </span>
                    <span class="mono text-[#888]">68</span>
                  </div>
                  <div class="h-1 rounded-full overflow-hidden" style="background-color: #1a1a1a;">
                    <div class="h-full rounded-full" style="width: 68%; background-color: #22c55e;"></div>
                  </div>
                </div>
              </div>

              <!-- Bottom alert -->
              <div class="pt-4 border-t flex items-center gap-3" style="border-color: #1f1f1f;">
                <div class="w-8 h-8 rounded-md flex items-center justify-center" style="background-color: rgba(255,49,49,0.12); color: var(--color-brand);">
                  <i class="ph-fill ph-warning" style="font-size: 16px;"></i>
                </div>
                <div class="flex-1 min-w-0">
                  <div class="text-[12px] font-medium text-white">Biggest leak: Transition</div>
                  <div class="text-[11px] text-[#666] truncate">No primary CTA above the fold</div>
                </div>
                <a href="/vital" class="text-[12px] font-semibold whitespace-nowrap" style="color: var(--color-brand);">Fix →</a>
              </div>
            </div>

            <!-- Floating badge -->
            <div class="absolute -bottom-4 -left-4 card px-4 py-3 hidden md:flex items-center gap-2.5 float">
              <div class="w-8 h-8 rounded-full flex items-center justify-center" style="background-color: rgba(34,197,94,0.15); color: #22c55e;">
                <i class="ph-fill ph-trend-up" style="font-size: 16px;"></i>
              </div>
              <div>
                <div class="text-[10px] text-[#666] uppercase tracking-wider">Avg client lift</div>
                <div class="text-sm font-semibold text-white">3.2x leads</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ LOGO STRIP ═══ -->
  <section class="py-12 border-y" style="border-color: #141414;">
    <div class="container-wide">
      <p class="text-center text-xs text-[#555] mb-8 uppercase tracking-[0.15em]">Trusted by growing businesses</p>
      <div class="flex flex-wrap items-center justify-center gap-x-14 gap-y-3">
        <span class="text-[14px] font-medium text-[#555] hover:text-white transition-colors">Tutti Rouge</span>
        <span class="text-[14px] font-medium text-[#555] hover:text-white transition-colors">Lotus Mahal</span>
        <span class="text-[14px] font-medium text-[#555] hover:text-white transition-colors">Think Accounting</span>
        <span class="text-[14px] font-medium text-[#555] hover:text-white transition-colors">Viruksha Gardens</span>
        <span class="text-[14px] font-medium text-[#555] hover:text-white transition-colors">Efficy</span>
      </div>
    </div>
  </section>

  <!-- ═══ WHAT WE DO — Three big rows with custom visuals ═══ -->
  <section class="section-y">
    <div class="container-wide">
      <div class="max-w-2xl mb-20">
        <p class="eyebrow mb-5">What we do</p>
        <h2 class="text-display-2 mb-6">One system. <span class="text-gradient-brand">Three pillars.</span></h2>
        <p class="text-lg text-[#888] leading-relaxed">
          Seven capabilities. Three core outcomes. 
          Every engagement is built to be found, to convert, and to run without you.
        </p>
      </div>

      <!-- PILLAR 1: Be found by AI -->
      <div class="grid md:grid-cols-12 gap-8 md:gap-10 mb-20 items-center">
        <div class="md:col-span-5 md:order-2">
          <div class="relative">
            <!-- Visual: AI search results mockup with real Unsplash image -->
            <div class="aspect-[4/3] rounded-xl overflow-hidden relative" style="background: linear-gradient(135deg, #1a1a1a 0%, #0f0f0f 100%);">
              <img
                src="https://images.unsplash.com/photo-1677442136019-21780ecad995?w=800&q=80&auto=format&fit=crop"
                alt="AI search interface"
                class="w-full h-full object-cover opacity-50"
                loading="lazy"
              />
              <div class="absolute inset-0" style="background: linear-gradient(135deg, rgba(255,49,49,0.2) 0%, transparent 60%);"></div>
              <!-- Overlay UI -->
              <div class="absolute inset-0 p-5 flex flex-col justify-end">
                <div class="card border-[#2a2a2a] p-3 backdrop-blur-md" style="background-color: rgba(20,20,20,0.85);">
                  <div class="flex items-center gap-2 mb-2">
                    <div class="w-5 h-5 rounded" style="background-color: #10a37f;"></div>
                    <span class="text-[10px] mono text-[#888]">ChatGPT</span>
                    <span class="text-[10px] mono text-[#22c55e] ml-auto">cited</span>
                  </div>
                  <div class="text-[12px] text-white">"Best marketing agency for AI visibility"</div>
                  <div class="text-[10px] text-[#666] mt-1">→ happyranks.com/services/ai-visibility</div>
                </div>
              </div>
            </div>
            <!-- Floating stat -->
            <div class="absolute -top-3 -right-3 card px-3 py-2 hidden md:block">
              <div class="flex items-center gap-2">
                <i class="ph-fill ph-sparkle" style="color: var(--color-brand); font-size: 14px;"></i>
                <span class="text-[11px] font-medium text-white">+3.2x AI citations</span>
              </div>
            </div>
          </div>
        </div>
        <div class="md:col-span-7 md:order-1">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-md flex items-center justify-center" style="background-color: rgba(255,49,49,0.12); color: var(--color-brand);">
              <i class="ph-bold ph-binoculars" style="font-size: 22px;"></i>
            </div>
            <span class="mono text-sm text-[#555]">01</span>
          </div>
          <h3 class="text-display-3 mb-4 text-white">Be found by AI</h3>
          <p class="text-[#999] leading-relaxed mb-5">
            51% of B2B buyers now start vendor research in ChatGPT or Perplexity. 
            If AI doesn't recommend you, you don't exist in the buyer's first research pass. 
            We make sure it does — with structured data, entity optimization, and citation engineering.
          </p>
          <div class="flex flex-wrap gap-2 mb-5">
            <span class="text-[11px] mono px-2.5 py-1 rounded border" style="border-color: #2a2a2a; color: #888; background-color: #141414;">ChatGPT</span>
            <span class="text-[11px] mono px-2.5 py-1 rounded border" style="border-color: #2a2a2a; color: #888; background-color: #141414;">Perplexity</span>
            <span class="text-[11px] mono px-2.5 py-1 rounded border" style="border-color: #2a2a2a; color: #888; background-color: #141414;">Gemini</span>
            <span class="text-[11px] mono px-2.5 py-1 rounded border" style="border-color: #2a2a2a; color: #888; background-color: #141414;">AI Overviews</span>
            <span class="text-[11px] mono px-2.5 py-1 rounded border" style="border-color: #2a2a2a; color: #888; background-color: #141414;">Schema + llms.txt</span>
          </div>
          <a href="/services/ai-visibility" class="text-sm font-medium inline-flex items-center gap-1.5" style="color: var(--color-brand);">
            See AI Visibility in detail
            <i class="ph ph-arrow-right" style="font-size: 14px;"></i>
          </a>
        </div>
      </div>

      <!-- PILLAR 2: Convert humans -->
      <div class="grid md:grid-cols-12 gap-8 md:gap-10 mb-20 items-center">
        <div class="md:col-span-5">
          <div class="relative">
            <div class="aspect-[4/3] rounded-xl overflow-hidden relative" style="background: linear-gradient(135deg, #1a1a1a 0%, #0f0f0f 100%);">
              <img
                src="https://images.unsplash.com/photo-1551434678-e076c223a692?w=800&q=80&auto=format&fit=crop"
                alt="Conversion optimization"
                class="w-full h-full object-cover opacity-50"
                loading="lazy"
              />
              <div class="absolute inset-0" style="background: linear-gradient(135deg, rgba(255,49,49,0.2) 0%, transparent 60%);"></div>
              <div class="absolute inset-0 p-5 flex flex-col justify-end">
                <div class="card border-[#2a2a2a] p-3 backdrop-blur-md" style="background-color: rgba(20,20,20,0.85);">
                  <div class="text-[10px] text-[#666] uppercase tracking-wider mb-2">Conversion rate</div>
                  <div class="flex items-baseline gap-2">
                    <span class="text-2xl font-bold text-gradient-brand">1.8%</span>
                    <span class="text-xs text-[#22c55e]">→ 4.7%</span>
                  </div>
                  <div class="h-1 rounded-full mt-2" style="background-color: #1a1a1a;">
                    <div class="h-full rounded-full" style="width: 65%; background-color: var(--color-brand);"></div>
                  </div>
                </div>
              </div>
            </div>
            <div class="absolute -top-3 -right-3 card px-3 py-2 hidden md:block">
              <div class="flex items-center gap-2">
                <i class="ph-fill ph-target" style="color: var(--color-brand); font-size: 14px;"></i>
                <span class="text-[11px] font-medium text-white">+161% conv rate</span>
              </div>
            </div>
          </div>
        </div>
        <div class="md:col-span-7">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-md flex items-center justify-center" style="background-color: rgba(255,49,49,0.12); color: var(--color-brand);">
              <i class="ph-bold ph-target" style="font-size: 22px;"></i>
            </div>
            <span class="mono text-sm text-[#555]">02</span>
          </div>
          <h3 class="text-display-3 mb-4 text-white">Convert humans</h3>
          <p class="text-[#999] leading-relaxed mb-5">
            AI gets the right visitors to your site. Your website, content, and offer close them. 
            We rebuild the conversion path — copy, design, CTAs, forms, follow-up — 
            so the visitors who matter actually become leads.
          </p>
          <div class="flex flex-wrap gap-2 mb-5">
            <span class="text-[11px] mono px-2.5 py-1 rounded border" style="border-color: #2a2a2a; color: #888; background-color: #141414;">Landing pages</span>
            <span class="text-[11px] mono px-2.5 py-1 rounded border" style="border-color: #2a2a2a; color: #888; background-color: #141414;">Form optimization</span>
            <span class="text-[11px] mono px-2.5 py-1 rounded border" style="border-color: #2a2a2a; color: #888; background-color: #141414;">CRO + A/B tests</span>
            <span class="text-[11px] mono px-2.5 py-1 rounded border" style="border-color: #2a2a2a; color: #888; background-color: #141414;">WhatsApp flows</span>
            <span class="text-[11px] mono px-2.5 py-1 rounded border" style="border-color: #2a2a2a; color: #888; background-color: #141414;">Calendly + chatbots</span>
          </div>
          <a href="/services/web-cro" class="text-sm font-medium inline-flex items-center gap-1.5" style="color: var(--color-brand);">
            See Web + CRO in detail
            <i class="ph ph-arrow-right" style="font-size: 14px;"></i>
          </a>
        </div>
      </div>

      <!-- PILLAR 3: Run on systems -->
      <div class="grid md:grid-cols-12 gap-8 md:gap-10 items-center">
        <div class="md:col-span-5 md:order-2">
          <div class="relative">
            <div class="aspect-[4/3] rounded-xl overflow-hidden relative" style="background: linear-gradient(135deg, #1a1a1a 0%, #0f0f0f 100%);">
              <img
                src="https://images.unsplash.com/photo-1518432031352-d6fc5c10da5a?w=800&q=80&auto=format&fit=crop"
                alt="Marketing automation"
                class="w-full h-full object-cover opacity-50"
                loading="lazy"
              />
              <div class="absolute inset-0" style="background: linear-gradient(135deg, rgba(255,49,49,0.2) 0%, transparent 60%);"></div>
              <div class="absolute inset-0 p-5 flex flex-col justify-end">
                <div class="card border-[#2a2a2a] p-3 backdrop-blur-md" style="background-color: rgba(20,20,20,0.85);">
                  <div class="flex items-center justify-between mb-2">
                    <span class="text-[10px] text-[#666] uppercase tracking-wider">Mautic flow</span>
                    <span class="text-[10px] text-[#22c55e] mono">running</span>
                  </div>
                  <div class="text-[12px] text-white mb-1">Welcome → Score → Nurture</div>
                  <div class="flex items-center gap-1.5 mt-2">
                    <div class="w-1.5 h-1.5 rounded-full bg-[#22c55e]"></div>
                    <div class="w-1.5 h-1.5 rounded-full bg-[#22c55e]"></div>
                    <div class="w-1.5 h-1.5 rounded-full bg-[#22c55e]"></div>
                    <div class="w-1.5 h-1.5 rounded-full bg-[#444]"></div>
                    <div class="w-1.5 h-1.5 rounded-full bg-[#444]"></div>
                  </div>
                </div>
              </div>
            </div>
            <div class="absolute -top-3 -right-3 card px-3 py-2 hidden md:block">
              <div class="flex items-center gap-2">
                <i class="ph-fill ph-flow-arrow" style="color: var(--color-brand); font-size: 14px;"></i>
                <span class="text-[11px] font-medium text-white">0 manual work</span>
              </div>
            </div>
          </div>
        </div>
        <div class="md:col-span-7 md:col-span-7 md:order-1">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-md flex items-center justify-center" style="background-color: rgba(255,49,49,0.12); color: var(--color-brand);">
              <i class="ph-bold ph-gear-six" style="font-size: 22px;"></i>
            </div>
            <span class="mono text-sm text-[#555]">03</span>
          </div>
          <h3 class="text-display-3 mb-4 text-white">Run on systems</h3>
          <p class="text-[#999] leading-relaxed mb-5">
            Mautic. CRM. Lead scoring. Attribution. Email. SMS. WhatsApp. 
            We build the automation layer that captures every lead, scores them, 
            nurtures them, and routes them to sales — without you touching a thing.
          </p>
          <div class="flex flex-wrap gap-2 mb-5">
            <span class="text-[11px] mono px-2.5 py-1 rounded border" style="border-color: #2a2a2a; color: #888; background-color: #141414;">Mautic</span>
            <span class="text-[11px] mono px-2.5 py-1 rounded border" style="border-color: #2a2a2a; color: #888; background-color: #141414;">HubSpot</span>
            <span class="text-[11px] mono px-2.5 py-1 rounded border" style="border-color: #2a2a2a; color: #888; background-color: #141414;">GA4 + GTM</span>
            <span class="text-[11px] mono px-2.5 py-1 rounded border" style="border-color: #2a2a2a; color: #888; background-color: #141414;">WhatsApp API</span>
            <span class="text-[11px] mono px-2.5 py-1 rounded border" style="border-color: #2a2a2a; color: #888; background-color: #141414;">Custom dashboards</span>
          </div>
          <a href="/services/marketing-systems" class="text-sm font-medium inline-flex items-center gap-1.5" style="color: var(--color-brand);">
            See Marketing Systems in detail
            <i class="ph ph-arrow-right" style="font-size: 14px;"></i>
