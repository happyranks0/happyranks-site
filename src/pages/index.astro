---
import Layout from '../layouts/Layout.astro';
import PulseDashboard from '../components/PulseDashboard.astro';

const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'What exactly is the PULSE audit?', acceptedAnswer: { '@type': 'Answer', text: 'A 5-dimension scoring system measuring Presence, Understanding, Lead capture, Sales follow-up, and Evaluation. Each dimension is scored 0-100 based on 50+ measurable checks.' } },
    { '@type': 'Question', name: 'How long until I see results?', acceptedAnswer: { '@type': 'Answer', text: 'Most clients see measurable movement in 30 days. Bigger lifts compound over 60-90 days.' } },
    { '@type': 'Question', name: 'What is the minimum commitment?', acceptedAnswer: { '@type': 'Answer', text: '3 months. After that, it is month-to-month. Most clients stay 9-18 months.' } },
    { '@type': 'Question', name: 'What if I am not happy after 30 days?', acceptedAnswer: { '@type': 'Answer', text: '30-day money-back guarantee. Full refund for that month, no questions.' } },
  ],
};

const stats = [
  { value: '312+', label: 'audits this month' },
  { value: '50+', label: 'checks per site' },
  { value: '90s', label: 'to first score' },
  { value: '4', label: 'continents' },
];

const pillars = [
  {
    n: '01',
    title: 'Presence',
    headline: 'Be found in Google and AI search',
    body: 'GEO, technical SEO, entity authority — engineered so ChatGPT, Perplexity, and Google cite you for buyer queries.',
    icon: 'ph-binoculars',
  },
  {
    n: '02',
    title: 'Lead capture',
    headline: 'Turn traffic into enquiries',
    body: 'Landing pages, forms, and booking flows rebuilt for conversion — not decoration.',
    icon: 'ph-cursor-click',
  },
  {
    n: '03',
    title: 'Follow-up + measurement',
    headline: 'Capture, nurture, and prove ROI',
    body: 'CRM, email sequences, GA4 attribution — a closed loop from first visit to closed deal.',
    icon: 'ph-chart-line-up',
  },
];
---

<Layout
  title="Happyranks — Marketing systems that grow revenue"
  description="A marketing system for businesses that want measurable revenue growth, not just traffic. Built around the PULSE framework. Free 90-second audit."
  active=""
  schema={faqSchema}
>
  <!-- Hero -->
  <section class="mesh-hero hero-section">
    <div class="container-wide">
      <div class="grid lg:grid-cols-[1fr_minmax(0,440px)] gap-12 lg:gap-16 items-center">
        <div>
          <div class="eyebrow-pill mb-6">Free PULSE audit · 90 seconds</div>
          <h1 class="text-display-1 mb-6">
            Marketing systems that grow revenue — <span class="text-fg-secondary">measured, not guessed.</span>
          </h1>
          <p class="text-lg text-fg-secondary leading-relaxed mb-8 max-w-lg">
            We score your site across Presence, Understanding, Lead capture, Sales follow-up, and Evaluation — then build the system to improve it.
          </p>
          <div class="flex flex-wrap items-center gap-3">
            <a href="/pulse-audit" class="btn btn-primary btn-large">
              Get my free PULSE audit
            </a>
            <a href="/work" class="btn btn-ghost btn-large">
              See case studies
            </a>
          </div>
          <div class="mt-8 flex flex-wrap gap-x-5 gap-y-2 text-[13px] text-fg-muted">
            {['No contract', 'PDF in 2 minutes', 'AI-search ready', '30-day guarantee'].map((m) => (
              <span>{m}</span>
            ))}
          </div>
        </div>
        <PulseDashboard />
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="section-band py-10 md:py-12">
    <div class="container-wide">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        {stats.map((s) => (
          <div>
            <div class="stat-tile-value">{s.value}</div>
            <div class="stat-tile-label">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Logos -->
  <section class="py-10 border-b border-border">
    <div class="container-wide">
      <p class="eyebrow text-center mb-6">Trusted by growth-focused teams</p>
      <div class="logo-strip flex flex-wrap items-center justify-center gap-x-10 gap-y-4">
        <span>Tutti Rouge</span>
        <span class="font-serif italic">Lotus Mahal</span>
        <span>THINK</span>
        <span class="tracking-widest">VIRUKSHA</span>
        <span>efficy</span>
      </div>
    </div>
  </section>

  <!-- PULSE framework -->
  <section class="section-y">
    <div class="container-wide">
      <div class="max-w-xl mb-12">
        <div class="eyebrow mb-3">The PULSE framework</div>
        <h2 class="text-display-2 mb-4">Five dimensions. One defensible score.</h2>
        <p class="text-fg-secondary text-lg leading-relaxed">
          Each dimension answers one question about whether your marketing actually makes money.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-4">
        {[
          { letter: 'P', name: 'Presence', q: 'Can the right people find you?' },
          { letter: 'U', name: 'Understanding', q: 'Do they get what you do?' },
          { letter: 'L', name: 'Lead capture', q: 'Can they enquire easily?' },
          { letter: 'S', name: 'Sales follow-up', q: 'What happens after?' },
          { letter: 'E', name: 'Evaluation', q: 'Do you measure and improve?' },
        ].map((d) => (
          <div class="card p-5">
            <div class="text-sm font-semibold text-fg-muted mono mb-3">{d.letter}</div>
            <div class="font-semibold text-fg mb-2">{d.name}</div>
            <p class="text-sm text-fg-secondary leading-relaxed">{d.q}</p>
          </div>
        ))}
      </div>

      <div class="mt-8">
        <a href="/pulse-audit" class="text-sm font-medium text-fg-secondary hover:text-fg transition-colors inline-flex items-center gap-2">
          Run a free audit <i class="ph-bold ph-arrow-right text-[var(--color-brand)]"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- What we do -->
  <section class="section-y section-band">
    <div class="container-wide">
      <div class="max-w-xl mb-12">
        <div class="eyebrow mb-3">What we build</div>
        <h2 class="text-display-2">The full stack — not just one channel.</h2>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        {pillars.map((p) => (
          <div class="card card-hover p-6">
            <div class="flex items-center gap-3 mb-5">
              <div class="feature-icon">
                <i class={`ph-bold ${p.icon}`}></i>
              </div>
              <span class="text-xs mono text-fg-muted">{p.n} · {p.title}</span>
            </div>
            <h3 class="text-lg font-semibold text-fg mb-3">{p.headline}</h3>
            <p class="text-sm text-fg-secondary leading-relaxed">{p.body}</p>
          </div>
        ))}
      </div>

      <div class="mt-10">
        <a href="/capabilities" class="text-sm font-medium text-fg-secondary hover:text-fg transition-colors inline-flex items-center gap-2">
          Full capabilities <i class="ph-bold ph-arrow-right text-[var(--color-brand)]"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="section-y">
    <div class="container-wide">
      <div class="max-w-xl mb-12">
        <div class="eyebrow mb-3">How it works</div>
        <h2 class="text-display-2">Audit → plan → measurable lift in 90 days.</h2>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        {[
          { step: '01', title: 'Free PULSE audit', meta: 'Day 0', desc: 'URL + email. Scored report in your inbox within 2 minutes.' },
          { step: '02', title: 'Strategy call', meta: 'Week 1', desc: 'We prioritize fixes by revenue impact and agree a 90-day plan.' },
          { step: '03', title: 'Build & measure', meta: 'Days 14–90', desc: 'We ship the work. Weekly numbers. Re-score at day 90.' },
        ].map((s) => (
          <div class="card p-6 border-t-2 border-[color-mix(in_srgb,var(--color-brand)_35%,transparent)]">
            <div class="flex items-baseline justify-between mb-4">
              <span class="text-2xl font-semibold text-fg-muted mono">{s.step}</span>
              <span class="text-xs mono text-fg-muted">{s.meta}</span>
            </div>
            <h3 class="font-semibold text-fg mb-2">{s.title}</h3>
            <p class="text-sm text-fg-secondary leading-relaxed">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Case study -->
  <section class="section-y section-band">
    <div class="container-wide">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <div class="eyebrow mb-3">Case study</div>
          <h2 class="text-display-2 mb-6">Tutti Rouge — PULSE 42 → 78 in 90 days</h2>
          <div class="grid grid-cols-3 gap-4 mb-8">
            {[
              { v: '+187%', l: 'traffic' },
              { v: '4.2x', l: 'conversion' },
              { v: '£2.1M', l: 'pipeline' },
            ].map((m) => (
              <div>
                <div class="text-xl font-semibold text-fg">{m.v}</div>
                <div class="text-xs text-fg-muted mt-1">{m.l}</div>
              </div>
            ))}
          </div>
          <blockquote class="text-fg-secondary leading-relaxed border-l border-[var(--color-brand)] pl-4 mb-6">
            "We're now showing up in AI search results ahead of brands 10x our size."
          </blockquote>
          <a href="/work/tutti-rouge" class="text-sm font-medium text-fg hover:text-fg-secondary transition-colors inline-flex items-center gap-2">
            Read case study <i class="ph-bold ph-arrow-up-right"></i>
          </a>
        </div>
        <div class="card p-0 overflow-hidden">
          <img src="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?w=900&q=80" alt="Tutti Rouge" class="w-full aspect-[4/3] object-cover" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-y section-cta">
    <div class="container-wide">
      <div class="max-w-xl mx-auto text-center">
        <h2 class="text-display-2 mb-4">See what your site is leaking.</h2>
        <p class="text-fg-secondary text-lg mb-8">
          Free PULSE audit. 90 seconds. Real numbers — no sales call required.
        </p>
        <a href="/pulse-audit" class="btn btn-primary btn-large">
          Get my free PULSE audit
        </a>
      </div>
    </div>
  </section>
</Layout>
