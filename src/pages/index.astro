---
import Layout from '../layouts/Layout.astro';
import PulseScore from '../components/PulseScore.astro';

const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'What exactly is the PULSE audit?', acceptedAnswer: { '@type': 'Answer', text: 'A 5-dimension scoring system measuring Presence, Understanding, Lead capture, Sales follow-up, and Evaluation. Each dimension is scored 0-100 based on 50+ measurable checks.' } },
    { '@type': 'Question', name: 'How long until I see results?', acceptedAnswer: { '@type': 'Answer', text: 'Most clients see measurable movement in 30 days. Bigger lifts compound over 60-90 days.' } },
    { '@type': 'Question', name: 'What is the minimum commitment?', acceptedAnswer: { '@type': 'Answer', text: '3 months. After that, it is month-to-month. Most clients stay 9-18 months.' } },
    { '@type': 'Question', name: 'What if I am not happy after 30 days?', acceptedAnswer: { '@type': 'Answer', text: '30-day money-back guarantee. Full refund for that month, no questions.' } },
  ],
};

const marqueeItems = [
  { stat: '312+', label: 'audits this month' },
  { stat: '50+', label: 'checks per site' },
  { stat: '90s', label: 'to first score' },
  { stat: '4', label: 'continents' },
  { stat: 'PULSE', label: 'framework' },
  { stat: '2 min', label: 'PDF delivery' },
];

const pulseDimensions = [
  { letter: 'P', name: 'Presence', question: 'Can the right people find you?', detail: 'Google, ChatGPT, Perplexity — engineered visibility for buyer queries.' },
  { letter: 'U', name: 'Understanding', question: 'Do they get what you do?', detail: 'Hero clarity, speed, design — first impression that converts.' },
  { letter: 'L', name: 'Lead capture', question: 'Can they enquire easily?', detail: 'Forms, booking flows, CTAs — friction removed from the funnel.' },
  { letter: 'S', name: 'Sales follow-up', question: 'What happens after?', detail: 'CRM, nurture sequences, retargeting — no lead left behind.' },
  { letter: 'E', name: 'Evaluation', question: 'Do you measure and improve?', detail: 'Attribution, dashboards, experiments — closed-loop growth.' },
];

const systems = [
  {
    title: 'Presence engine',
    desc: 'Technical SEO + GEO so AI search and Google cite you for the queries that bring revenue.',
    span: 'bento-a',
    icon: 'ph-radar',
  },
  {
    title: 'Conversion layer',
    desc: 'Landing pages, forms, and booking flows rebuilt for enquiry — not decoration.',
    span: 'bento-b',
    icon: 'ph-cursor-click',
  },
  {
    title: 'Nurture stack',
    desc: 'Email sequences, CRM routing, retargeting pixels — wired to sales handoff.',
    span: 'bento-c',
    icon: 'ph-envelope-simple',
  },
  {
    title: 'Measurement core',
    desc: 'GA4, server-side tracking, attribution models — know where every dollar came from.',
    span: 'bento-d',
    icon: 'ph-chart-line-up',
  },
  {
    title: 'Iteration loop',
    desc: 'Weekly reports, A/B tests, quarterly re-scores — the system improves itself.',
    span: 'bento-e',
    icon: 'ph-arrows-clockwise',
  },
];
---

<Layout
  title="Happyranks — Marketing systems that grow revenue"
  description="A marketing system for businesses that want measurable revenue growth, not just traffic. Built around the PULSE framework. Free 90-second audit."
  active=""
  schema={faqSchema}
>
  <!-- Hero -->
  <section class="hero-canvas">
    <div class="wrap hero-grid pb-16 lg:pb-24">
      <div class="relative z-10">
        <p class="kicker kicker-accent mb-5">Free PULSE audit · 90 seconds</p>
        <h1 class="display-hero mb-6">
          Your marketing<br />
          should print money.
        </h1>
        <p class="lead max-w-lg mb-8">
          We score your site across five dimensions that actually drive revenue — then build the system to lift the score. No vanity metrics. No guesswork.
        </p>
        <div class="flex flex-wrap items-center gap-3 mb-10">
          <a href="/pulse-audit" class="btn btn-primary btn-large">
            Get my free PULSE audit
            <i class="ph-bold ph-lightning"></i>
          </a>
          <a href="/work" class="btn btn-ghost btn-large">
            See case studies
          </a>
        </div>
        <div class="flex flex-wrap gap-x-6 gap-y-2 text-[13px] text-ink-3 mono">
          <span>No contract</span>
          <span>PDF in 2 minutes</span>
          <span>30-day guarantee</span>
        </div>
        <div class="lg:hidden mt-10 panel panel-pad flex items-center justify-between gap-4">
          <div>
            <p class="kicker mb-1">Sample score</p>
            <p class="stat-tile-value">62<span class="text-base text-ink-3 font-normal">/100</span></p>
          </div>
          <div class="text-right">
            <p class="kicker mb-1">Est. lift</p>
            <p class="stat-tile-value text-accent">+2.4x</p>
          </div>
        </div>
      </div>
      <div class="relative z-10 hidden lg:block">
        <PulseScore />
      </div>
    </div>
  </section>

  <!-- Marquee -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {marqueeItems.concat(marqueeItems).map((item) => (
        <span class="marquee-item">
          <strong>{item.stat}</strong>
          {item.label}
          <span class="text-accent">·</span>
        </span>
      ))}
    </div>
  </div>

  <!-- Problem -->
  <section class="section">
    <div class="wrap">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-end">
        <div>
          <p class="kicker mb-4">The leak</p>
          <h2 class="display-lg mb-0">
            Most sites look fine.<br />
            <span class="text-ink-2">Most funnels are broken.</span>
          </h2>
        </div>
        <div>
          <p class="lead">
            Traffic without attribution. Forms without follow-up. SEO without AI visibility. Agencies shipping reports instead of systems. The PULSE audit finds exactly where revenue leaks — in 90 seconds, with numbers you can defend.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- PULSE bento -->
  <section class="section-tight bg-canvas-1 border-y border-line">
    <div class="wrap">
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-10">
        <div>
          <p class="kicker mb-3">The framework</p>
          <h2 class="display-lg">Five questions.<br />One score.</h2>
        </div>
        <p class="lead max-w-md lg:text-right">
          Each dimension answers whether your marketing makes money — scored 0–100 from 50+ measurable checks.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-4 mb-4">
        {pulseDimensions.slice(0, 2).map((d) => (
          <div class="bento-cell panel-hover min-h-[220px]">
            <span class="bento-letter">{d.letter}</span>
            <p class="kicker mb-2">{d.name}</p>
            <h3 class="display-md mb-3">{d.question}</h3>
            <p class="body-sm">{d.detail}</p>
          </div>
        ))}
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {pulseDimensions.slice(2).map((d) => (
          <div class="bento-cell panel-hover min-h-[200px]">
            <span class="bento-letter">{d.letter}</span>
            <p class="kicker mb-2">{d.name}</p>
            <h3 class="display-md mb-3">{d.question}</h3>
            <p class="body-sm">{d.detail}</p>
          </div>
        ))}
      </div>

      <div class="mt-8">
        <a href="/pulse-audit" class="btn btn-text">
          Run a free audit
          <i class="ph-bold ph-arrow-right text-accent"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- Systems bento -->
  <section class="section">
    <div class="wrap">
      <div class="mb-12 max-w-2xl">
        <p class="kicker mb-3">What we build</p>
        <h2 class="display-lg mb-4">The full stack —<br />not just one channel.</h2>
        <p class="lead">We ship interconnected systems: findability, conversion, nurture, measurement, iteration. One team, one score, one roadmap.</p>
      </div>

      <div class="bento">
        {systems.map((s) => (
          <div class:list={['bento-cell panel-hover', s.span]}>
            <div class="feature-icon mb-5">
              <i class={`ph-bold ${s.icon}`}></i>
            </div>
            <h3 class="display-md mb-3">{s.title}</h3>
            <p class="body-sm">{s.desc}</p>
          </div>
        ))}
      </div>

      <div class="mt-10">
        <a href="/capabilities" class="btn btn-text">
          Full capabilities
          <i class="ph-bold ph-arrow-right text-accent"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- Process timeline -->
  <section class="section-tight bg-canvas-1 border-y border-line">
    <div class="wrap">
      <div class="mb-10">
        <p class="kicker mb-3">How it works</p>
        <h2 class="display-lg">Audit → plan → lift in 90 days.</h2>
      </div>

      <div class="timeline">
        {[
          { n: '01', title: 'Free PULSE audit', meta: 'Day 0', desc: 'URL + email. Scored PDF in your inbox within 2 minutes.' },
          { n: '02', title: 'Strategy call', meta: 'Week 1', desc: 'Prioritize fixes by revenue impact. Agree a 90-day plan.' },
          { n: '03', title: 'Build & measure', meta: 'Days 14–90', desc: 'We ship the work. Weekly numbers. Re-score at day 90.' },
        ].map((s) => (
          <div class="timeline-step">
            <p class="timeline-step-num">{s.n} · {s.meta}</p>
            <h3 class="display-md mb-3">{s.title}</h3>
            <p class="body-sm">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured case study -->
  <section class="section">
    <div class="wrap">
      <div class="panel overflow-hidden">
        <div class="grid lg:grid-cols-2">
          <div class="p-8 lg:p-12 lg:pr-8">
            <p class="kicker mb-4">Case study</p>
            <h2 class="display-lg mb-6">Tutti Rouge<br /><span class="text-ink-2">PULSE 42 → 78</span></h2>
            <div class="grid grid-cols-3 gap-6 mb-8">
              {[
                { v: '+187%', l: 'traffic' },
                { v: '4.2x', l: 'conversion' },
                { v: '£2.1M', l: 'pipeline' },
              ].map((m) => (
                <div>
                  <div class="stat-tile-value">{m.v}</div>
                  <div class="stat-tile-label">{m.l}</div>
                </div>
              ))}
            </div>
            <blockquote class="text-ink-2 leading-relaxed border-l-2 border-accent pl-4 mb-8">
              "We're now showing up in AI search results ahead of brands 10x our size."
            </blockquote>
            <a href="/work/tutti-rouge" class="btn btn-ghost">
              Read case study
              <i class="ph-bold ph-arrow-up-right"></i>
            </a>
          </div>
          <div class="relative min-h-[280px] lg:min-h-full bg-canvas-3 flex items-center justify-center p-8 border-t lg:border-t-0 lg:border-l border-line">
            <div class="text-center">
              <p class="kicker mb-3">Fashion resale · UK</p>
              <p class="display-md text-ink-2 max-w-xs mx-auto">
                From invisible to market leader in UK fashion resale — GEO, conversion, attribution.
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-8 flex flex-wrap gap-6 text-sm text-ink-3">
        <span>Tutti Rouge</span>
        <span>Lotus Mahal</span>
        <span>Think Accounting</span>
        <span>Viruksha Gardens</span>
        <a href="/work" class="text-ink-2 hover:text-ink transition-colors">All case studies →</a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section-cta">
    <div class="wrap text-center max-w-2xl mx-auto">
      <h2 class="display-lg mb-4">See what your site is leaking.</h2>
      <p class="lead mb-8">
        Free PULSE audit. 90 seconds. Real numbers — no sales call required.
      </p>
      <a href="/pulse-audit" class="btn btn-primary btn-large">
        Get my free PULSE audit
        <i class="ph-bold ph-lightning"></i>
      </a>
    </div>
  </section>
</Layout>
