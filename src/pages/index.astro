---
import Layout from '../layouts/Layout.astro';
import PulseScore from '../components/PulseScore.astro';
import PulseAuditForm from '../components/PulseAuditForm.astro';
import FeaturesBlock from '@/components/blocks/features-2.astro';
import FaqsBlock from '@/components/blocks/faqs-1.astro';
import CtaBlock from '@/components/blocks/cta-7.astro';
import { Badge } from '@/components/ui/badge';
import { Button } from '@/components/ui/button';
import { Section, SectionContainer } from '@/components/ui/section';

const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'What exactly is the PULSE audit?', acceptedAnswer: { '@type': 'Answer', text: 'A 5-dimension scoring system measuring Presence, Understanding, Lead capture, Sales follow-up, and Evaluation. Each dimension is scored 0-100 based on 50+ measurable checks.' } },
    { '@type': 'Question', name: 'How long until I see results?', acceptedAnswer: { '@type': 'Answer', text: 'Most clients see measurable movement in 30 days. Bigger lifts compound over 60-90 days.' } },
    { '@type': 'Question', name: 'What is the minimum commitment?', acceptedAnswer: { '@type': 'Answer', text: '3 months. After that, it is month-to-month. Most clients stay 9-18 months.' } },
    { '@type': 'Question', name: 'What if I am not happy after 30 days?', acceptedAnswer: { '@type': 'Answer', text: '30-day money-back guarantee. Full refund for that month, no questions.' } },
  ],
};

const faqItems = faqSchema.mainEntity.map((item) => ({
  id: item.name.toLowerCase().replace(/[^a-z0-9]+/g, '-'),
  question: item.name,
  answer: item.acceptedAnswer.text,
}));

const pulseDimensions = [
  { letter: 'P', name: 'Presence', q: 'Can the right people find you?', span: 'col-span-12 md:col-span-6 lg:col-span-4' },
  { letter: 'U', name: 'Understanding', q: 'Do they get what you do?', span: 'col-span-12 md:col-span-6 lg:col-span-4' },
  { letter: 'L', name: 'Lead capture', q: 'Can they enquire easily?', span: 'col-span-12 md:col-span-6 lg:col-span-4' },
  { letter: 'S', name: 'Sales follow-up', q: 'What happens after?', span: 'col-span-12 md:col-span-6 lg:col-span-6' },
  { letter: 'E', name: 'Evaluation', q: 'Do you measure and improve?', span: 'col-span-12 md:col-span-6 lg:col-span-6' },
];

const clients = ['Tutti Rouge', 'Lotus Mahal', 'Think Accounting', 'Viruksha Gardens'];
---

<Layout
  title="Happyranks — Marketing systems that grow revenue"
  description="A marketing system for businesses that want measurable revenue growth. Built around the PULSE framework. Free 90-second audit."
  active=""
  schema={faqSchema}
>
  <!-- Hero bento -->
  <Section class="page-hero mesh-grid overflow-hidden border-b border-white/5 pt-28 lg:pt-32">
    <SectionContainer class="site-shell !max-w-7xl relative z-10">
      <div class="bento-grid items-stretch">
        <div class="col-span-12 flex flex-col justify-center gap-6 lg:col-span-7">
          <Badge variant="outline" class="w-fit border-primary/30 bg-primary/10 text-primary gap-2">
            <span class="size-1.5 rounded-full bg-primary animate-pulse"></span>
            Free PULSE audit · 90 seconds
          </Badge>
          <h1 class="font-display text-4xl font-bold leading-[1.02] tracking-tight text-balance sm:text-5xl lg:text-6xl">
            Revenue systems for teams who
            <span class="bg-gradient-to-r from-primary via-accent to-primary bg-clip-text text-transparent"> measure everything.</span>
          </h1>
          <p class="max-w-xl text-lg leading-relaxed text-base-content/70">
            Happyranks scores your marketing across five dimensions that actually drive revenue — then builds the system to lift the score.
          </p>
          <div class="flex flex-wrap gap-3">
            <Button as="a" href="#audit" size="lg">
              Get my free PULSE audit
              <i class="ph-bold ph-lightning"></i>
            </Button>
            <Button as="a" href="/work" variant="outline" size="lg">View case studies</Button>
          </div>
          <p class="text-sm text-base-content/50">No contract · PDF in 2 minutes · 30-day guarantee</p>
        </div>
        <div class="col-span-12 lg:col-span-5">
          <PulseScore />
        </div>
      </div>
    </SectionContainer>
  </Section>

  <!-- Stats -->
  <Section class="border-b border-white/5 bg-base-200/40 py-10">
    <SectionContainer class="site-shell !max-w-7xl">
      <div class="stats stats-vertical w-full bg-transparent shadow-none lg:stats-horizontal">
        {[
          { v: '50+', l: 'checks per audit' },
          { v: '90s', l: 'to first score' },
          { v: '5', l: 'PULSE dimensions' },
          { v: '2 min', l: 'PDF delivery' },
        ].map((s) => (
          <div class="stat place-items-center border-white/5 px-4 py-2 lg:border-l first:lg:border-l-0">
            <div class="stat-value font-display text-3xl text-base-content">{s.v}</div>
            <div class="stat-desc text-base-content/50">{s.l}</div>
          </div>
        ))}
      </div>
    </SectionContainer>
  </Section>

  <!-- Clients -->
  <Section class="border-b border-white/5 py-10">
    <SectionContainer class="site-shell !max-w-7xl text-center">
      <p class="mb-5 text-xs font-semibold uppercase tracking-[0.16em] text-base-content/40">Trusted by growth-focused teams</p>
      <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-3">
        {clients.map((c) => (
          <span class="text-sm font-medium text-base-content/50">{c}</span>
        ))}
      </div>
    </SectionContainer>
  </Section>

  <!-- Inline audit -->
  <Section id="audit" class="border-b border-white/5 bg-base-200/30 py-20 lg:py-28">
    <SectionContainer class="site-shell !max-w-7xl">
      <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
        <div>
          <Badge variant="outline" class="mb-4 border-primary/30 text-primary">Run a scan</Badge>
          <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">Score your site in 90 seconds.</h2>
          <p class="mt-4 text-lg leading-relaxed text-base-content/70">
            Enter your URL and email. Our engine runs 50+ checks across five dimensions and emails a 10-page PDF with prioritized fixes.
          </p>
          <ul class="mt-6 space-y-3 text-sm text-base-content/70">
            {['No credit card', 'No sales call', 'Real numbers, not opinions'].map((t) => (
              <li class="flex items-center gap-2">
                <i class="ph-bold ph-check-circle text-success"></i>
                {t}
              </li>
            ))}
          </ul>
        </div>
        <div class="glass-panel glow-ring p-6 lg:p-8">
          <PulseAuditForm formId="home-audit-form" showTitle={false} compact={true} />
        </div>
      </div>
    </SectionContainer>
  </Section>

  <!-- PULSE framework bento -->
  <Section class="py-20 lg:py-28">
    <SectionContainer class="site-shell !max-w-7xl">
      <div class="mb-12 max-w-2xl">
        <Badge variant="outline" class="mb-4 border-primary/30 text-primary">The PULSE framework</Badge>
        <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">Five dimensions. One defensible score.</h2>
        <p class="mt-4 text-lg text-base-content/70">
          Each dimension answers whether your marketing makes money — scored 0–100 from measurable checks, not consultant opinions.
        </p>
      </div>
      <div class="bento-grid">
        {pulseDimensions.map((d) => (
          <div class:list={['pulse-dimension', d.span]}>
            <div class="font-display text-4xl font-extrabold text-primary">{d.letter}</div>
            <h3 class="mt-4 text-lg font-semibold">{d.name}</h3>
            <p class="mt-2 text-sm text-base-content/60">{d.q}</p>
          </div>
        ))}
      </div>
      <div class="mt-8">
        <Button as="a" href="/capabilities" variant="outline">
          Explore all capabilities
          <i class="ph-bold ph-arrow-right"></i>
        </Button>
      </div>
    </SectionContainer>
  </Section>

  <!-- Features -->
  <FeaturesBlock
    title="The full marketing stack — deployed and measured."
    description="From findability to follow-up to attribution. One team, one score, one roadmap."
    features={[
      { icon: 'radar', title: 'Presence + GEO', description: 'Technical SEO and AI-search optimization — show up in Google, ChatGPT, and Perplexity for buyer queries.' },
      { icon: 'mouse-pointer-click', title: 'Conversion systems', description: 'Landing pages, forms, and booking flows rebuilt for enquiry — not decoration.' },
      { icon: 'mail', title: 'Nurture + CRM', description: 'Email sequences, lead routing, retargeting — wired from first visit to sales handoff.' },
      { icon: 'chart-line', title: 'Measurement', description: 'GA4, server-side tracking, attribution models — know where every dollar came from.' },
      { icon: 'refresh-cw', title: 'Iteration loop', description: 'Weekly reports, A/B tests, quarterly re-scores — the system compounds over time.' },
      { icon: 'shield-check', title: '90-day guarantee', description: 'Money-back if we are not delivering value in the first 30 days. No friction.' },
    ]}
    class="border-y border-white/5 bg-base-200/30"
  />

  <!-- Process -->
  <Section class="py-20 lg:py-28">
    <SectionContainer class="site-shell !max-w-7xl">
      <Badge variant="outline" class="mb-4 border-primary/30 text-primary">How it works</Badge>
      <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">Audit → plan → measurable lift in 90 days.</h2>
      <div class="mt-12 grid gap-8 lg:grid-cols-3">
        {[
          { n: '01', t: 'Free PULSE audit', d: 'URL + email. Scored PDF in your inbox within 2 minutes.' },
          { n: '02', t: 'Strategy call', d: 'Prioritize fixes by revenue impact. Agree a 90-day plan.' },
          { n: '03', t: 'Build & measure', d: 'We ship the work. Weekly numbers. Re-score at day 90.' },
        ].map((s) => (
          <div class="glass-panel p-6">
            <p class="font-mono text-sm text-primary">{s.n}</p>
            <h3 class="mt-3 font-display text-xl font-bold">{s.t}</h3>
            <p class="mt-2 text-sm leading-relaxed text-base-content/60">{s.d}</p>
          </div>
        ))}
      </div>
    </SectionContainer>
  </Section>

  <!-- Case study -->
  <Section class="border-y border-white/5 bg-base-200/30 py-20 lg:py-28">
    <SectionContainer class="site-shell !max-w-7xl">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <Badge variant="outline" class="mb-4 border-primary/30 text-primary">Case study</Badge>
          <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">Tutti Rouge</h2>
          <p class="mt-2 font-mono text-primary">PULSE 42 → 78 · 90 days</p>
          <div class="mt-8 grid grid-cols-3 gap-4">
            {[
              { v: '+187%', l: 'traffic' },
              { v: '4.2×', l: 'conversion' },
              { v: '£2.1M', l: 'pipeline' },
            ].map((m) => (
              <div class="stat-glass">
                <div class="font-display text-2xl font-bold">{m.v}</div>
                <div class="mt-1 text-xs text-base-content/50">{m.l}</div>
              </div>
            ))}
          </div>
          <Button as="a" href="/work/tutti-rouge" class="mt-8" size="lg">
            Read case study
            <i class="ph-bold ph-arrow-up-right"></i>
          </Button>
        </div>
        <div class="glass-panel aspect-[4/3] overflow-hidden p-0">
          <div class="flex h-full w-full flex-col items-center justify-center gap-4 bg-gradient-to-br from-primary/20 via-base-300 to-base-200 p-8 text-center">
            <img src="/logos/tutti-rouge.svg" alt="Tutti Rouge" class="h-12 opacity-80" width="160" height="48" />
            <p class="max-w-xs text-sm text-base-content/60">Full case study with before/after PULSE breakdown and revenue attribution.</p>
          </div>
        </div>
      </div>
    </SectionContainer>
  </Section>

  <!-- FAQ -->
  <FaqsBlock
    title="Common questions"
    description="Everything you need to know before running your first audit."
    faqs={faqItems}
    class="py-20 lg:py-28"
  />

  <!-- CTA -->
  <CtaBlock
    title="See what your site is leaking."
    description="Free PULSE audit. Real numbers. No sales call required."
    buttons={[
      { label: 'Get my free PULSE audit', href: '#audit' },
      { label: 'Book a strategy call', href: '/contact', variant: 'outline' },
    ]}
    socialProof={{
      avatars: [
        { initials: 'TR' },
        { initials: 'LM' },
        { initials: 'TA' },
      ],
      count: '+40',
      text: 'teams scored this quarter',
    }}
  />
</Layout>
