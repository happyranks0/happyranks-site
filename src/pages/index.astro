---
import Layout from '../layouts/Layout.astro';
import PulseScore from '../components/PulseScore.astro';
import PulseAuditForm from '../components/PulseAuditForm.astro';

const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'What exactly is the PULSE audit?', acceptedAnswer: { '@type': 'Answer', text: 'A 5-dimension scoring system measuring Presence, Understanding, Lead capture, Sales follow-up, and Evaluation. Each dimension is scored 0-100 based on 50+ measurable checks.' } },
    { '@type': 'Question', name: 'How long until I see results?', acceptedAnswer: { '@type': 'Answer', text: 'Most clients see measurable movement in 30 days. Bigger lifts compound over 60-90 days.' } },
    { '@type': 'Question', name: 'What is the minimum commitment?', acceptedAnswer: { '@type': 'Answer', text: '3 months. After that, it is month-to-month. Most clients stay 9-18 months.' } },
    { '@type': 'Question', name: 'What if I am not happy after 30 days?', acceptedAnswer: { '@type': 'Answer', text: '30-day money-back guarantee. Full refund for that month, no questions.' } },
  ],
};

const faqItems = faqSchema.mainEntity.map((item) => ({
  q: item.name,
  a: item.acceptedAnswer.text,
}));

const pulseDimensions = [
  { n: 'I', letter: 'P', name: 'Presence', q: 'Can the right people find you?', d: 'Google, ChatGPT, Perplexity — visibility engineered for buyer queries, not vanity traffic.' },
  { n: 'II', letter: 'U', name: 'Understanding', q: 'Do they get what you do?', d: 'Hero clarity, speed, design hierarchy — a first impression that earns the scroll.' },
  { n: 'III', letter: 'L', name: 'Lead capture', q: 'Can they enquire easily?', d: 'Forms, booking flows, and CTAs rebuilt to convert — not decorate.' },
  { n: 'IV', letter: 'S', name: 'Sales follow-up', q: 'What happens after?', d: 'CRM, nurture sequences, retargeting — no enquiry left behind.' },
  { n: 'V', letter: 'E', name: 'Evaluation', q: 'Do you measure and improve?', d: 'Attribution, dashboards, experiments — a closed loop from spend to revenue.' },
];

const clients = ['Tutti Rouge', 'Lotus Mahal', 'Think Accounting', 'Viruksha Gardens'];
---

<Layout
  title="Happyranks — Marketing systems that grow revenue"
  description="A marketing system for businesses that want measurable revenue growth. Built around the PULSE framework. Free 90-second audit."
  active=""
  schema={faqSchema}
>
  <!-- Masthead -->
  <section class="masthead">
    <div class="wrap masthead-grid">
      <div>
        <p class="kicker mb-5">Free PULSE audit · 90 seconds</p>
        <h1 class="display-hero mb-6">
          Marketing that<br />
          <em class="serif not-italic">prints money.</em>
        </h1>
        <p class="lead max-w-md mb-8">
          We score your site on five dimensions that drive revenue — then build the system to lift the score. Numbers you can defend. Work you can measure.
        </p>
        <div class="flex flex-wrap gap-3 mb-8">
          <a href="#audit" class="btn btn-primary btn-large">Get my free audit</a>
          <a href="/work" class="btn btn-ghost btn-large">Case studies</a>
        </div>
        <p class="text-sm text-ink-3 mono">No contract · PDF in 2 min · 30-day guarantee</p>
      </div>
      <div class="lg:pt-4">
        <PulseScore />
      </div>
    </div>
  </section>

  <!-- Ink band: inline audit -->
  <section id="audit" class="band-ink section-tight">
    <div class="wrap">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div>
          <p class="kicker mb-4">Run it now</p>
          <h2 class="display-lg mb-4">Your score in two minutes.</h2>
          <p class="lead">URL and email. A 10-page PDF with prioritized fixes — no sales call, no credit card.</p>
        </div>
        <div class="panel panel-pad-lg band-ink-form">
          <PulseAuditForm formId="home-audit-form" showTitle={false} compact={true} />
        </div>
      </div>
    </div>
  </section>

  <!-- Clients -->
  <section class="section-tight border-b border-line">
    <div class="wrap">
      <p class="kicker text-center mb-6">Selected clients</p>
      <div class="flex flex-wrap justify-center gap-x-10 gap-y-3 text-sm font-medium text-ink-3 tracking-wide">
        {clients.map((c) => <span>{c}</span>)}
      </div>
    </div>
  </section>

  <!-- PULSE framework -->
  <section class="section">
    <div class="wrap">
      <div class="grid lg:grid-cols-[0.9fr_1.1fr] gap-12 lg:gap-20 items-start mb-4">
        <div>
          <p class="kicker mb-4">The framework</p>
          <h2 class="display-lg">Five questions.<br />One defensible score.</h2>
        </div>
        <p class="lead lg:pt-8">
          PULSE measures whether your marketing makes money — 50+ checks per dimension, scored 0–100, weighted into a single number CEOs can track quarterly.
        </p>
      </div>

      <div class="pulse-list">
        {pulseDimensions.map((d) => (
          <article class="pulse-item">
            <div class="pulse-item-num">{d.n}</div>
            <div>
              <p class="kicker mb-1">{d.name} · {d.letter}</p>
              <h3 class="display-md">{d.q}</h3>
            </div>
            <p class="body-sm lg:pt-2">{d.d}</p>
          </article>
        ))}
      </div>

      <div class="mt-10">
        <a href="/capabilities" class="btn btn-ghost">Full capabilities <i class="ph-bold ph-arrow-right"></i></a>
      </div>
    </div>
  </section>

  <!-- What we build -->
  <section class="section-tight section-band">
    <div class="wrap">
      <p class="kicker mb-4">What we build</p>
      <h2 class="display-lg mb-12 max-w-2xl">The full stack — findability, conversion, nurture, measurement.</h2>

      <div class="grid md:grid-cols-3 gap-8 md:gap-12">
        {[
          { t: 'Presence + GEO', d: 'Technical SEO and AI-search optimization so the right buyers find you in Google and ChatGPT.' },
          { t: 'Conversion systems', d: 'Landing pages, forms, and booking flows engineered for enquiry — not awards.' },
          { t: 'Measurement loop', d: 'GA4, attribution, weekly reporting, quarterly re-scores — the system improves itself.' },
        ].map((item) => (
          <div>
            <h3 class="text-lg font-semibold text-ink mb-3">{item.t}</h3>
            <p class="body-sm">{item.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section">
    <div class="wrap">
      <p class="kicker mb-4">How it works</p>
      <h2 class="display-lg mb-10">Audit → plan → lift in 90 days.</h2>
      <div class="timeline">
        {[
          { n: '01', t: 'Free PULSE audit', d: 'URL + email. Scored PDF in your inbox within 2 minutes.' },
          { n: '02', t: 'Strategy call', d: 'Prioritize fixes by revenue impact. Agree a 90-day roadmap.' },
          { n: '03', t: 'Build & measure', d: 'We ship the work. Weekly numbers. Re-score at day 90.' },
        ].map((s) => (
          <div class="timeline-step">
            <p class="timeline-step-num">{s.n}</p>
            <h3 class="display-md mb-3">{s.t}</h3>
            <p class="body-sm">{s.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Case study -->
  <section class="band-ink section">
    <div class="wrap">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div>
          <p class="kicker mb-4">Case study</p>
          <h2 class="display-lg mb-2">Tutti Rouge</h2>
          <p class="lead mb-8">PULSE 42 → 78 in 90 days. UK fashion resale — from invisible to cited in AI search.</p>
          <div class="grid grid-cols-3 gap-6 mb-8">
            {[
              { v: '+187%', l: 'traffic' },
              { v: '4.2×', l: 'conversion' },
              { v: '£2.1M', l: 'pipeline' },
            ].map((m) => (
              <div>
                <div class="stat-tile-value text-[var(--color-ink-band-fg)]">{m.v}</div>
                <div class="stat-tile-label text-[var(--color-ink-band-muted)]">{m.l}</div>
              </div>
            ))}
          </div>
          <a href="/work/tutti-rouge" class="btn btn-ghost border-[rgba(255,255,255,0.2)] text-[var(--color-ink-band-fg)] hover:bg-white/10">
            Read case study <i class="ph-bold ph-arrow-up-right"></i>
          </a>
        </div>
        <div class="relative aspect-[4/3] rounded-sm overflow-hidden border border-white/10">
          <img src="/images/tutti-rouge.jpg" alt="Tutti Rouge" class="absolute inset-0 w-full h-full object-cover" width="900" height="675" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section-tight">
    <div class="wrap max-w-3xl">
      <p class="kicker text-center mb-3">FAQ</p>
      <h2 class="display-lg text-center mb-10">Common questions</h2>
      <div class="space-y-0 border-t border-line">
        {faqItems.map((f) => (
          <details class="group border-b border-line py-5">
            <summary class="flex items-center justify-between cursor-pointer list-none font-medium text-ink text-lg">
              {f.q}
              <i class="ph-bold ph-plus text-accent transition-transform group-open:rotate-45 shrink-0 ml-4"></i>
            </summary>
            <p class="mt-4 body-sm pr-8">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-tight band-ink">
    <div class="wrap text-center max-w-xl mx-auto">
      <h2 class="display-lg mb-4">See what your site is leaking.</h2>
      <p class="lead mb-8">Free PULSE audit. Real numbers. No sales call required.</p>
      <a href="#audit" class="btn btn-accent btn-large">Get my free audit</a>
    </div>
  </section>
</Layout>

<style>
  .band-ink-form {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.12);
    box-shadow: none;
  }
  .band-ink-form .btn-primary {
    background: var(--color-ink-band-fg);
    color: var(--color-ink);
    border-color: var(--color-ink-band-fg);
  }
  .band-ink-form .btn-primary:hover {
    background: var(--color-accent-soft);
    border-color: var(--color-accent-soft);
    color: #fff;
  }
  .band-ink-form .text-ink-3 { color: var(--color-ink-band-muted); }
</style>
