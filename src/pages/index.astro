---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';

const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'What exactly is the VITAL audit?', acceptedAnswer: { '@type': 'Answer', text: 'A 5-dimension scoring system measuring Visibility, Impression, Transition, Automation, and Learning. Each dimension is scored 0-100 based on 50+ measurable checks.' } },
    { '@type': 'Question', name: 'How long until I see results?', acceptedAnswer: { '@type': 'Answer', text: 'Most clients see measurable movement in 30 days. Bigger lifts compound over 60-90 days.' } },
    { '@type': 'Question', name: 'What is the minimum commitment?', acceptedAnswer: { '@type': 'Answer', text: '3 months. After that, it is month-to-month. Most clients stay 9-18 months.' } },
    { '@type': 'Question', name: 'What if I am not happy after 30 days?', acceptedAnswer: { '@type': 'Answer', text: '30-day money-back guarantee. Full refund for that month, no questions.' } },
  ],
};
---

<Layout
  title="Happyranks — Marketing systems that grow revenue"
  description="A marketing system for businesses that want measurable revenue growth, not just traffic. Built around the VITAL framework. Free 90-second audit."
  active=""
  schema={faqSchema}
>
  <!-- ─── HERO ─── -->
  <Hero
    eyebrow="VITAL AUDIT — FREE, 90 SECONDS"
    title="Marketing systems that"
    highlight="actually grow revenue"
    description="The full marketing engine — visibility, conversion, automation, analytics — built around the VITAL framework. One audit. One plan. Measurable growth."
    primaryCta={{ label: 'Get my free VITAL audit', href: '/vital-audit', icon: 'ph-lightning' }}
    secondaryCta={{ label: 'See the work', href: '/work', icon: 'ph-arrow-up-right' }}
    meta={['No contract', '90-second report', 'AI-search ready', '30-day money-back']}
  />

  <!-- ─── VITAL PREVIEW STRIP ─── -->
  <section class="pb-12">
    <div class="container-wide">
      <div class="card p-6 lg:p-8 max-w-5xl mx-auto">
        <div class="flex items-center justify-between mb-6 flex-wrap gap-3">
          <div class="flex items-center gap-2">
            <div class="w-2 h-2 rounded-full bg-emerald-500 pulse-dot"></div>
            <span class="text-xs mono text-[#888]">vital.happyranks.com/live</span>
          </div>
          <div class="flex items-center gap-4">
            <div class="text-[10px] mono text-[#666] uppercase tracking-widest">Sample report</div>
            <div class="text-[10px] mono text-emerald-500">312 audits this month</div>
          </div>
        </div>
        <div class="grid md:grid-cols-[140px_1fr] gap-6 lg:gap-10 items-center">
          <div class="text-center md:text-left md:border-r md:border-[#1a1a1a] md:pr-8">
            <div class="text-[10px] mono text-[#666] uppercase tracking-widest mb-1">VITAL Score</div>
            <div class="text-5xl font-black text-white leading-none">62<span class="text-lg text-[#666] font-bold">/100</span></div>
            <div class="text-[11px] text-emerald-500 mono mt-2">+2.4x revenue if fixes ship</div>
          </div>
          <div class="space-y-2.5">
            {[
              { l: 'V', name: 'Visibility', s: 78 },
              { l: 'I', name: 'Impression', s: 71 },
              { l: 'T', name: 'Transition', s: 42 },
              { l: 'A', name: 'Automation', s: 38 },
              { l: 'L', name: 'Learning', s: 81 },
            ].map((d) => (
              <div class="grid grid-cols-[16px_88px_1fr_28px] items-center gap-3">
                <div class="text-xs font-black text-white mono">{d.l}</div>
                <div class="text-xs text-[#a8a8a8]">{d.name}</div>
                <div class="h-1.5 bg-[#1a1a1a] rounded-full overflow-hidden">
                  <div class="h-full bg-[var(--color-brand)] rounded-full" style={`width: ${d.s}%`}></div>
                </div>
                <div class="text-right text-xs mono text-white">{d.s}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── TRUST ─── -->
  <section class="border-y border-[#1a1a1a] bg-[#0a0a0a] py-10">
    <div class="container-wide">
      <div class="text-center eyebrow mb-6">Trusted by growth-focused teams</div>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-x-8 gap-y-4 items-center justify-items-center opacity-60">
        <span class="text-base font-bold tracking-tight text-white">Tutti Rouge</span>
        <span class="text-base font-serif italic text-white">Lotus Mahal</span>
        <span class="text-base font-bold text-white">THINK</span>
        <span class="text-base font-light tracking-widest text-white">VIRUKSHA</span>
        <span class="text-base font-bold text-white">efficy</span>
      </div>
    </div>
  </section>

  <!-- ─── THE FRAMEWORK (5 dimensions, tight grid) ─── -->
  <section class="section-y">
    <div class="container-wide">
      <div class="max-w-3xl mb-12">
        <div class="eyebrow mb-4">The VITAL framework</div>
        <h2 class="text-display-2 text-white mb-6">
          Five dimensions.<br/>
          <span class="text-gradient-light">One score.</span>
        </h2>
        <p class="text-lg text-[#a0a0a0] leading-relaxed">
          We measure your site across the five things that actually determine whether your
          marketing makes money. Each dimension is scored 0–100 based on 50+ measurable signals.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-5 gap-4">
        {[
          { letter: 'V', name: 'Visibility', desc: 'Can the right people find you — in Google, in ChatGPT, in Perplexity?', icon: 'ph-binoculars', score: 68 },
          { letter: 'I', name: 'Impression', desc: 'Do they trust you in 3 seconds? Speed, clarity, design quality.', icon: 'ph-eye', score: 74 },
          { letter: 'T', name: 'Transition', desc: 'Can they become a lead without friction? CTAs, forms, booking.', icon: 'ph-arrow-right', score: 42 },
          { letter: 'A', name: 'Automation', desc: 'What happens after they engage? Email, CRM, retargeting.', icon: 'ph-robot', score: 31 },
          { letter: 'L', name: 'Learning', desc: 'Do you measure what works? Analytics, conversion tracking.', icon: 'ph-chart-line-up', score: 58 },
        ].map((d) => (
          <div class="card card-hover p-6 flex flex-col h-full">
            <div class="flex items-center gap-3 mb-4">
              <i class={`ph-bold ${d.icon} text-2xl text-[var(--color-brand)]`}></i>
              <div class="text-xl font-black text-white">{d.letter}</div>
            </div>
            <div class="text-base font-bold text-white mb-2">{d.name}</div>
            <div class="text-xs text-[#888] leading-relaxed mb-5 flex-1">{d.desc}</div>
            <div class="h-1.5 bg-[#1a1a1a] rounded-full overflow-hidden">
              <div class="h-full bg-[var(--color-brand)] rounded-full" style={`width: ${d.score}%`}></div>
            </div>
            <div class="mt-2 text-[10px] mono text-[#666]">avg. client score: {d.score}/100</div>
          </div>
        ))}
      </div>

      <div class="mt-10 text-center">
        <a href="/vital-audit" class="inline-flex items-center gap-2 text-sm text-[var(--color-brand)] font-semibold hover:gap-3 transition-all">
          See how your site scores across all five <i class="ph-bold ph-arrow-right"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- ─── WHAT WE DO (3 pillars with images, kept tight) ─── -->
  <section class="section-y bg-[#0c0c0c]">
    <div class="container-wide">
      <div class="max-w-3xl mb-12">
        <div class="eyebrow mb-4">What we do</div>
        <h2 class="text-display-2 text-white mb-6">
          Not just traffic.<br/>
          <span class="text-gradient-brand">A revenue engine.</span>
        </h2>
      </div>

      <!-- Pillar 1 -->
      <div class="grid md:grid-cols-2 gap-12 items-center mb-20">
        <div>
          <div class="eyebrow mb-3 flex items-center gap-2">
            <span class="w-1 h-1 rounded-full bg-[var(--color-brand)]"></span>
            <span>01 — Visibility</span>
          </div>
          <h3 class="text-display-3 text-white mb-4">
            Get cited by ChatGPT, Perplexity, and Google AI
          </h3>
          <p class="text-[#a0a0a0] text-lg leading-relaxed mb-6">
            Traditional SEO isn't enough. In 2026, your customers are asking AI assistants
            which vendor to use. We engineer your site to be the one they reference.
          </p>
          <ul class="space-y-3 mb-8">
            {['Generative Engine Optimization (GEO)', 'Structured data & knowledge graphs', 'AI-overview citation tracking'].map((item) => (
              <li class="flex items-start gap-3 text-sm text-[#e5e5e5]">
                <i class="ph-bold ph-check text-[var(--color-brand)] text-base mt-0.5 shrink-0"></i>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <a href="/capabilities" class="inline-flex items-center gap-2 text-sm font-semibold text-white hover:gap-3 transition-all">
            Learn more about visibility <i class="ph-bold ph-arrow-right text-[var(--color-brand)]"></i>
          </a>
        </div>
        <div class="relative">
          <div class="relative rounded-2xl overflow-hidden border border-[#222] aspect-[4/3]">
            <img src="https://images.unsplash.com/photo-1677442136019-21780ecad995?w=1200&q=85" alt="AI search" class="w-full h-full object-cover" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-tr from-[#0a0a0a]/80 via-transparent to-transparent"></div>
          </div>
          <div class="absolute -bottom-6 -left-6 bg-[#141414] border border-[#2a2a2a] rounded-xl p-4 float shadow-2xl">
            <div class="text-[10px] mono text-[#666] mb-1">AI CITATIONS</div>
            <div class="text-2xl font-black text-white">+312%</div>
            <div class="text-xs text-emerald-500 mt-1 flex items-center gap-1">
              <i class="ph-bold ph-trend-up"></i> in 90 days
            </div>
          </div>
        </div>
      </div>

      <!-- Pillar 2 -->
      <div class="grid md:grid-cols-2 gap-12 items-center mb-20">
        <div class="order-2 md:order-1 relative">
          <div class="relative rounded-2xl overflow-hidden border border-[#222] aspect-[4/3]">
            <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=1200&q=85" alt="Analytics dashboard" class="w-full h-full object-cover" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-tl from-[#0a0a0a]/80 via-transparent to-transparent"></div>
          </div>
          <div class="absolute -top-6 -right-6 bg-[#141414] border border-[#2a2a2a] rounded-xl p-4 float shadow-2xl">
            <div class="text-[10px] mono text-[#666] mb-1">CONVERSION RATE</div>
            <div class="text-2xl font-black text-white">3.2% → 8.4%</div>
            <div class="text-xs text-emerald-500 mt-1">+161% in 60 days</div>
          </div>
        </div>
        <div class="order-1 md:order-2">
          <div class="eyebrow mb-3 flex items-center gap-2">
            <span class="w-1 h-1 rounded-full bg-[var(--color-brand)]"></span>
            <span>02 — Transition</span>
          </div>
          <h3 class="text-display-3 text-white mb-4">
            Turn visitors into qualified leads, predictably
          </h3>
          <p class="text-[#a0a0a0] text-lg leading-relaxed mb-6">
            Beautiful sites that don't convert are expensive decoration. We rebuild the path
            from "interested" to "booked call" with the psychology baked in.
          </p>
          <ul class="space-y-3 mb-8">
            {['Landing page architecture & copy', 'Lead magnet funnels', 'A/B test programs'].map((item) => (
              <li class="flex items-start gap-3 text-sm text-[#e5e5e5]">
                <i class="ph-bold ph-check text-[var(--color-brand)] text-base mt-0.5 shrink-0"></i>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <a href="/capabilities" class="inline-flex items-center gap-2 text-sm font-semibold text-white hover:gap-3 transition-all">
            Learn more about conversion <i class="ph-bold ph-arrow-right text-[var(--color-brand)]"></i>
          </a>
        </div>
      </div>

      <!-- Pillar 3 -->
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <div class="eyebrow mb-3 flex items-center gap-2">
            <span class="w-1 h-1 rounded-full bg-[var(--color-brand)]"></span>
            <span>03 — Automation + Learning</span>
          </div>
          <h3 class="text-display-3 text-white mb-4">
            A system that runs while you sleep — and shows you what worked
          </h3>
          <p class="text-[#a0a0a0] text-lg leading-relaxed mb-6">
            We wire up CRM, email, retargeting, and analytics so every visitor interaction
            is captured, nurtured, and attributed. No more "we think it's working."
          </p>
          <ul class="space-y-3 mb-8">
            {['Mautic / HubSpot CRM setup', 'Email nurture sequences', 'GA4 + conversion attribution'].map((item) => (
              <li class="flex items-start gap-3 text-sm text-[#e5e5e5]">
                <i class="ph-bold ph-check text-[var(--color-brand)] text-base mt-0.5 shrink-0"></i>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <a href="/capabilities" class="inline-flex items-center gap-2 text-sm font-semibold text-white hover:gap-3 transition-all">
            Learn more about automation <i class="ph-bold ph-arrow-right text-[var(--color-brand)]"></i>
          </a>
        </div>
        <div class="relative">
          <div class="relative rounded-2xl overflow-hidden border border-[#222] aspect-[4/3]">
            <img src="https://images.unsplash.com/photo-1518432031352-d6fc5c10da5a?w=1200&q=85" alt="Marketing automation" class="w-full h-full object-cover" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-tr from-[#0a0a0a]/80 via-transparent to-transparent"></div>
          </div>
          <div class="absolute -bottom-6 -right-6 bg-[#141414] border border-[#2a2a2a] rounded-xl p-4 float shadow-2xl">
            <div class="text-[10px] mono text-[#666] mb-1">TIME SAVED</div>
            <div class="text-2xl font-black text-white">14h/wk</div>
            <div class="text-xs text-emerald-500 mt-1">via automation</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── HOW IT WORKS (timeline) ─── -->
  <section class="section-y">
    <div class="container-wide">
      <div class="max-w-3xl mb-12">
        <div class="eyebrow mb-4">How it works</div>
        <h2 class="text-display-2 text-white mb-6">
          From audit to<br/>
          <span class="text-gradient-brand">revenue in 90 days</span>
        </h2>
      </div>

      <div class="max-w-3xl space-y-6">
        {[
          {
            step: '01',
            title: 'Free VITAL audit',
            time: 'Day 0 — 90 seconds',
            desc: 'Submit your URL. We score your site across all 5 dimensions and email you a 10-page PDF report within 2 minutes. No call required.',
            icon: 'ph-magnifying-glass',
          },
          {
            step: '02',
            title: 'Strategy call + plan',
            time: 'Week 1 — 45 min',
            desc: 'We walk through the findings, prioritize the highest-ROI fixes, and propose a 90-day plan. Transparent pricing, no surprises.',
            icon: 'ph-handshake',
          },
          {
            step: '03',
            title: 'Build, ship, measure',
            time: 'Days 14 — 90',
            desc: 'We build the system. You get weekly progress reports with real numbers. At day 90, we re-score with VITAL and show the delta.',
            icon: 'ph-rocket-launch',
          },
        ].map((s, i) => (
          <div class="relative">
            <div class="card card-hover p-8 grid md:grid-cols-[auto_1fr_auto] gap-6 items-center">
              <div class="text-5xl font-black text-[#222] mono">{s.step}</div>
              <div>
                <div class="flex items-center gap-3 mb-2">
                  <div class="w-9 h-9 rounded-lg bg-[#1a1a1a] border border-[#2a2a2a] flex items-center justify-center text-[var(--color-brand)]">
                    <i class={`ph-bold ${s.icon} text-lg`}></i>
                  </div>
                  <h3 class="text-xl font-bold text-white">{s.title}</h3>
                </div>
                <p class="text-[#a0a0a0] leading-relaxed">{s.desc}</p>
              </div>
              <div class="text-xs mono text-[#666] text-right whitespace-nowrap">{s.time}</div>
            </div>
            {i < 2 && (
              <div class="hidden md:block absolute left-12 top-full h-6 w-px bg-[#2a2a2a]"></div>
            )}
          </div>
        ))}
      </div>

      <div class="mt-12 text-center">
        <a href="/vital-audit" class="btn btn-primary btn-large">
          Start with a free audit
          <i class="ph-bold ph-arrow-right"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- ─── CASE STUDY (Tutti Rouge) ─── -->
  <section class="section-y bg-[#0c0c0c]">
    <div class="container-wide">
      <div class="eyebrow mb-4">Featured case study</div>
      <h2 class="text-display-2 text-white mb-12 max-w-2xl">
        Tutti Rouge — from invisible to <span class="text-gradient-brand">market leader</span> in fashion resale
      </h2>

      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="relative rounded-2xl overflow-hidden border border-[#222] aspect-[4/5]">
          <img src="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?w=1200&q=85" alt="Tutti Rouge fashion" class="w-full h-full object-cover" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a] via-transparent to-transparent"></div>
          <div class="absolute bottom-6 left-6 right-6">
            <div class="text-xs mono text-[#a0a0a0] mb-1">VITAL SCORE LIFT</div>
            <div class="text-4xl font-black text-white">42 → 78</div>
          </div>
        </div>
        <div>
          <div class="space-y-6 mb-8">
            {[
              { metric: '+187%', label: 'organic traffic in 6 months' },
              { metric: '4.2x', label: 'lead-to-customer conversion' },
              { metric: '£2.1M', label: 'attributed pipeline from organic' },
            ].map((m) => (
              <div class="border-b border-[#1a1a1a] pb-6 last:border-0">
                <div class="text-3xl font-black text-white mb-1">{m.metric}</div>
                <div class="text-sm text-[#888]">{m.label}</div>
              </div>
            ))}
          </div>
          <blockquote class="text-[#e5e5e5] text-lg leading-relaxed italic border-l-2 border-[var(--color-brand)] pl-4 mb-8">
            "Sanjeev's team rebuilt our entire acquisition engine. We're now showing up in
            AI search results ahead of brands 10x our size."
          </blockquote>
          <a href="/work/tutti-rouge" class="inline-flex items-center gap-2 text-sm font-semibold text-white hover:gap-3 transition-all">
            Read the full case study <i class="ph-bold ph-arrow-up-right text-[var(--color-brand)]"></i>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── TESTIMONIAL ─── -->
  <section class="section-y">
    <div class="container-wide">
      <div class="max-w-3xl mx-auto text-center">
        <div class="flex justify-center mb-6">
          <div class="flex -space-x-3">
            <div class="w-12 h-12 rounded-full bg-gradient-to-br from-purple-500 to-pink-500 border-2 border-[#0a0a0a]"></div>
            <div class="w-12 h-12 rounded-full bg-gradient-to-br from-emerald-500 to-cyan-500 border-2 border-[#0a0a0a]"></div>
            <div class="w-12 h-12 rounded-full bg-gradient-to-br from-orange-500 to-red-500 border-2 border-[#0a0a0a]"></div>
          </div>
        </div>
        <blockquote class="text-2xl md:text-3xl text-white font-medium leading-relaxed mb-8">
          "Working with Happyranks felt less like hiring an agency and more like adding a senior
          marketing leader to our team. They measure everything, ship fast, and the numbers show."
        </blockquote>
        <div class="text-sm">
          <div class="font-bold text-white">Mae Guzman</div>
          <div class="text-[#888]">Head of Growth, Efficy</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── FINAL CTA ─── -->
  <section class="section-y relative overflow-hidden">
    <div class="orb-red top-0 left-1/2 -translate-x-1/2"></div>
    <div class="container-wide relative">
      <div class="max-w-3xl mx-auto text-center">
        <div class="eyebrow mb-4">Ready when you are</div>
        <h2 class="text-display-1 text-white mb-6">
          Find out what<br/>
          <span class="text-gradient-brand">your site is leaking.</span>
        </h2>
        <p class="text-lg text-[#a0a0a0] mb-10 max-w-xl mx-auto">
          A free VITAL audit takes 90 seconds. No call required. If we find something interesting,
          we'll show you what fixing it looks like.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-4">
          <a href="/vital-audit" class="btn btn-primary btn-large">
            <i class="ph-bold ph-lightning"></i>
            Get my free VITAL audit
          </a>
        </div>
        <div class="mt-8 text-xs text-[#666] mono">
          <i class="ph-bold ph-shield-check text-emerald-500"></i>
          No credit card · 90 seconds · Yours to keep
        </div>
      </div>
    </div>
  </section>
</Layout>
