---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';

const {
  title = 'Happyranks — Marketing systems that grow revenue',
  description = 'The marketing system for businesses that want measurable growth. Free PULSE breakdown, transparent pricing, and a framework that moves numbers.',
  active = '',
  ogImage = '/og-default.png',
  schema = null,
  noStickyCta = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = ogImage.startsWith('http') ? ogImage : new URL(ogImage, Astro.site).href;

const defaultSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Happyranks',
  url: 'https://happyranks.com',
  logo: 'https://happyranks.com/favicon.svg',
  description: 'Marketing systems for businesses that want measurable revenue growth. Built around the PULSE framework.',
  founder: { '@type': 'Person', name: 'Sanjeev' },
  address: { '@type': 'PostalAddress', addressLocality: 'Coimbatore', addressCountry: 'IN' },
  areaServed: ['US', 'GB', 'AE', 'IN'],
  knowsAbout: ['Marketing', 'SEO', 'Generative Engine Optimization', 'Conversion Rate Optimization', 'Marketing Automation', 'Analytics'],
};
const allSchemas = schema ? [defaultSchema, ...(Array.isArray(schema) ? schema : [schema])] : [defaultSchema];

const showStickyCta = !noStickyCta && (active === '' || active === '/pulse-audit');
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN || 'happyranks.com';
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageURL} />
    <script defer data-domain={plausibleDomain} src="https://plausible.io/js/script.js"></script>
    {allSchemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
    <slot name="head" />
  </head>
  <body>
    <Header active={active} />
    <main>
      <slot />
    </main>
    <Footer />
    {showStickyCta && <StickyCta />}
  </body>
</html>
