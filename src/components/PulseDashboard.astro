---
const dimensions = [
  { l: 'P', name: 'Presence', s: 78, color: '#635bff' },
  { l: 'U', name: 'Understanding', s: 71, color: '#00d4ff' },
  { l: 'L', name: 'Lead capture', s: 42, color: '#ff3131' },
  { l: 'S', name: 'Sales follow-up', s: 38, color: '#09825d' },
  { l: 'E', name: 'Evaluation', s: 81, color: '#f5a623' },
];
---

<div class="dashboard-shell float">
  <div class="dashboard-chrome">
    <span class="dashboard-dot bg-[#ff5f57]"></span>
    <span class="dashboard-dot bg-[#febc2e]"></span>
    <span class="dashboard-dot bg-[#28c840]"></span>
    <span class="ml-2 text-xs mono text-fg-muted truncate">pulse.happyranks.com/live</span>
    <span class="ml-auto flex items-center gap-1.5 text-[10px] mono text-success">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 pulse-dot"></span>
      312 audits this month
    </span>
  </div>
  <div class="dashboard-body">
    <div class="grid lg:grid-cols-[minmax(0,140px)_1fr] gap-6 items-center">
      <div class="text-center lg:text-left lg:border-r border-border lg:pr-6">
        <div class="eyebrow mb-2">PULSE Score</div>
        <div class="stat-tile-value">62<span class="text-lg text-fg-muted font-semibold">/100</span></div>
        <div class="text-xs mono text-success mt-2 font-medium">+2.4x revenue if fixes ship</div>
      </div>
      <div class="space-y-3">
        {dimensions.map((d) => (
          <div class="grid grid-cols-[20px_1fr_36px] sm:grid-cols-[20px_100px_1fr_36px] items-center gap-3">
            <span class="text-xs font-bold text-fg mono">{d.l}</span>
            <span class="hidden sm:block text-xs text-fg-secondary truncate">{d.name}</span>
            <div class="progress-track col-span-1 sm:col-span-1">
              <div class="progress-fill h-full" style={`width: ${d.s}%; background: linear-gradient(90deg, ${d.color}, ${d.color}cc)`}></div>
            </div>
            <span class="text-right text-xs mono font-semibold text-fg">{d.s}</span>
          </div>
        ))}
      </div>
    </div>
    <div class="mt-5 pt-4 border-t border-border grid grid-cols-3 gap-3">
      <div class="text-center">
        <div class="text-lg font-bold text-fg">50+</div>
        <div class="text-[10px] mono text-fg-muted uppercase tracking-wide">Checks</div>
      </div>
      <div class="text-center">
        <div class="text-lg font-bold text-fg">90s</div>
        <div class="text-[10px] mono text-fg-muted uppercase tracking-wide">Runtime</div>
      </div>
      <div class="text-center">
        <div class="text-lg font-bold text-fg">10pg</div>
        <div class="text-[10px] mono text-fg-muted uppercase tracking-wide">PDF report</div>
      </div>
    </div>
  </div>
</div>
