---
const dimensions = [
  { l: 'P', name: 'Presence', s: 78 },
  { l: 'U', name: 'Understanding', s: 71 },
  { l: 'L', name: 'Lead capture', s: 42 },
  { l: 'S', name: 'Sales follow-up', s: 38 },
  { l: 'E', name: 'Evaluation', s: 81 },
];
---

<div class="dashboard-shell">
  <div class="dashboard-header mono text-fg-muted">
    <span>pulse.happyranks.com</span>
    <span class="flex items-center gap-1.5 text-success">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 pulse-dot"></span>
      live
    </span>
  </div>
  <div class="dashboard-body">
    <div class="grid lg:grid-cols-[minmax(0,130px)_1fr] gap-8 items-start">
      <div>
        <div class="eyebrow mb-2">Score</div>
        <div class="stat-tile-value">62<span class="text-base text-fg-muted font-medium">/100</span></div>
        <p class="text-xs text-success mono mt-2">+2.4x est. revenue lift</p>
      </div>
      <div class="space-y-3.5">
        {dimensions.map((d) => (
          <div class="grid grid-cols-[18px_1fr_32px] sm:grid-cols-[18px_110px_1fr_32px] items-center gap-3">
            <span class="text-xs font-semibold text-fg mono">{d.l}</span>
            <span class="hidden sm:block text-xs text-fg-secondary truncate">{d.name}</span>
            <div class="progress-track">
              <div class="progress-fill" style={`width: ${d.s}%`}></div>
            </div>
            <span class="text-right text-xs mono text-fg-muted">{d.s}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>
