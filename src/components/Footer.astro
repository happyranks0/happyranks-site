---
const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-canvas-2">
  <div class="wrap section-tight">
    <div class="grid lg:grid-cols-[1.5fr_1fr_1fr] gap-12 pb-12">
      <div>
        <a href="/" class="header-mark mb-6">
          <span class="header-logo">H</span>
          <span class="header-name">Happyranks</span>
        </a>
        <p class="lead max-w-sm mb-4 serif text-[1.25rem] leading-snug">
          Marketing systems measured on PULSE — shipped in 90 days.
        </p>
        <p class="text-sm text-ink-2 mb-6">
          <a href="mailto:hello@happyranks.com" class="hover:text-ink underline-offset-2 hover:underline">hello@happyranks.com</a>
          <span class="mx-2 text-ink-3">·</span>
          <a href="tel:+918248816834" class="hover:text-ink underline-offset-2 hover:underline">+91 82488 16834</a>
        </p>
        <a href="/pulse-audit" class="btn btn-primary">Free PULSE audit</a>
      </div>

      <div>
        <p class="kicker mb-4">Explore</p>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/capabilities" class="text-ink-2 hover:text-ink">Capabilities</a></li>
          <li><a href="/work" class="text-ink-2 hover:text-ink">Case studies</a></li>
          <li><a href="/pricing" class="text-ink-2 hover:text-ink">Pricing</a></li>
          <li><a href="/contact" class="text-ink-2 hover:text-ink">Contact</a></li>
        </ul>
      </div>

      <div>
        <p class="kicker mb-4">Connect</p>
        <ul class="space-y-2.5 text-sm">
          <li><a href="https://www.linkedin.com/in/sanjeev/" class="text-ink-2 hover:text-ink" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
          <li><a href="https://twitter.com/happyranks" class="text-ink-2 hover:text-ink" target="_blank" rel="noopener noreferrer">X / Twitter</a></li>
        </ul>
      </div>
    </div>

    <div class="rule mb-6"></div>
    <div class="flex flex-col sm:flex-row justify-between gap-4 text-xs text-ink-3">
      <span>© {year} Happyranks</span>
      <div class="flex gap-6">
        <a href="/privacy" class="hover:text-ink">Privacy</a>
        <a href="/terms" class="hover:text-ink">Terms</a>
      </div>
    </div>
  </div>
</footer>
