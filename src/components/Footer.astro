---
const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-bg-subtle mt-24">
  <div class="container-wide py-16">
    <div class="grid md:grid-cols-4 gap-12">
      <div class="md:col-span-2">
        <a href="/" class="flex items-center gap-2 mb-4">
          <div class="w-8 h-8 rounded-lg bg-[var(--color-brand)] flex items-center justify-center font-black text-fg text-sm">H</div>
          <span class="font-semibold text-fg tracking-tight">Happyranks</span>
        </a>
        <p class="text-sm text-fg-secondary max-w-md leading-relaxed">
          The marketing system for businesses that want measurable growth — not just traffic. Built around the PULSE audit framework.
        </p>
        <div class="flex items-center gap-2 mt-6 text-xs text-fg-muted mono">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 pulse-dot"></span>
          <span>All systems operational</span>
        </div>
      </div>
      <div>
        <div class="eyebrow mb-4">Capabilities</div>
        <ul class="space-y-2 text-sm text-fg-secondary">
          <li><a href="/capabilities" class="hover:text-fg transition-colors">Presence (SEO & GEO)</a></li>
          <li><a href="/capabilities" class="hover:text-fg transition-colors">Understanding (Brand & Web)</a></li>
          <li><a href="/capabilities" class="hover:text-fg transition-colors">Lead capture (Conversion)</a></li>
          <li><a href="/capabilities" class="hover:text-fg transition-colors">Sales follow-up (CRM & Email)</a></li>
          <li><a href="/capabilities" class="hover:text-fg transition-colors">Evaluation (Analytics)</a></li>
        </ul>
      </div>
      <div>
        <div class="eyebrow mb-4">Company</div>
        <ul class="space-y-2 text-sm text-fg-secondary">
          <li><a href="/work" class="hover:text-fg transition-colors">Case studies</a></li>
          <li><a href="/pricing" class="hover:text-fg transition-colors">Pricing</a></li>
          <li><a href="/pulse-audit" class="hover:text-fg transition-colors">Free PULSE Audit</a></li>
          <li><a href="/about" class="hover:text-fg transition-colors">About</a></li>
          <li><a href="/contact" class="hover:text-fg transition-colors">Contact</a></li>
        </ul>
      </div>
    </div>
    <div class="border-t border-border mt-12 pt-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 text-xs text-fg-muted">
      <div>© {year} Happyranks. All rights reserved.</div>
      <div class="flex items-center gap-6">
        <a href="/privacy" class="hover:text-fg transition-colors">Privacy</a>
        <a href="/terms" class="hover:text-fg transition-colors">Terms</a>
        <span class="mono">v2026.08</span>
      </div>
    </div>
  </div>
</footer>
