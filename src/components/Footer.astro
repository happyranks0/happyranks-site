---
import FooterBlock from '@/components/blocks/footer-1.astro';

const year = new Date().getFullYear();
---

<FooterBlock
  brandName="Happyranks"
  brandHref="/"
  description="Marketing systems measured on PULSE — findability, conversion, nurture, and attribution for growth teams."
  columns={[
    {
      title: 'Product',
      links: [
        { label: 'Capabilities', href: '/capabilities' },
        { label: 'Free audit', href: '/pulse-audit' },
        { label: 'Pricing', href: '/pricing' },
      ],
    },
    {
      title: 'Company',
      links: [
        { label: 'Case studies', href: '/work' },
        { label: 'About', href: '/about' },
        { label: 'Contact', href: '/contact' },
      ],
    },
    {
      title: 'Legal',
      links: [
        { label: 'Privacy', href: '/privacy' },
        { label: 'Terms', href: '/terms' },
        { label: 'hello@happyranks.com', href: 'mailto:hello@happyranks.com' },
      ],
    },
  ]}
  copyright={`© ${year} Happyranks. All rights reserved.`}
  class="border-t border-white/5 bg-base-200/50"
/>
