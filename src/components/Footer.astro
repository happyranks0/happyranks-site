---
const year = new Date().getFullYear();
---

<footer class="border-t border-[#1a1a1a] bg-[#0a0a0a] mt-24">
  <div class="container-wide py-16">
    <div class="grid md:grid-cols-4 gap-12">
      <div class="md:col-span-2">
        <a href="/" class="flex items-center gap-2 mb-4">
          <div class="w-8 h-8 rounded-lg bg-[var(--color-brand)] flex items-center justify-center font-black text-white text-sm">H</div>
          <span class="font-bold text-white tracking-tight">Happyranks</span>
        </a>
        <p class="text-sm text-[#888] max-w-md leading-relaxed">
          The marketing system for businesses that want measurable growth — not just traffic. Built around the PULSE audit framework.
        </p>
        <div class="flex items-center gap-2 mt-6 text-xs text-[#666] mono">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 pulse-dot"></span>
          <span>All systems operational</span>
        </div>
      </div>
      <div>
        <div class="eyebrow mb-4">Capabilities</div>
        <ul class="space-y-2 text-sm text-[#a0a0a0]">
          <li><a href="/capabilities" class="hover:text-white">Presence (SEO & GEO)</a></li>
          <li><a href="/capabilities" class="hover:text-white">Understanding (Brand & Web)</a></li>
          <li><a href="/capabilities" class="hover:text-white">Lead capture (Conversion)</a></li>
          <li><a href="/capabilities" class="hover:text-white">Sales follow-up (CRM & Email)</a></li>
          <li><a href="/capabilities" class="hover:text-white">Evaluation (Analytics)</a></li>
        </ul>
      </div>
      <div>
        <div class="eyebrow mb-4">Company</div>
        <ul class="space-y-2 text-sm text-[#a0a0a0]">
          <li><a href="/work" class="hover:text-white">Case studies</a></li>
          <li><a href="/pricing" class="hover:text-white">Pricing</a></li>
          <li><a href="/pulse-audit" class="hover:text-white">Free PULSE Audit</a></li>
          <li><a href="/about" class="hover:text-white">About</a></li>
          <li><a href="/contact" class="hover:text-white">Contact</a></li>
        </ul>
      </div>
    </div>
    <div class="border-t border-[#1a1a1a] mt-12 pt-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 text-xs text-[#666]">
      <div>© {year} Happyranks. All rights reserved.</div>
      <div class="flex items-center gap-6">
        <a href="/privacy" class="hover:text-white">Privacy</a>
        <a href="/terms" class="hover:text-white">Terms</a>
        <span class="mono">v2026.07</span>
      </div>
    </div>
  </div>
</footer>
