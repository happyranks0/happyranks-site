---
const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-bg-subtle mt-0">
  <div class="container-wide py-14">
    <div class="grid md:grid-cols-4 gap-10">
      <div class="md:col-span-2">
        <a href="/" class="flex items-center gap-2 mb-4">
          <div class="w-8 h-8 rounded-lg bg-[var(--color-brand)] flex items-center justify-center font-black text-white text-sm">H</div>
          <span class="font-semibold text-fg tracking-tight">Happyranks</span>
        </a>
        <p class="text-sm text-fg-secondary max-w-sm leading-relaxed">
          Marketing systems for businesses that want measurable growth. Built on the PULSE framework.
        </p>
      </div>
      <div>
        <div class="eyebrow mb-3">Capabilities</div>
        <ul class="space-y-2 text-sm text-fg-secondary">
          <li><a href="/capabilities" class="hover:text-fg transition-colors">Presence</a></li>
          <li><a href="/capabilities" class="hover:text-fg transition-colors">Understanding</a></li>
          <li><a href="/capabilities" class="hover:text-fg transition-colors">Lead capture</a></li>
          <li><a href="/capabilities" class="hover:text-fg transition-colors">Sales follow-up</a></li>
          <li><a href="/capabilities" class="hover:text-fg transition-colors">Evaluation</a></li>
        </ul>
      </div>
      <div>
        <div class="eyebrow mb-3">Company</div>
        <ul class="space-y-2 text-sm text-fg-secondary">
          <li><a href="/work" class="hover:text-fg transition-colors">Work</a></li>
          <li><a href="/pricing" class="hover:text-fg transition-colors">Pricing</a></li>
          <li><a href="/pulse-audit" class="hover:text-fg transition-colors">Free PULSE audit</a></li>
          <li><a href="/contact" class="hover:text-fg transition-colors">Contact</a></li>
        </ul>
      </div>
    </div>
    <div class="border-t border-border mt-10 pt-6 flex flex-col md:flex-row justify-between gap-4 text-xs text-fg-muted">
      <span>© {year} Happyranks</span>
      <div class="flex gap-6">
        <a href="/privacy" class="hover:text-fg transition-colors">Privacy</a>
        <a href="/terms" class="hover:text-fg transition-colors">Terms</a>
      </div>
    </div>
  </div>
</footer>
