---
import { Button } from '@/components/ui/button';

const { label = 'Free PULSE audit · 90 seconds', href = '/pulse-audit' } = Astro.props;
---

<div
  id="sticky-cta"
  class="fixed bottom-5 left-1/2 z-40 hidden -translate-x-1/2"
  aria-hidden="true"
>
  <div class="glass-panel flex items-center gap-3 px-2 py-2 pl-4 shadow-2xl">
    <span class="hidden text-sm text-base-content/70 whitespace-nowrap sm:inline">{label}</span>
    <Button as="a" href={href} size="sm">
      Get free audit
      <i class="ph-bold ph-lightning"></i>
    </Button>
  </div>
</div>

<script>
  const bar = document.getElementById('sticky-cta');
  const threshold = 480;

  function toggleSticky() {
    if (!bar) return;
    const show = window.scrollY > threshold;
    bar.classList.toggle('hidden', !show);
    bar.setAttribute('aria-hidden', show ? 'false' : 'true');
  }

  toggleSticky();
  window.addEventListener('scroll', toggleSticky, { passive: true });
</script>
