---
const dimensions = [
  { l: 'P', name: 'Presence', s: 78 },
  { l: 'U', name: 'Understanding', s: 71 },
  { l: 'L', name: 'Lead capture', s: 42 },
  { l: 'S', name: 'Sales follow-up', s: 38 },
  { l: 'E', name: 'Evaluation', s: 81 },
];
---

<div class="scorecard" aria-label="Sample PULSE score">
  <div class="scorecard-header">
    <div>
      <p class="kicker mb-2">Sample report</p>
      <div class="scorecard-total">62<span>/100</span></div>
    </div>
    <div class="scorecard-meta">
      <span>Est. revenue lift</span>
      <strong>+2.4×</strong>
      <span>if fixes ship in 90 days</span>
    </div>
  </div>
  <div class="scorecard-rows">
    {dimensions.map((d) => (
      <div class="scorecard-row">
        <span class="scorecard-letter">{d.l}</span>
        <div>
          <div class="text-sm font-medium text-ink mb-2">{d.name}</div>
          <div class="scorecard-bar">
            <div class="scorecard-bar-fill" style={`width: ${d.s}%`}></div>
          </div>
        </div>
        <span class="scorecard-val">{d.s}</span>
      </div>
    ))}
  </div>
</div>
