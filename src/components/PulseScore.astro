---
const dimensions = [
  { l: 'P', name: 'Presence', s: 78 },
  { l: 'U', name: 'Understanding', s: 71 },
  { l: 'L', name: 'Lead capture', s: 42 },
  { l: 'S', name: 'Sales follow-up', s: 38 },
  { l: 'E', name: 'Evaluation', s: 81 },
];
---

<div class="card bg-base-200/90 border border-white/10 shadow-2xl glow-ring overflow-hidden">
  <div class="flex items-center justify-between border-b border-white/10 bg-base-300/50 px-4 py-3 text-xs text-base-content/60">
    <span class="flex items-center gap-2 font-mono">
      <span class="size-2 rounded-full bg-success animate-pulse"></span>
      pulse.happyranks.com
    </span>
    <span class="font-mono uppercase tracking-wider">Live scan</span>
  </div>

  <div class="flex items-end justify-between gap-4 border-b border-white/10 p-6">
    <div>
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.14em] text-primary/80">PULSE score</p>
      <div class="font-display text-6xl font-bold leading-none tracking-tight">
        62<span class="text-2xl font-medium text-base-content/40">/100</span>
      </div>
    </div>
    <div class="text-right text-xs text-base-content/60">
      <span class="block">Est. revenue lift</span>
      <strong class="block text-2xl font-bold text-primary">+2.4×</strong>
      <span>90-day fixes</span>
    </div>
  </div>

  <div class="divide-y divide-white/5">
    {dimensions.map((d) => (
      <div class="grid grid-cols-[1.5rem_1fr_2.5rem] items-center gap-3 px-6 py-3 text-sm">
        <span class="font-bold text-primary">{d.l}</span>
        <div>
          <div class="mb-1.5 truncate text-base-content/80">{d.name}</div>
          <progress class="progress progress-primary h-1.5 w-full" value={d.s} max="100"></progress>
        </div>
        <span class="text-right font-mono text-base-content/70">{d.s}</span>
      </div>
    ))}
  </div>
</div>
