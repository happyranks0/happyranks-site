---
const dimensions = [
  { l: 'P', name: 'Presence', s: 78, x: '8%', y: '12%' },
  { l: 'U', name: 'Understanding', s: 71, x: '72%', y: '8%' },
  { l: 'L', name: 'Lead capture', s: 42, x: '78%', y: '58%' },
  { l: 'S', name: 'Sales follow-up', s: 38, x: '12%', y: '68%' },
  { l: 'E', name: 'Evaluation', s: 81, x: '48%', y: '78%' },
];
---

<div class="score-cluster" aria-hidden="true">
  <div class="score-orb score-orb-main">
    <span class="score-num">62</span>
    <span class="score-label">PULSE score</span>
  </div>
  {dimensions.map((d) => (
    <div class="score-chip" style={`left: ${d.x}; top: ${d.y};`}>
      <span class="score-chip-letter">{d.l}</span>
      <span class="text-ink-3 hidden sm:inline">{d.name}</span>
      <span class="score-chip-val">{d.s}</span>
    </div>
  ))}
</div>
