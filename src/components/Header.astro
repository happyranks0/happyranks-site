---
import { Button } from '@/components/ui/button';
import { Header as SiteHeader, HeaderContainer, HeaderGroup } from '@/components/ui/header';
import { Icon } from '@/components/ui/icon';
import { Logo, LogoText } from '@/components/ui/logo';
import {
  NavigationMenu,
  NavigationMenuItem,
  NavigationMenuLink,
  NavigationMenuList,
} from '@/components/ui/navigation-menu';
import {
  Sheet,
  SheetClose,
  SheetContent,
  SheetDescription,
  SheetHeader,
  SheetTitle,
  SheetTrigger,
} from '@/components/ui/sheet';

const { active = '' } = Astro.props;

const links = [
  { href: '/capabilities', label: 'Capabilities' },
  { href: '/work', label: 'Work' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/about', label: 'About' },
];

const auditFocus = active === '' || active === '/pulse-audit';
---

<SiteHeader class="fixed top-0 z-50 border-b border-white/5 bg-base-100/80 backdrop-blur-xl">
  <HeaderContainer class="site-shell !max-w-7xl items-center justify-between gap-4 py-3">
    <HeaderGroup>
      <Logo href="/" class="gap-2.5">
        <span class="flex size-9 items-center justify-center rounded-xl bg-primary text-sm font-extrabold text-primary-content glow-ring">H</span>
        <LogoText class="font-display text-base font-bold tracking-tight">Happyranks</LogoText>
      </Logo>
    </HeaderGroup>

    <NavigationMenu class="hidden flex-none lg:flex">
      <NavigationMenuList>
        {links.map((link, index) => (
          <NavigationMenuItem value={`nav-${index}`}>
            <NavigationMenuLink href={link.href} active={active === link.href}>
              {link.label}
            </NavigationMenuLink>
          </NavigationMenuItem>
        ))}
      </NavigationMenuList>
    </NavigationMenu>

    <HeaderGroup class="ml-auto hidden flex-1 justify-end gap-2 lg:flex">
      {auditFocus ? (
        <>
          <Button as="a" href="/contact" variant="ghost" size="sm">Book a call</Button>
          <Button as="a" href="/pulse-audit" size="sm">
            Free audit
            <Icon name="zap" class="size-4" />
          </Button>
        </>
      ) : (
        <>
          <Button as="a" href="/pulse-audit" variant="ghost" size="sm">Free audit</Button>
          <Button as="a" href="/contact" size="sm">
            Book a call
            <Icon name="arrow-up-right" class="size-4" />
          </Button>
        </>
      )}
    </HeaderGroup>

    <Sheet class="lg:hidden">
      <SheetTrigger variant="ghost" size="icon-sm" class="ml-auto" aria-label="Open menu">
        <Icon name="menu" />
      </SheetTrigger>
      <SheetContent side="right" class="border-white/10 bg-base-200 p-0">
        <SheetHeader class="sr-only">
          <SheetTitle>Menu</SheetTitle>
          <SheetDescription>Site navigation and actions.</SheetDescription>
        </SheetHeader>
        <div class="flex h-full flex-col gap-6 px-5 py-10">
          <Logo href="/" class="gap-2.5">
            <span class="flex size-9 items-center justify-center rounded-xl bg-primary text-sm font-extrabold text-primary-content">H</span>
            <LogoText class="font-display font-bold">Happyranks</LogoText>
          </Logo>
          <nav aria-label="Mobile navigation" class="flex flex-col gap-1">
            {links.map((link) => (
              <a
                href={link.href}
                class:list={[
                  'rounded-xl px-3 py-3 text-lg font-medium transition-colors',
                  active === link.href ? 'bg-primary/10 text-primary' : 'text-base-content/80 hover:bg-base-300',
                ]}
              >
                {link.label}
              </a>
            ))}
            <a href="/pulse-audit" class="rounded-xl px-3 py-3 text-lg font-medium text-base-content/80 hover:bg-base-300">
              Free PULSE audit
            </a>
          </nav>
          <div class="mt-auto flex flex-col gap-2">
            {auditFocus ? (
              <>
                <Button as="a" href="/pulse-audit" size="lg" class="w-full">Get free audit</Button>
                <Button as="a" href="/contact" variant="outline" size="lg" class="w-full">Book a call</Button>
              </>
            ) : (
              <>
                <Button as="a" href="/contact" size="lg" class="w-full">Book a call</Button>
                <Button as="a" href="/pulse-audit" variant="outline" size="lg" class="w-full">Get free audit</Button>
              </>
            )}
          </div>
        </div>
      </SheetContent>
    </Sheet>
  </HeaderContainer>
</SiteHeader>
