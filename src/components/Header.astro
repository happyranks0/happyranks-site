---
const { active = '' } = Astro.props;
const links = [
  { href: '/capabilities', label: 'Capabilities' },
  { href: '/work', label: 'Work' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/about', label: 'About' },
];

const auditFocus = active === '' || active === '/pulse-audit';
---

<header class="site-header" id="site-header">
  <div class="wrap header-inner">
    <a href="/" class="header-mark" aria-label="Happyranks home">
      <span class="header-logo">H</span>
      <span class="header-name">Happyranks</span>
    </a>

    <nav class="nav-desktop hidden md:flex" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} class:list={[active === l.href && 'is-active']}>{l.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      {auditFocus ? (
        <>
          <a href="/contact" class="hidden sm:inline-flex btn btn-ghost text-[13px]">Book a call</a>
          <a href="/pulse-audit" class="hidden sm:inline-flex btn btn-primary text-[13px]">
            Free audit
            <i class="ph-bold ph-lightning"></i>
          </a>
        </>
      ) : (
        <>
          <a href="/pulse-audit" class="hidden sm:inline-flex btn btn-text text-[13px]">Free audit</a>
          <a href="/contact" class="hidden sm:inline-flex btn btn-primary text-[13px]">
            Book a call
            <i class="ph-bold ph-arrow-up-right"></i>
          </a>
        </>
      )}
      <button
        type="button"
        class="mobile-trigger md:hidden w-10 h-10 flex items-center justify-center text-ink border border-line rounded-sm"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <i class="ph-bold ph-list text-xl"></i>
      </button>
    </div>
  </div>
</header>

<div id="mobile-menu" class="mobile-menu" aria-hidden="true">
  <div class="mobile-menu__backdrop" data-close></div>
  <aside class="mobile-menu__panel" role="dialog" aria-modal="true" aria-label="Site navigation">
    <div class="flex items-center justify-between h-16 px-5 border-b border-line">
      <a href="/" class="header-mark" data-close>
        <span class="header-logo">H</span>
        <span class="header-name">Happyranks</span>
      </a>
      <button type="button" class="w-10 h-10 flex items-center justify-center border border-line rounded-sm" aria-label="Close menu" data-close>
        <i class="ph-bold ph-x text-xl"></i>
      </button>
    </div>
    <nav class="px-5 py-6 flex flex-col gap-1" aria-label="Mobile">
      {links.map((l) => (
        <a href={l.href} data-close class:list={['py-3.5 text-[17px] font-medium border-b border-line', active === l.href ? 'text-ink' : 'text-ink-2']}>
          {l.label}
        </a>
      ))}
      <a href="/pulse-audit" data-close class="py-3.5 text-[17px] font-medium text-ink-2 border-b border-line">Free PULSE audit</a>
    </nav>
    <div class="px-5 pt-4 pb-8 flex flex-col gap-3">
      {auditFocus ? (
        <>
          <a href="/pulse-audit" data-close class="btn btn-primary btn-large w-full justify-center">Get free audit</a>
          <a href="/contact" data-close class="btn btn-ghost btn-large w-full justify-center">Book a call</a>
        </>
      ) : (
        <>
          <a href="/contact" data-close class="btn btn-primary btn-large w-full justify-center">Book a call</a>
          <a href="/pulse-audit" data-close class="btn btn-ghost btn-large w-full justify-center">Get free audit</a>
        </>
      )}
    </div>
  </aside>
</div>

<script>
  const header = document.getElementById('site-header');
  const trigger = document.querySelector<HTMLButtonElement>('.mobile-trigger');
  const menu = document.getElementById('mobile-menu');
  const closeButtons = document.querySelectorAll<HTMLElement>('[data-close]');

  function onScroll() {
    if (!header) return;
    header.classList.toggle('is-scrolled', window.scrollY > 8);
  }
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  function openMenu() {
    if (!menu || !trigger) return;
    menu.classList.add('is-open');
    menu.setAttribute('aria-hidden', 'false');
    trigger.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    if (!menu || !trigger) return;
    menu.classList.remove('is-open');
    menu.setAttribute('aria-hidden', 'true');
    trigger.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  trigger?.addEventListener('click', openMenu);
  closeButtons.forEach((btn) => btn.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });
</script>
