---
import PageHeader from './PageHeader.astro';

const {
  eyebrow = '',
  title = '',
  highlight = '',
  description = '',
  primaryCta = null,
  secondaryCta = null,
  meta = null,
  align = 'left',
  compact = false,
} = Astro.props;
---

<PageHeader
  kicker={eyebrow}
  title={title}
  highlight={highlight}
  description={description}
  primaryCta={primaryCta}
  secondaryCta={secondaryCta}
  meta={meta}
  align={align}
  compact={compact}
/>
