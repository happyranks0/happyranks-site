---
const {
  formId = 'pulse-audit-form',
  compact = false,
  showTitle = true,
} = Astro.props;
---

<div class="pulse-audit-form-wrap">
  {showTitle && (
    <div class="mb-5">
      <p class="kicker mb-2">Free PULSE audit</p>
      <h2 class="display-md mb-2">URL + email → report in 2 min</h2>
      <p class="body-sm">50+ checks across five revenue dimensions.</p>
    </div>
  )}

  <form
    id={formId}
    class:list={['space-y-4', compact && 'space-y-3']}
    data-pulse-audit-form
  >
    <div>
      <label for={`${formId}-url`} class="block text-sm font-medium text-ink mb-2">Website URL</label>
      <input
        type="url"
        id={`${formId}-url`}
        name="url"
        required
        placeholder="https://yoursite.com"
        class="input-field"
      />
    </div>
    <div>
      <label for={`${formId}-email`} class="block text-sm font-medium text-ink mb-2">Email</label>
      <input
        type="email"
        id={`${formId}-email`}
        name="email"
        required
        placeholder="you@company.com"
        class="input-field"
      />
    </div>
    <button type="submit" class:list={['btn btn-primary w-full justify-center', compact ? '' : 'btn-large']}>
      <i class="ph-bold ph-lightning"></i>
      Run my free PULSE audit
    </button>
    <p class="text-[11px] text-ink-3 text-center leading-relaxed">
      No credit card. PDF in ~2 minutes.
    </p>
  </form>

  <div id={`${formId}-error`} class="hidden mt-4 p-4 rounded-xl border border-accent/40 bg-accent/10 text-sm text-ink-2" role="alert"></div>

  <div id={`${formId}-success`} class="hidden mt-4 p-5 rounded-xl bg-ok-bg border border-ok/30">
    <div class="flex items-center gap-2 text-ok font-semibold mb-2">
      <i class="ph-bold ph-check-circle"></i>
      Audit queued
    </div>
    <p class="body-sm">Your report is on its way — check your inbox in the next 2 minutes.</p>
  </div>
</div>

<script define:vars={{ formId }}>
  const form = document.getElementById(formId);
  const success = document.getElementById(`${formId}-success`);
  const errorBox = document.getElementById(`${formId}-error`);

  async function submitAudit(url, email) {
    const endpoints = ['/api/pulse/scan', 'https://vital.gohappyranks.com/api/vital/scan'];
    let lastError = null;

    for (const endpoint of endpoints) {
      try {
        const resp = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ url, email }),
        });
        if (resp.ok) return true;
        if (endpoint === '/api/pulse/scan' && resp.status === 404) continue;
        const text = await resp.text();
        lastError = text || `HTTP ${resp.status}`;
      } catch (err) {
        lastError = err instanceof Error ? err.message : 'Network error';
        if (endpoint === '/api/pulse/scan') continue;
      }
    }

    throw new Error(lastError || 'Audit failed');
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form) return;

    errorBox?.classList.add('hidden');
    const formData = new FormData(form);
    const url = formData.get('url')?.toString().trim();
    const email = formData.get('email')?.toString().trim();
    const btn = form.querySelector('button[type="submit"]');
    const original = btn?.innerHTML;
    if (btn) {
      btn.innerHTML = '<i class="ph-bold ph-circle-notch"></i> Running audit...';
      btn.disabled = true;
    }

    try {
      await submitAudit(url, email);
      form.classList.add('hidden');
      success?.classList.remove('hidden');
    } catch (err) {
      if (btn) {
        btn.innerHTML = original || 'Run my free PULSE audit';
        btn.disabled = false;
      }
      if (errorBox) {
        errorBox.textContent =
          'Audit failed. Try again or email hello@happyranks.com — we can run it manually.';
        errorBox.classList.remove('hidden');
      }
      console.error(err);
    }
  });
</script>
